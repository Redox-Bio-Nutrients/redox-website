{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*":    ["src/layouts/*"],
      "@lib/*":        ["src/lib/*"],
      "@config/*":     ["src/config/*"],
      "@styles/*":     ["src/styles/*"],
      "@locales/*":       ["src/locales/*"]
    }
  }
}