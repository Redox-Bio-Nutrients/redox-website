---
// src/pages/index.astro
// Placeholder homepage — real hero/sections come with the homepage build.

import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config/site'
---

<BaseLayout
  title="Home"
  description="Redox Bio-Nutrients — improving soil, water, and plant health through innovative bio-nutrient technology."
>
  <section class="hero">
    <h1>{site.name}</h1>
    <p>Improving soil, water, and plant health.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
    text-align: center;
  }

  .hero h1 {
    font-size: var(--text-5xl);
    color: var(--color-green-dark);
  }

  .hero p {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }
</style>
