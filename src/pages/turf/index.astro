---
// src/pages/turf/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro'
import GroupedProductCatalog from '../../components/products/GroupedProductCatalog.astro'
import { getProductsByMarket } from '../../lib/queries'
import '../../styles/turf-livery.css'

const products = await getProductsByMarket('turf')
---

<BaseLayout
  title="Turf"
  description="Redox Bio-Nutrients products for turf — courses, fields, and fine turf management."
>
  <div class="page">
    <header class="page__header">
      <h1>Turf</h1>
      <p>Bio-nutrient products for resilient, healthy turf.</p>
    </header>
    <GroupedProductCatalog products={products} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-24);
  }

  .page__header {
    margin-bottom: var(--space-10);
  }

  .page__header h1 {
    font-family: var(--turf-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: var(--text-5xl);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .page__header p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
