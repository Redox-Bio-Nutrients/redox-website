---
// src/pages/turf/products/index.astro
//
// The Turf product catalog — moved here from /turf 2026-09 once
// /turf became a marketing landing page (see [slug].astro's "turf"
// special-case) rather than the catalog itself. Reachable via the
// landing page's "Products" CTA, or directly via the nav's "Products"
// dropdown.

import BaseLayout from '../../../layouts/BaseLayout.astro'
import GroupedProductCatalog from '../../../components/products/GroupedProductCatalog.astro'
import { getProductsByMarket } from '../../../lib/queries'
import '../../../styles/turf-livery.css'

const products = await getProductsByMarket('turf')
---

<BaseLayout
  title="Turf Products"
  description="Redox Bio-Nutrients products for turf — courses, fields, and fine turf management."
>
  <div class="page">
    <div class="crumbs">
      <a href="/turf">← Turf</a>
    </div>
    <header class="page__header">
      <h1>Turf Products</h1>
      <p>Bio-nutrient products for resilient, healthy turf.</p>
    </header>
    <GroupedProductCatalog products={products} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-24);
  }

  .crumbs {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .crumbs a:hover {
    color: var(--color-text-primary);
  }

  .page__header {
    margin-bottom: var(--space-10);
  }

  .page__header h1 {
    font-family: var(--turf-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: var(--text-5xl);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .page__header p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
