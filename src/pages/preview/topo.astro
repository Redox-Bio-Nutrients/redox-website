---
// src/pages/preview/topo.astro
//
// EXPLORATION (2026-11-17) — throwaway design-review page for the
// "technology / bio-stimulant" direction: generated topographic
// backgrounds (from the Nov 2026 social posts) in place of random crop
// photos. Not linked anywhere, not meant to ship as-is.
//
//   /preview/topo                 → KaPstone
//   /preview/topo?product=<slug>  → any published product
//
// Top: the REAL product page (ProductDetail heroStyle="topo").
// Below the switcher: a gallery showing how the accent line follows
// each product's label colour (product.primaryColor) — the per-product
// behaviour this direction needs.

import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductDetail from '../../components/products/ProductDetail.astro'
import TopoBackground from '../../components/ui/TopoBackground.astro'
import { getAllProducts, getProduct } from '../../lib/queries'
import { PREVIEW_COOKIE, isValidPreviewToken } from '../../lib/previewAuth'

export const prerender = false

// Gated like every other /preview/ route: it renders full product-page
// content, which must not be public (product pages are retired).
if (!isValidPreviewToken(Astro.cookies.get(PREVIEW_COOKIE)?.value)) {
  return new Response('Preview not authorized.', { status: 401 })
}

const slug = Astro.url.searchParams.get('product') ?? 'kapstone'
const [product, all] = await Promise.all([getProduct(slug), getAllProducts()])
if (!product) return new Response(`No published product "${slug}"`, { status: 404 })

const gallery = all
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    color: p.primaryColor ?? '#C9862F',
  }))
---

<BaseLayout title={`Topo concept — ${product.title}`} description="Design exploration">
  <ProductDetail product={product} heroStyle="topo" />

  <section class="topo-review" aria-label="Topographic background — per-product accent colour">
    <div class="topo-review__inner">
      <p class="topo-review__eyebrow">Design exploration · not live</p>
      <h2>Accent line = product label colour</h2>
      <p class="topo-review__note">
        Each tile's coloured contour line and glow come from that product's
        <code>primaryColor</code> in Sanity (KaPstone orange → orange line). Terrain shape
        is seeded by the product slug, so every product gets its own map, and each coloured
        line gets its own stroke width. Click a tile to see its full product page with the topo hero.
      </p>
      <div class="topo-review__grid">
        {gallery.map((p) => (
          <a
            class:list={['topo-tile', { 'is-current': p.slug === slug }]}
            href={`/preview/topo?product=${p.slug}`}
          >
            <TopoBackground seed={p.slug} accent={p.color} spacing={0.06} />
            <span class="topo-tile__label">
              <span class="topo-tile__swatch" style={`background:${p.color}`}></span>
              {p.title}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topo-review {
    background: var(--color-brand-forest);
    color: var(--color-white);
    padding: var(--space-24) var(--space-6);
  }

  .topo-review__inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .topo-review__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-lime);
  }

  .topo-review h2 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: var(--font-normal);
    margin: var(--space-2) 0 var(--space-4);
  }

  .topo-review__note {
    max-width: 68ch;
    color: rgb(255 255 255 / 0.8);
    margin-bottom: var(--space-10);
  }

  .topo-review__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .topo-tile {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 18px 4px;
    overflow: hidden;
    display: block;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.15s ease;
  }

  .topo-tile:hover,
  .topo-tile.is-current {
    outline-color: var(--color-brand-lime);
  }

  .topo-tile__label {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    background: rgb(0 0 0 / 0.45);
    padding: 2px 10px 2px 6px;
    border-radius: 999px;
  }

  .topo-tile__swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.6);
  }
</style>
