---
// src/pages/preview/turf-concept.astro
//
// Throwaway design-review page — NOT part of the real product page
// yet (no real Turf-only product doc exists to visit at a real URL),
// not linked from anywhere, not meant to ship. Now a thin wrapper: it
// builds one full Product-shaped object by hand (since none exists in
// Sanity yet) and renders it straight through the REAL
// <ProductDetail> — the exact component every live product page
// uses — so this is a true end-to-end check of the turf branch, not
// markup standing in for it. Real randomized picks from the live
// `turfBackgroundPool` Sanity singleton feed the hero/callout imagery,
// same mechanism BG_POOL_FRAGMENT/MARKET_POOL_SELECT already give
// every real product (see fragments.ts).

import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductDetail from '../../components/products/ProductDetail.astro'
import { sanityFetch } from '../../lib/sanity'
import { IMAGE_FRAGMENT } from '../../lib/queries/fragments'
import type { Product, ProductSection, SanityImage } from '../../lib/types/sanity'
import type { PortableTextBlock } from '@portabletext/types'

export const prerender = false

const rawPool = await sanityFetch<SanityImage[]>(
  /* groq */ `*[_id == "turfBackgroundPool"][0].images[] ${IMAGE_FRAGMENT}`,
)

// A minimal helper, not a real Portable Text editor output — good
// enough to prove the real section renderers work, not meant to be a
// template for authoring real content in Studio (that's just typed
// prose in the block editor).
let blockKey = 0
const textBlock = (text: string): PortableTextBlock =>
  ({
    _type: 'block',
    _key: `b${blockKey++}`,
    style: 'normal',
    markDefs: [],
    children: [{ _type: 'span', _key: `s${blockKey++}`, text, marks: [] }],
  }) as unknown as PortableTextBlock

// The actual Sanity `sections[]` module system — same schema types,
// same renderer components real product pages use, fed by-hand
// content instead of a real doc's fields, since no Turf product docs
// exist yet.
const sections: ProductSection[] = [
  {
    _type: 'bulletSection',
    _key: 'benefits',
    heading: 'OxyCal Benefits at a Glance',
    columns: 2,
    items: [
      'Boosts Photosynthesis — enhances photosynthetic activity, even in shaded or low-light areas.',
      'Powers Energy Production — activates the same carbon pathways plants create during photosynthesis.',
      'Strengthens Antioxidant Defense — neutralizes harmful oxygen free radicals.',
      'Supports Recovery — accelerates repair after aerification, verticutting, or heavy traffic.',
      'Enhances Abiotic Stress Resistance — builds defense against heat, cold, and drought.',
    ],
  },
  {
    _type: 'calloutSection',
    _key: 'quote',
    tone: 'solid',
    body: [
      textBlock(
        'Shield your surface. Elevate play. TurfRx OxyCal keeps turf maintaining color, density, and playability — even under intense pressure.',
      ),
    ],
  },
  {
    _type: 'analysisSection',
    _key: 'rate',
    heading: 'Suggested Rate',
    rows: [
      { label: 'Rate', value: '1–3 lbs/acre (foliar)' },
      { label: 'Timing', value: 'Before / after cultural practices' },
      { label: 'Special Notes', value: 'Water in that evening' },
    ],
  },
  {
    _type: 'chartSection',
    _key: 'trial',
    heading: 'Soil Moisture — Trial Data',
    source: 'Trial 25-V7',
    unit: '% VWC',
    rows: [
      { label: 'Stress Control', value: 16.4 },
      { label: 'TurfRx (0.5 gpa)', value: 21.9 },
      { label: 'TurfRx (1 gpa)', value: 27.1, highlight: true },
    ],
    footnote: 'Volumetric water content at 6 days post-application.',
  },
  {
    _type: 'faqSection',
    _key: 'faq',
    heading: 'From the Course — Common Questions',
    items: [
      {
        question: 'When should TurfRx OxyCal be applied?',
        answer: [
          textBlock(
            'Apply one week before and again one week after aerification, verticutting, or other maintenance events to promote faster healing — or during heat/cold extremes and high play when turf vigor is compromised.',
          ),
        ],
      },
      {
        question: 'Can it be tank-mixed with other inputs?',
        answer: [
          textBlock(
            'Generally compatible with most products, but consult your Redox representative before mixing with multiple inputs — and always jar test first.',
          ),
        ],
      },
    ],
  },
  {
    _type: 'testimonialSection',
    _key: 'testimonial',
    quote:
      'Placeholder pull-quote — real superintendent testimonials exist in your files but weren’t written for public attribution, so nothing real is quoted here.',
    name: 'Golf Course Superintendent',
    role: 'Demo placeholder, not a real attribution',
  },
  {
    _type: 'videoSection',
    _key: 'video',
    heading: 'See OxyCal in Action',
    url: 'https://www.youtube.com/watch?v=jNQXAC9IVRw',
    caption: 'Placeholder video — swap for a real product video URL when one exists.',
  },
  {
    _type: 'warningSection',
    _key: 'mixing',
    heading: 'Important Mixing & Handling Guidelines for TurfRx OxyCal',
    message: [
      textBlock('TurfRx OxyCal is a dry fertilizer that must be solubilized prior to application.'),
    ],
    steps: [
      'Fill spray tank half full with water and start agitation.',
      'Remove the top basket screen.',
      'Measure out 1–2 lbs. at a time.',
      'Slowly add TurfRx OxyCal to the tank while water is circulating — it should always go in the tank first.',
      'After adding all product(s), allow 5 minutes for complete hydration.',
    ],
  },
]

// A full Product-shaped object, hand-built since no real Turf-only
// doc exists in Sanity yet. `backgrounds` is the raw pool (same shape
// getProduct()'s BG_POOL_FRAGMENT returns) so <ProductDetail>'s own
// hero-randomization script works unmodified.
const product: Product = {
  _id: 'demo-oxycal',
  title: 'OxyCal',
  slug: 'oxycal-demo',
  tagline: 'Shield Your Surface. Elevate Play.',
  markets: ['turf'],
  backgrounds: rawPool,
  primaryColor: '#B5321C',
  accentColor: '#EE9A3C',
  sections,
  crops: ['Greens', 'Fairways', 'Sports Turf'],
  relatedProducts: [
    { _id: 'demo-linx', title: 'TurfRx Linx', slug: 'linx-demo', tagline: 'Season-long insurance.', markets: ['turf'] },
    { _id: 'demo-si', title: 'TurfRx Si', slug: 'si-demo', tagline: 'Built-in strength.', markets: ['turf'] },
  ],
  technologies: [{ _id: 'demo-ram', title: 'RAM Technology', slug: 'ram-technology' }],
}
---

<BaseLayout
  title="TurfRx OxyCal (concept preview)"
  description="Diagonal-cut livery system — real ProductDetail.astro turf branch, demo content."
>
  <ProductDetail product={product} />
</BaseLayout>
