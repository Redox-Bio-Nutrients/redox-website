---
// src/pages/regions/index.astro
//
// Every region and every agronomist on one page — see
// GroupedRegionRoster.astro's WHY comment for the full reasoning
// (same pattern as the /agriculture and /turf catalog pages).

import BaseLayout from '../../layouts/BaseLayout.astro'
import GroupedRegionRoster from '../../components/regions/GroupedRegionRoster.astro'
import { getAllRegionsWithTeams } from '../../lib/queries'

const regions = await getAllRegionsWithTeams()
---

<BaseLayout
  title="Regions"
  description="Find your local Redox Bio-Nutrients agronomist by region."
>
  <div class="page">
    <header class="page__header">
      <h1>Regions</h1>
      <p>Local agronomists, wherever you grow.</p>
    </header>
    <GroupedRegionRoster regions={regions} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-24);
  }

  .page__header {
    margin-bottom: var(--space-10);
  }

  .page__header h1 {
    font-size: var(--text-4xl);
    color: var(--color-green-dark);
  }

  .page__header p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
