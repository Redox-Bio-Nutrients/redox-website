---
// src/pages/regions/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro'
import RegionGrid from '../../components/regions/RegionGrid.astro'
import { getAllRegions } from '../../lib/queries'

const regions = await getAllRegions()
---

<BaseLayout
  title="Regions"
  description="Find your local Redox Bio-Nutrients agronomist by region."
>
  <div class="page">
    <header class="page__header">
      <h1>Regions</h1>
      <p>Local agronomists, wherever you grow.</p>
    </header>
    <RegionGrid regions={regions} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-24);
  }

  .page__header {
    margin-bottom: var(--space-10);
  }

  .page__header h1 {
    font-size: var(--text-4xl);
    color: var(--color-green-dark);
  }

  .page__header p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
