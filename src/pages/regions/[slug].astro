---
// src/pages/regions/[slug].astro
//
// Fixed template (not the Homepage/Technology page-builder) — a
// region's content shape is simple and consistent (description + team
// roster), so a bespoke layout reads cleaner than composing it from
// generic sections. Team roster is fully data-driven (any Author
// document referencing this region via its own `region` field, see
// getRegion() in src/lib/queries/regions.ts) — reassigning someone to
// a different region is a one-field edit on their own document,
// nothing to touch here. States/counties covered are shown per
// agronomist on their own EmployeeCard, not at the region level — see
// author.ts's coverageAreas.

import BaseLayout from '../../layouts/BaseLayout.astro'
import { PortableText } from 'astro-portabletext'
import { getAllRegions, getRegion } from '../../lib/queries'
import { urlFor } from '../../lib/sanity'
import { onMissingPortableTextComponent, portableTextComponents } from '../../lib/portableTextComponents'
import EmployeeGrid from '../../components/people/EmployeeGrid.astro'

export async function getStaticPaths() {
  const regions = await getAllRegions()
  return regions.map((region) => ({ params: { slug: region.slug } }))
}

const { slug } = Astro.params
const region = await getRegion(slug!)

if (!region) {
  return Astro.redirect('/404')
}

const imageUrl = region.image
  ? urlFor(region.image).width(2400).height(1000).fit('crop').auto('format').quality(75).url()
  : null
---

<BaseLayout title={region.title} seo={region.seo}>
  {imageUrl ? (
    <header class="hero">
      <img class="hero__bg" src={imageUrl} alt={region.image?.alt ?? ''} loading="eager" />
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="hero__content">
        <h1>{region.title}</h1>
      </div>
    </header>
  ) : (
    <header class="page-header">
      <h1>{region.title}</h1>
    </header>
  )}

  <div class="crumbs">
    <a href="/regions">← Regions</a>
  </div>

  {region.description && region.description.length > 0 && (
    <div class="description">
      <PortableText
        value={region.description}
        components={portableTextComponents}
        onMissingComponent={onMissingPortableTextComponent}
      />
    </div>
  )}

  <section class="team">
    <div class="team__inner">
      <h2>Meet the Team</h2>
      <EmployeeGrid team={region.team ?? []} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Full-bleed hero variant (image set) ─────────────────────── */
  .hero {
    position: relative;
    min-height: min(45vh, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.42);
  }

  .hero__content {
    position: relative;
    width: min(var(--max-width-2xl), 100%);
    margin: 0 auto;
    padding: var(--space-16) var(--space-8);
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  /* ── Plain header variant (no image) ─────────────────────────── */
  .page-header {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6) var(--space-8);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  /* ── Shared ───────────────────────────────────────────────────── */
  .crumbs {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .crumbs a:hover {
    color: var(--color-text-primary);
  }

  .description {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
    font-size: var(--text-lg);
  }

  .description :global(p) {
    max-width: 70ch;
    margin-bottom: var(--space-5);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .team {
    padding: var(--space-16) 0 var(--space-24);
  }

  .team__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .team h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-10);
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 35vh;
    }

    .page-header {
      padding-top: var(--space-16);
    }
  }
</style>
