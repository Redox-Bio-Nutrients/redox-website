---
// src/pages/[slug].astro
//
// Generic catch-all for the `page` Sanity document type — About,
// Contact, and any other marketing page that doesn't need a bespoke
// template (see sanity/schemas/documents/page.ts). More specific
// static routes (e.g. /agriculture/products, /products/*) always win
// over this dynamic route, so there's no collision risk in adding
// pages here.
//
// heroImage is optional per the schema: pages with one get a full-bleed
// photo header (Homepage hero treatment); pages without just get a
// plain title/subheading block.
//
// The About Us page (slug "about-us") additionally gets a "Meet the
// Team" section appended after the body copy — the office staff pool
// (author.ts's isOfficeStaff flag) as an "HQ" group, followed by each
// Region's own agronomist roster (getAllRegionsWithTeams() — the same
// query the old standalone /regions page used) as its own labeled
// group. Same EmployeeCard/EmployeeGrid throughout. Special-cased by
// slug rather than a generic "team section" content-builder block:
// there's exactly one page that needs this today, so a bespoke toggle
// here is simpler than a new Sanity object type an editor would have
// to know to add.
//
// The Agriculture and Turf landing pages (slugs "agriculture"/"turf")
// get the same special-case treatment for their own reason — a
// "Performance System" showcase + a CTA button through to their
// catalog, appended after the body copy — 2026-09, once /agriculture
// and /turf stopped being the catalogs themselves (see
// /agriculture/products, /turf/products) and became marketing pages
// instead.

import BaseLayout from '../layouts/BaseLayout.astro'
import { PortableText } from 'astro-portabletext'
import { getAllCollections, getAllPageSlugs, getAllRegionsWithTeams, getOfficeStaff, getPage } from '../lib/queries'
import { urlFor } from '../lib/sanity'
import { onMissingPortableTextComponent, portableTextComponents } from '../lib/portableTextComponents'
import EmployeeGrid from '../components/people/EmployeeGrid.astro'
import CollectionShowcase from '../components/products/CollectionShowcase.astro'

export async function getStaticPaths() {
  const slugs = await getAllPageSlugs()
  return slugs.map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const page = await getPage(slug!)

if (!page) {
  return Astro.redirect('/404')
}

const heroImageUrl = page.heroImage
  ? urlFor(page.heroImage).width(2400).height(1400).fit('crop').auto('format').quality(75).url()
  : null

const officeStaff = slug === 'about-us' ? await getOfficeStaff() : []
const regionTeams = slug === 'about-us' ? await getAllRegionsWithTeams() : []

const marketCatalog =
  slug === 'agriculture' ? '/agriculture/products' : slug === 'turf' ? '/turf/products' : null
const collections = slug === 'agriculture' ? await getAllCollections() : []
---

<BaseLayout title={page.title} seo={page.seo}>
  {heroImageUrl ? (
    <header class="hero">
      <img class="hero__bg" src={heroImageUrl} alt={page.heroImage?.alt ?? ''} loading="eager" />
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">{page.heroHeading ?? page.title}</h1>
        <div class="hero__meta">
          {page.heroSubheading && <p class="hero__subheading">{page.heroSubheading}</p>}
          {page.heroCta && (
            <a
              class="hero__cta"
              href={page.heroCta.href}
              target={page.heroCta.external ? '_blank' : undefined}
              rel={page.heroCta.external ? 'noopener noreferrer' : undefined}
            >
              <span>{page.heroCta.label}</span>
              <span class="hero__cta-arrow" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </header>
  ) : (
    <header class="page-header">
      <h1>{page.heroHeading ?? page.title}</h1>
      {page.heroSubheading && <p>{page.heroSubheading}</p>}
      {page.heroCta && (
        <a
          class="page-header__cta"
          href={page.heroCta.href}
          target={page.heroCta.external ? '_blank' : undefined}
          rel={page.heroCta.external ? 'noopener noreferrer' : undefined}
        >
          {page.heroCta.label}
        </a>
      )}
    </header>
  )}

  {page.body && page.body.length > 0 && (
    <div class:list={['body', { 'body--tight': officeStaff.length > 0 || regionTeams.length > 0 || marketCatalog !== null }]}>
      <PortableText
        value={page.body}
        components={portableTextComponents}
        onMissingComponent={onMissingPortableTextComponent}
      />
    </div>
  )}

  {(officeStaff.length > 0 || regionTeams.length > 0) && (
    <section class="team">
      <div class="team__inner">
        <h2>Meet the Team</h2>

        {officeStaff.length > 0 && (
          <div class="team__group">
            <h3 class="team__group-heading">HQ</h3>
            <hr class="team__group-rule" />
            <EmployeeGrid team={officeStaff} />
          </div>
        )}

        {regionTeams.map((region) => (
          <div class="team__group">
            <h3 class="team__group-heading">{region.title} Agronomists</h3>
            <hr class="team__group-rule" />
            <EmployeeGrid team={region.team ?? []} emptyMessage={`No ${region.title} agronomists assigned yet.`} />
          </div>
        ))}
      </div>
    </section>
  )}

  {marketCatalog && (
    <section class="showcase-section">
      <div class="showcase-section__inner">
        {collections.length > 0 && <CollectionShowcase collections={collections} catalogHref={marketCatalog} />}
        <a class="showcase-section__cta" href={marketCatalog}>
          {slug === 'agriculture' ? 'Find the Right Solution' : 'Products'}
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── Full-bleed hero variant (heroImage set) ─────────────────── */
  .hero {
    position: relative;
    min-height: min(60vh, 560px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.42);
  }

  .hero__content {
    position: relative;
    width: min(var(--max-width-2xl), 100%);
    margin: 0 auto;
    padding: var(--space-16) var(--space-8);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .hero__subheading {
    max-width: 44ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.9);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.02em;
    color: var(--color-white);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .hero__cta:hover {
    background: rgb(255 255 255 / 0.28);
    transform: translateY(-1px);
  }

  .hero__cta-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .hero__cta:hover .hero__cta-arrow {
    transform: translateX(3px);
  }

  /* ── Plain header variant (no heroImage) ─────────────────────── */
  .page-header {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6) var(--space-8);
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .page-header p {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .page-header__cta {
    display: inline-block;
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-green);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    transition: filter 0.15s ease;
  }

  .page-header__cta:hover {
    filter: brightness(0.92);
  }

  /* ── Body prose ───────────────────────────────────────────────── */
  .body {
    --prose-width: 54rem;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-32);
    font-size: var(--text-lg);
  }

  /* Readable measure, centered within the wider .body box rather than
   * pinned to its left edge — same pattern (and same reasoning) as
   * BlogPostDetail.astro's prose column: without the auto margins
   * here, a narrower max-width just collapses to the block's start
   * edge, leaving prose stranded in a narrow left-hand column with a
   * big empty gap on the right instead of centered like everything
   * else on the page. A fixed --prose-width rather than `ch` keeps
   * every block type's left/right edges pixel-identical regardless of
   * its own font size (h2 renders larger than p; under `ch` — a
   * font-relative unit — that alone would have given each a different
   * actual pixel width and a visibly mismatched left edge). Covers
   * every block type Portable Text can hand back, not just p. */
  .body :global(p),
  .body :global(h2),
  .body :global(ul),
  .body :global(ol) {
    max-width: var(--prose-width);
    margin-left: auto;
    margin-right: auto;
  }

  .body :global(p) {
    margin-bottom: var(--space-5);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .body :global(h2) {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .body :global(ul),
  .body :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-5);
  }

  .body :global(li) {
    margin-bottom: var(--space-2);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .body :global(li)::marker {
    color: var(--color-green);
  }

  .body :global(a) {
    color: var(--color-green-dark);
    text-decoration: underline;
  }

  /* A "Meet the Team" or Performance System section follows — its own
   * top padding already provides the gap, so the body's large closing
   * padding here would just double it up. */
  .body--tight {
    padding-bottom: var(--space-8);
  }

  /* ── Meet the Team (About Us only) ───────────────────────────── */
  .team {
    padding: var(--space-8) 0 var(--space-24);
  }

  .team__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .team h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-10);
  }

  /* HQ, then one group per Region (e.g. "West Agronomists") — each its
   * own heading + rule, same divider language GroupedRegionRoster.astro
   * used on the old standalone /regions page. */
  .team__group {
    margin-bottom: var(--space-16);
  }

  .team__group:last-child {
    margin-bottom: 0;
  }

  .team__group-heading {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
  }

  .team__group-rule {
    margin: var(--space-4) 0 var(--space-8);
    border: none;
    border-top: 2px solid var(--color-green);
  }

  /* ── Performance System showcase + CTA (Agriculture/Turf only) ── */
  .showcase-section {
    padding: var(--space-8) 0 var(--space-24);
  }

  .showcase-section__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-10);
  }

  .showcase-section__cta {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    background: var(--color-green);
    color: var(--color-white);
    font-size: var(--text-base);
    font-weight: var(--font-semi);
    transition: filter 0.15s ease;
  }

  .showcase-section__cta:hover {
    filter: brightness(0.92);
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 50vh;
    }

    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .page-header {
      padding-top: var(--space-16);
    }
  }
</style>
