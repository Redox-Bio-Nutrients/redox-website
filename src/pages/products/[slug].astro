---
// src/pages/products/[slug].astro
//
// Product detail page. Hero follows the image-led, bottom-aligned
// pattern (reference: Lapalma product page): full-bleed imagery,
// display-size product name at the bottom, hairline rule, then a
// quiet meta row. Falls back to a layered gradient of the product's
// primaryColor when no image is set. Sections render below inside a
// wrapper that exposes --product-color to every renderer.

import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductSections from '../../components/products/ProductSections.astro'
import ResourceRequestDialog from '../../components/products/ResourceRequestDialog.astro'
import { getAllProducts, getProduct } from '../../lib/queries'
import { urlFor } from '../../lib/sanity'

export async function getStaticPaths() {
  const products = await getAllProducts()
  return products.map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const product = await getProduct(slug!)

if (!product) {
  return Astro.redirect('/404')
}

const color = product.primaryColor ?? '#2E6B3E'
// Background pool: heroImage + the backgrounds gallery. The server
// renders the first image so the page never flashes empty; an inline
// script swaps in a random pick before paint on every load.
const bgPool = (product.backgrounds ?? []).map((img) => ({
  url: urlFor(img).width(2400).height(1400).fit('crop').auto('format').quality(75).url(),
  lqip: img.lqip ?? null,
}))
const heroImage = bgPool[0] ?? null
const marketLinks = product.markets.map((m) =>
  m === 'agriculture'
    ? { label: 'Agriculture', href: '/agriculture' }
    : { label: 'Turf', href: '/turf' },
)

import { urlFor as imgUrl } from '../../lib/sanity'
const relatedCards = (product.relatedProducts ?? []).map((p) => ({
  ...p,
  thumb: p.image ? imgUrl(p.image).width(160).height(160).fit('crop').url() : null,
}))

// Packaging shot floats on the right side of the hero — full image,
// never cropped
const productShotUrl = product.image
  ? urlFor(product.image).width(900).fit('max').url()
  : null

// Hard gate: document URLs are fetched (Studio still needs them, and a
// future direct-link mode isn't ruled out) but never rendered — only
// titles reach the page. Access happens through ResourceRequestDialog,
// which never receives a url either. See its file header for why.
const documents = product.documents ?? []
const resourceRequestEndpoint = import.meta.env.PUBLIC_RESOURCE_REQUEST_ENDPOINT as string | undefined
---

<BaseLayout title={product.title} description={product.tagline} seo={product.seo}>
  <header class="hero" style={`--product-color: ${color}`}>
    {heroImage ? (
      <>
        <div
          id="hero-lqip"
          class="hero__lqip"
          style={heroImage.lqip ? `background-image: url(${heroImage.lqip})` : undefined}
          aria-hidden="true"
        >
        </div>
        <img
          id="hero-bg"
          class="hero__bg"
          src={heroImage.url}
          alt={product.heroImage?.alt ?? ''}
          loading="eager"
          data-bg-pool={JSON.stringify(bgPool)}
        />
      </>
    ) : (
      <div class="hero__bg hero__bg--gradient" aria-hidden="true"></div>
    )}
    <div class="hero__scrim" aria-hidden="true"></div>
    <script is:inline>
      // Randomize the hero background per load — runs during parse,
      // before first paint. The pick's LQIP placeholder shows blurred
      // and instant; the full image fades in over it once loaded.
      ;(() => {
        const img = document.getElementById('hero-bg')
        if (!img) return
        const pool = JSON.parse(img.dataset.bgPool || '[]')
        if (pool.length > 1) {
          const pick = pool[Math.floor(Math.random() * pool.length)]
          img.src = pick.url
          const lqip = document.getElementById('hero-lqip')
          if (lqip && pick.lqip) lqip.style.backgroundImage = `url(${pick.lqip})`
        }
        const reveal = () => img.classList.add('is-loaded')
        img.complete && img.naturalWidth ? reveal() : img.addEventListener('load', reveal)
      })()
    </script>

    <div class="hero__content">
      <div class="hero__text">
        <h1 class="hero__title">{product.title}</h1>
        <hr class="hero__rule" />
        <div class="hero__meta">
          {product.tagline && <p class="hero__tagline">{product.tagline}</p>}
          <nav class="hero__markets" aria-label="Markets">
            {marketLinks.map((m) => (
              <a href={m.href}>{m.label}</a>
            ))}
          </nav>
          <a class="hero__cta" href="#content">Explore ↓</a>
        </div>
      </div>
    </div>
  </header>

  <div class="layout" id="content" style={`--product-color: ${color}`}>
    <div class="layout__main">
      {product.sections && product.sections.length > 0 && (
        <ProductSections
          sections={product.sections}
          productColor={color}
          backgrounds={
            product.calloutBackgrounds?.length
              ? product.calloutBackgrounds
              : product.backgrounds
          }
        />
      )}
    </div>

    <aside class="sidebar" aria-label="Product resources">
      <div class="sidebar__inner">
        <figure class="sidebar__product">
          {productShotUrl ? (
            <img
              src={productShotUrl}
              alt={product.image?.alt ?? product.title}
              loading="lazy"
            />
          ) : (
            <div class="sidebar__product-ph" aria-hidden="true">
              <span>{product.title}</span>
            </div>
          )}
        </figure>

        <section class="sidebar__group">
          <h2>Resources</h2>
          {documents.length > 0 && (
            <ul>
              {documents.map((doc) => (
                <li class="sidebar__doc">
                  <span class="sidebar__doc-lock" aria-hidden="true"></span>
                  <span class="sidebar__doc-title">{doc.title ?? 'Document'}</span>
                </li>
              ))}
            </ul>
          )}
          {resourceRequestEndpoint ? (
            <button type="button" class="sidebar__doc-request" data-dialog-open="resource-request-dialog">
              Product Information Request
            </button>
          ) : (
            <a class="sidebar__doc-request" href="/contact">
              Product Information Request
            </a>
          )}
        </section>

        {product.technologies && product.technologies.length > 0 && (
          <section class="sidebar__group">
            <h2>Powered By</h2>
            <ul>
              {product.technologies.map((tech) => (
                <li>
                  <a class="sidebar__link" href={`/technologies/${tech.slug}`}>
                    {tech.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {product.crops && product.crops.length > 0 && (
          <section class="sidebar__group">
            <h2>Crops</h2>
            <ul class="sidebar__tags">
              {product.crops.map((crop) => (
                <li>{crop}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="sidebar__group">
          <h2>Markets</h2>
          <ul>
            {marketLinks.map((m) => (
              <li>
                <a class="sidebar__link" href={m.href}>{m.label}</a>
              </li>
            ))}
          </ul>
        </section>

        {relatedCards.length > 0 && (
          <section class="sidebar__group">
            <h2>Pairs Well With</h2>
            <ul>
              {relatedCards.map((p) => (
                <li>
                  <a class="sidebar__related" href={`/products/${p.slug}`}>
                    {p.thumb ? (
                      <img src={p.thumb} alt="" width="48" height="48" loading="lazy" />
                    ) : (
                      <span class="sidebar__related-ph" aria-hidden="true"></span>
                    )}
                    <span class="sidebar__related-text">
                      <strong>{p.title}</strong>
                      {p.tagline && <small>{p.tagline}</small>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <a class="sidebar__cta" href="/contact">
          Talk to an agronomist
        </a>
      </div>
    </aside>
  </div>

  {resourceRequestEndpoint && (
    <ResourceRequestDialog
      productTitle={product.title}
      endpoint={resourceRequestEndpoint}
      color={color}
    />
  )}
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: min(85vh, 880px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--color-white);
  }

  /* Blurred LQIP placeholder — instant paint while the image loads */
  .hero__lqip {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(18px);
    transform: scale(1.1); /* hide blur edge bleed */
    background-color: var(--product-color);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero__bg.is-loaded {
    opacity: 1;
  }

  .hero__bg--gradient {
    background:
      radial-gradient(120% 90% at 85% 10%, rgb(255 255 255 / 0.16), transparent 60%),
      radial-gradient(100% 120% at 10% 100%, rgb(0 0 0 / 0.35), transparent 55%),
      var(--product-color);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.18) 0%,
      rgb(0 0 0 / 0.05) 40%,
      rgb(0 0 0 / 0.45) 100%
    );
  }

  .hero__content {
    position: relative;
    width: min(var(--max-width-2xl), 100%);
    margin: 0 auto;
    padding: var(--space-32) var(--space-8) var(--space-12);
  }

  .hero__text {
    width: 100%;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero__rule {
    border: none;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    margin: var(--space-8) 0 var(--space-6);
  }

  .hero__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .hero__tagline {
    max-width: 44ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.9);
  }

  .hero__markets {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
    white-space: nowrap;
    padding-top: var(--space-2);
  }

  .hero__markets a:hover {
    color: var(--color-white);
  }

  .hero__cta {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: var(--space-2);
    border-bottom: 1px solid rgb(255 255 255 / 0.5);
    transition: border-color 0.15s ease;
  }

  .hero__cta:hover {
    border-color: var(--color-white);
  }

  /* ── Layout: sections + floating sidebar ──────────────────────── */
  .layout {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-32) var(--space-6) var(--space-40);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-16);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: calc(var(--space-16) + 60px); /* clear the sticky header */
  }

  .sidebar__inner {
    background: color-mix(in srgb, var(--product-color) 6%, var(--color-cream));
    border: 1px solid color-mix(in srgb, var(--product-color) 18%, transparent);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Product shot — compact, full image, never cropped */
  .sidebar__product {
    display: grid;
    place-items: center;
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
  }

  .sidebar__product img {
    max-width: 100%;
    max-height: 300px;
    width: auto;
    height: auto;
    display: block;
  }

  .sidebar__product-ph {
    width: 100%;
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(110% 90% at 80% 10%, rgb(255 255 255 / 0.14), transparent 60%),
      var(--product-color);
  }

  .sidebar__product-ph span {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-white);
    opacity: 0.85;
  }

  .sidebar__group h2 {
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .sidebar__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
    padding: var(--space-3) var(--space-4);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sidebar__link:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* Doc row — informational only, no href: access is gated behind the
   * request dialog (see .sidebar__doc-request below). */
  .sidebar__doc {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
  }

  .sidebar__doc-lock {
    flex-shrink: 0;
    width: 14px;
    height: 12px;
    position: relative;
    border: 1.5px solid var(--color-text-muted);
    border-radius: 2px;
  }

  .sidebar__doc-lock::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 8px;
    height: 8px;
    transform: translateX(-50%);
    border: 1.5px solid var(--color-text-muted);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
  }

  .sidebar__doc-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__doc-request {
    display: block;
    text-align: center;
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--product-color) 40%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    color: var(--product-color);
    transition: background 0.15s ease;
  }

  .sidebar__doc-request:hover {
    background: color-mix(in srgb, var(--product-color) 10%, transparent);
  }

  /* Crop tags */
  .sidebar__tags {
    flex-direction: row !important;
    flex-wrap: wrap;
  }

  .sidebar__tags li {
    padding: var(--space-1) var(--space-3);
    background: var(--bg-raised);
    border: 1px solid color-mix(in srgb, var(--product-color) 22%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* Related products */
  .sidebar__related {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sidebar__related:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .sidebar__related img,
  .sidebar__related-ph {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-cream);
    object-fit: cover;
  }

  .sidebar__related-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .sidebar__related-text strong {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
  }

  .sidebar__related-text small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar__cta {
    display: block;
    text-align: center;
    padding: var(--space-4) var(--space-5);
    background: var(--product-color);
    color: var(--color-white);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    transition: filter 0.15s ease;
  }

  .sidebar__cta:hover {
    filter: brightness(0.92);
  }

  @media (max-width: 1023px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    /* Sidebar drops below content on smaller screens */
    .sidebar {
      position: static;
      order: 2;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 70vh;
    }

    .hero__meta {
      flex-direction: column;
      gap: var(--space-5);
    }

    .layout {
      padding-top: var(--space-16);
    }
  }
</style>

