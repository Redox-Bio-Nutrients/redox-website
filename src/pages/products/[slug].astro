---
// src/pages/products/[slug].astro
//
// Product detail pages are retired (2026-11-23): every old product URL
// (catalog cards, blog embeds, homepage links, vercel.json legacy
// redirects) now lands on that product's market catalog instead.
// ProductDetail.astro is kept only for the Studio draft-preview route.

import { getAllProducts } from '../../lib/queries'
import { getProductVariant } from '../../lib/productVariant'

export async function getStaticPaths() {
  const products = await getAllProducts()
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { variant: getProductVariant(p.markets) },
  }))
}

return Astro.redirect(`/${Astro.props.variant}/products`, 301)
---
