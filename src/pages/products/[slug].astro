---
// src/pages/products/[slug].astro
//
// Statically prerendered product detail page. Actual design/markup
// lives in src/components/products/ProductDetail.astro, shared with
// the SSR draft-preview route at src/pages/preview/products/[slug].astro
// — this file's only job is fetching the *published* product and
// handing it off.

import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductDetail from '../../components/products/ProductDetail.astro'
import { getAllProducts, getProduct } from '../../lib/queries'

export async function getStaticPaths() {
  const products = await getAllProducts()
  return products.map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const product = await getProduct(slug!)

if (!product) {
  return Astro.redirect('/404')
}
---

<BaseLayout title={product.title} description={product.tagline} seo={product.seo}>
  <ProductDetail product={product} />
</BaseLayout>
