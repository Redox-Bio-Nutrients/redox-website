---
// src/pages/agriculture/products/index.astro
//
// The Agriculture product catalog — moved here from /agriculture
// 2026-09 once /agriculture became a marketing landing page (see
// [slug].astro's "agriculture" special-case) rather than the catalog
// itself. Reachable via the landing page's CTA, or directly via the
// nav's "Products" dropdown/default.

import BaseLayout from '../../../layouts/BaseLayout.astro'
import GroupedProductCatalog from '../../../components/products/GroupedProductCatalog.astro'
import { getProductsByMarket } from '../../../lib/queries'

const products = await getProductsByMarket('agriculture')
---

<BaseLayout
  title="Agriculture Products"
  description="Redox Bio-Nutrients products for agriculture — improving soil, water, and plant health in row crops, orchards, and more."
>
  <div class="page">
    <div class="crumbs">
      <a href="/agriculture">← Agriculture</a>
    </div>
    <header class="page__header">
      <h1>Agriculture Products</h1>
      <p>Bio-nutrient products for healthier soil and stronger crops.</p>
    </header>
    <GroupedProductCatalog products={products} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-24);
  }

  .crumbs {
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .crumbs a:hover {
    color: var(--color-text-primary);
  }

  .page__header {
    margin-bottom: var(--space-10);
  }

  .page__header h1 {
    font-size: var(--text-4xl);
    color: var(--color-green-dark);
  }

  .page__header p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
