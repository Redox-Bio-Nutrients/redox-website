---
// src/pages/technologies/[slug].astro
//
// Detail page is fully modular — same HomeSections dispatcher and
// section types as the Homepage. Editors compose the page entirely
// from the page-builder sections (Hero / Columns / Callout / Bullet
// Points / ...); nothing here is a fixed template.

import BaseLayout from '../../layouts/BaseLayout.astro'
import HomeSections from '../../components/home/HomeSections.astro'
import { getAllTechnologies, getTechnology } from '../../lib/queries'

export async function getStaticPaths() {
  const technologies = await getAllTechnologies()
  return technologies.map((t) => ({ params: { slug: t.slug } }))
}

const { slug } = Astro.params
const technology = await getTechnology(slug!)

if (!technology) {
  return Astro.redirect('/404')
}

// No breadcrumb (removed 2026-09-24 — Curtis: "not necessary"; the
// nav already links RAM Technology directly and /technologies just
// redirects back to it). Sections render as one uninterrupted run, the
// same as the Homepage.
const sections = technology.sections ?? []
---

<BaseLayout title={technology.title} description={technology.tagline} seo={technology.seo}>
  {sections.length > 0 ? (
    <HomeSections sections={sections} />
  ) : (
    <div class="fallback">
      <h1>{technology.title}</h1>
      {technology.tagline && <p>{technology.tagline}</p>}
    </div>
  )}
</BaseLayout>

<style>
  .fallback {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }

  .fallback h1 {
    font-size: var(--text-4xl);
    color: var(--color-green-dark);
  }

  .fallback p {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
</style>
