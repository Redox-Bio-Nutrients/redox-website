---
// src/components/regions/RegionCard.astro
//
// Same leaf-radius quiet-surface panel as TechnologyCard — regions
// don't carry a background-imagery pool or brand color either. Falls
// back to a title-only placeholder tile when no Region Image / Map
// has been uploaded yet (every region right now).

import { urlFor } from '../../lib/sanity'
import type { RegionCard } from '../../lib/types/sanity'

interface Props {
  region: RegionCard
}

const { region } = Astro.props
const imageUrl = region.image
  ? urlFor(region.image).width(700).height(560).fit('crop').auto('format').quality(80).url()
  : null
const teamCount = region.teamCount ?? 0
---

<a href={`/regions/${region.slug}`} class="card">
  <div class="card__media">
    {imageUrl ? (
      <img src={imageUrl} alt={region.image?.alt ?? region.title} width="700" height="560" loading="lazy" />
    ) : (
      <div class="card__placeholder" aria-hidden="true">
        <span>{region.title}</span>
      </div>
    )}
  </div>
  <div class="card__body">
    <h3>{region.title}</h3>
    {region.states && region.states.length > 0 && (
      <p class="card__states">{region.states.join(' · ')}</p>
    )}
    <p class="card__team">
      {teamCount > 0 ? `${teamCount} team member${teamCount === 1 ? '' : 's'}` : 'Team coming soon'}
    </p>
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .card__media {
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-leaf);
    overflow: hidden;
    background:
      radial-gradient(100% 100% at 50% 0%, color-mix(in srgb, var(--color-text-primary) 4%, transparent), transparent 70%),
      var(--bg-surface);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__media {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(80% 100% at 30% 100%, color-mix(in srgb, var(--color-green-pale) 65%, transparent), transparent 65%),
      var(--color-cream);
  }

  .card__placeholder span {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-green-dark);
    text-align: center;
    padding: 0 var(--space-6);
  }

  .card__body {
    padding: var(--space-6) var(--space-2) 0;
  }

  .card__body h3 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
  }

  .card__states {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }

  .card__team {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-green-dark);
  }
</style>
