---
// src/components/regions/RegionGrid.astro

import type { RegionCard as RegionCardType } from '../../lib/types/sanity'
import RegionCard from './RegionCard.astro'

interface Props {
  regions: RegionCardType[]
  emptyMessage?: string
}

const { regions, emptyMessage = 'Regions coming soon.' } = Astro.props
---

{regions.length > 0 ? (
  <div class="grid">
    {regions.map((region) => <RegionCard region={region} />)}
  </div>
) : (
  <p class="empty">{emptyMessage}</p>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16) var(--space-8);
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
