---
// src/components/ui/TopoBackground.astro
//
// EXPLORATION (2026-11-17) — topographic background from the Nov 2026
// social posts, as a stand-in for PoolBackground's random crop photos.
// Drop inside any position:relative container (fills it, like
// PoolBackground).
//
// The contour lines are a cached SVG file served by /topo.svg
// (src/pages/topo.svg.ts, renderTopoSvg in src/lib/topo.ts) rather than
// inline path data — ~45 KB per map, cached a year by browser + CDN.
//
// Layers: forest→teal ground · warm glow at the peak · faint sage
// contour lines · accent contour lines (each level its own seeded
// stroke width, 1.6–4.2px — only the colour lines vary).
//
// Variants: `accents` (array) cycles the accent rings through several
// colours — the homepage uses every product's label colour, by hue.
// `treatment="audio"` drops the contours for a centred seeded waveform
// + faint dot grid — the podcast heroes.
//
// The accent line + glow colour is PER PRODUCT: it's the product's
// label colour (product.primaryColor — KaPstone's orange label → orange
// lines), not a fixed brand amber. Pass it as `accent`. Dark label
// colours are lifted (ensureReadableOnDark) so the line still reads on
// the dark ground. Non-product pages fall back to the posts' amber.

import { generateWaveform, topoSvgUrl } from '../../lib/topo'
import { ensureReadableOnDark } from '../../lib/color'

interface Props {
  /** terrain seed — use the page/product slug so each page differs */
  seed: string
  /** product label colour; defaults to the social posts' amber */
  accent?: string
  /** where the glow/peak sits, 0–1 */
  peakX?: number
  peakY?: number
  spacing?: number
  warp?: number
  /** every Nth contour level is an accent line (default 7) */
  accentEvery?: number
  /** several colours: accent rings cycle through them, in order from
   * the peak outward (homepage — one per product colour) */
  accents?: string[]
  /** 'audio' (podcast heroes): NO contour lines — a vertically centred
   * waveform band + faint tech dot grid over the ground and glow */
  treatment?: 'audio'
  /** 'eager' for heroes (above the fold); callouts default to lazy */
  loading?: 'eager' | 'lazy'
  class?: string
}

const DEFAULT_ACCENT = '#C9862F'
const {
  seed,
  accent = DEFAULT_ACCENT,
  peakX = 0.5,
  peakY = 0.5,
  spacing,
  warp,
  accentEvery,
  accents,
  treatment,
  loading = 'lazy',
  class: className,
} = Astro.props

const accentColor = ensureReadableOnDark(accent)
const isHex = (c: string) => /^#[0-9a-fA-F]{6}$/.test(c)
// Ring colours: several (homepage spectrum — assigned with a golden-ratio
// stride inside renderTopoSvg so neighbouring rings contrast) or the one
// accent. Hex only — they go into the served SVG's URL.
const ringColors = (accents?.length ? accents : [accent])
  .map((c) => ensureReadableOnDark(c))
  .filter(isHex)
const audio = treatment === 'audio'
// The contour map is a cached SVG file from /topo.svg (src/pages/
// topo.svg.ts), not inline path data. Audio skips it entirely.
const topoUrl = audio
  ? null
  : topoSvgUrl({
      seed: seed.replace(/[^A-Za-z0-9_-]/g, '-').slice(0, 64) || 'redox',
      peakX,
      peakY,
      spacing,
      warp,
      accentEvery,
      colors: ringColors.length ? ringColors : [DEFAULT_ACCENT],
    })
// Own 2400×300 strip, vertically centred in the container by CSS (not
// part of the topo viewBox) so it stays put at any aspect ratio.
const wave = audio ? generateWaveform({ seed, height: 300, y: 0.5, centerX: peakX, maxAmp: 0.46 }) : null
---

<div
  class:list={['topo-bg', { 'topo-bg--audio': audio }, className]}
  style={`--topo-accent: ${accentColor}; --topo-peak-x: ${peakX * 100}%; --topo-peak-y: ${peakY * 100}%;`}
  aria-hidden="true"
>
  <div class="topo-bg__glow"></div>
  {topoUrl && (
    <img
      class="topo-bg__lines"
      src={topoUrl}
      alt=""
      width="2400"
      height="1200"
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
    />
  )}
  {wave && (
    <svg class="topo-bg__wavebox" viewBox="0 0 2400 300" preserveAspectRatio="xMidYMid slice">
      <path class="topo-bg__wave" d={wave} />
    </svg>
  )}
  {audio && <div class="topo-bg__grid"></div>}
</div>

<style>
  .topo-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(140% 90% at 50% 120%, rgb(20 52 50 / 0.9), transparent 60%),
      linear-gradient(180deg, #213a2a 0%, #1f382c 55%, #183330 100%);
  }

  .topo-bg__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      38% 55% at var(--topo-peak-x) var(--topo-peak-y),
      color-mix(in oklab, var(--topo-accent) 34%, transparent),
      color-mix(in oklab, var(--topo-accent) 10%, transparent) 55%,
      transparent 80%
    );
  }

  /* The served SVG (line colours/widths baked in — see renderTopoSvg);
   * object-fit: cover matches the old inline preserveAspectRatio slice. */
  .topo-bg__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── audio treatment (podcast heroes) ── */
  .topo-bg__wave {
    stroke: var(--topo-accent);
    stroke-opacity: 0.7;
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .topo-bg__wavebox {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    width: 100%;
    height: clamp(120px, 34%, 340px);
    fill: none;
  }

  /* centred behind the title — a touch quieter so the type leads */
  .topo-bg--audio .topo-bg__wave {
    stroke-opacity: 0.5;
  }


  /* Faint tech dot grid, fading out toward the edges */
  .topo-bg__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(214 230 205 / 0.22) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 80% at var(--topo-peak-x) var(--topo-peak-y), #000 30%, transparent 85%);
  }


</style>
