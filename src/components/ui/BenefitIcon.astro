---
// src/components/ui/BenefitIcon.astro
//
// One icon from the shared benefit set (src/lib/benefitIcons.ts),
// inlined rather than <img>'d so its `currentColor` ink follows the
// surrounding CSS `color`. Always decorative: the benefit's own title
// sits next to it and carries the meaning, so it's hidden from screen
// readers. An unknown name renders nothing rather than a broken box.

import { getBenefitIconSvg } from '../../lib/benefitIcons'

interface Props {
  name?: string
  class?: string
}

const { name, class: className } = Astro.props
const svg = getBenefitIconSvg(name)
---

{svg && <span class:list={['benefit-icon', className]} aria-hidden="true" set:html={svg} />}

<style>
  .benefit-icon {
    display: inline-block;
    flex-shrink: 0;
    width: var(--benefit-icon-size, 64px);
    height: var(--benefit-icon-size, 64px);
    line-height: 0;
  }

  .benefit-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
