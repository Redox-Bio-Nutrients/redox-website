---
// src/components/people/EmployeeCard.astro
//
// A single person tile — used for both a region's agronomist roster
// and the About Us page's office staff grid (moved out of
// components/regions/ 2026-09 once it needed to serve both — same
// underlying Team Member document either way, see author.ts). The
// photo fills the entire card (same leaf-corner surface as
// AuthorBoxFooter.astro's blog byline card), with name/title/coverage/
// contact floated over it on a bottom scrim, poster-card style rather
// than a small circular avatar above a text block. No photo yet still
// gets the full-bleed treatment — a brand-toned fill standing in for
// the image, with the same big initial the old circular fallback
// used, just scaled up to fill the frame — so a placeholder tile
// reads as "photo coming soon," not a broken layout. Coverage areas
// and email/phone are region-only fields on the underlying document
// (see author.ts) — they simply don't render for an office-staff-only
// person, no separate "mode" needed here.

import { urlFor } from '../../lib/sanity'
import { randomChoice, seededRandom } from '../../lib/seededRandom'
import type { Author } from '../../lib/types/sanity'

interface Props {
  author: Author
}

const { author } = Astro.props

const photoUrl = author.photo
  ? urlFor(author.photo).width(480).height(600).fit('crop').auto('format').quality(85).url()
  : null

const initial = author.name.trim().charAt(0).toUpperCase()

// Leaf-sprig motif (same two-petal gradient bloom CalloutSection.astro/
// AuthorBoxFooter.astro use, permanently visible at one fixed corner
// each) — here every card gets one, but hidden at rest and revealed
// only on hover (see the CSS below), so it reads as a small discovery
// rather than permanent decoration. Seeded on the person's own _id so
// a given card's roll (which of the two sharp corners, which of the 4
// sizes) stays the same across rebuilds rather than reshuffling every
// redeploy, but no two people land on an identical look. Only the
// card's own two *sharp* corners (top-left/bottom-right, matching its
// border-radius) are in play — unlike the first pass at this, which
// also allowed the rounded corners for a deliberate spill-over look;
// dropped per Curtis's follow-up ask, so the tucked-in-a-point look is
// what hover always reveals now.
const leafRng = seededRandom(author._id)
const leafCorner = randomChoice(leafRng, ['tl', 'br'] as const)
const leafScale = randomChoice(leafRng, [0.6, 0.9, 1.2, 1.6])
---

<div class="employee" data-leaf-corner={leafCorner} style={`--leaf-scale: ${leafScale}`}>
  <div class="employee__media">
    {photoUrl ? (
      <img
        class="employee__photo"
        src={photoUrl}
        alt={author.name}
        width="480"
        height="600"
        loading="lazy"
      />
    ) : (
      <span class="employee__photo employee__photo--fallback" aria-hidden="true">{initial}</span>
    )}
    <div class="employee__scrim" aria-hidden="true"></div>
  </div>
  <div class="employee__body">
    <p class="employee__name">{author.name}</p>
    {author.role && <p class="employee__role">{author.role}</p>}
    {author.coverageAreas && author.coverageAreas.length > 0 && (
      <div class="employee__coverage">
        <p class="employee__coverage-label">Covers</p>
        <p class="employee__coverage-list">{author.coverageAreas.join(' · ')}</p>
      </div>
    )}
    <div class="employee__contact">
      {author.email && (
        <a class="employee__link" href={`mailto:${author.email}`}>{author.email}</a>
      )}
      {author.phone && (
        <a class="employee__link" href={`tel:${author.phone.replace(/[^\d+]/g, '')}`}>{author.phone}</a>
      )}
    </div>
  </div>
</div>

<style>
  .employee {
    position: relative;
    /* Poster-card aspect — tall enough for a portrait crop to read as
     * a photo, not a banner. */
    aspect-ratio: 4 / 5;
    display: flex;
    /* No overflow:hidden here (moved to .employee__media below) — the
     * occasional leaf sprig is allowed to spill past the card's own
     * edge, same as CalloutSection's/AuthorBoxFooter's permanent ones. */
    /* Same asymmetric leaf-radius language as the callout/author-box
     * cards, scaled down to a roster-tile size. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
    border: var(--border-thin) solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .employee__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Clips the photo/fallback to the card's own rounded corners —
     * carried here (not just on .employee) now that .employee itself
     * doesn't clip, so the photo still reads as a rounded poster tile. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
  }

  .employee__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No photo yet — a brand-toned fill stands in for the image so the
   * card still reads as a full-bleed poster tile, not a broken/empty
   * one. Same big-initial idea the old circular fallback used, just
   * scaled up to fill the frame. */
  .employee__photo--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-green) 55%, var(--bg-raised)) 0%,
      var(--color-green-dark) 100%
    );
    color: rgb(255 255 255 / 0.85);
    font-family: var(--font-serif);
    font-size: 96px;
  }

  /* Bottom scrim — the info block sits on this, not directly on the
   * photo, so contact links stay legible over any image. Strongest
   * right behind the text, fading out toward the card's upper half so
   * the photo itself still reads clearly above the fold. */
  .employee__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 12 9 / 0.92) 0%,
      rgb(10 12 9 / 0.72) 32%,
      rgb(10 12 9 / 0.12) 62%,
      transparent 80%
    );
  }

  .employee__body {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: 100%;
    padding: var(--space-6);
    text-align: center;
    color: rgb(255 255 255 / 0.92);
  }

  .employee__name {
    font-size: var(--text-lg);
    font-weight: var(--font-semi);
    color: var(--color-white);
  }

  .employee__role {
    margin-top: calc(-1 * var(--space-1));
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.72);
  }

  .employee__coverage {
    margin-top: var(--space-3);
  }

  .employee__coverage-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.58);
  }

  .employee__coverage-list {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.85);
  }

  .employee__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .employee__link {
    font-size: var(--text-sm);
    color: var(--color-white);
    word-break: break-word;
  }

  .employee__link:hover {
    text-decoration: underline;
  }

  /* ── Leaf sprig — hidden until hover ──────────────────────────────
   * Same two-petal gradient bloom as CalloutSection.astro's (always
   * top-right) and AuthorBoxFooter.astro's (always bottom-right), just
   * parameterized here via data-leaf-corner (top-left or bottom-right
   * — the card's own two *sharp* corners, matching its border-radius,
   * so the sprig's point always sits flush in an actual corner rather
   * than floating over a rounded one) + scaled by --leaf-scale (one of
   * 4 discrete sizes, not a smooth range — deliberately chunkier,
   * more noticeable variety card-to-card). Sits at opacity:0 at rest;
   * revealed only on :hover, so it reads as a small discovery rather
   * than permanent decoration — a light scale-in on top of the fade
   * so it feels like it's growing in, not just appearing. */
  .employee[data-leaf-corner]::before,
  .employee[data-leaf-corner]::after {
    content: '';
    position: absolute;
    z-index: 2;
    aspect-ratio: 1 / 2.1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .employee[data-leaf-corner]:hover::before {
    opacity: 0.92;
  }

  .employee[data-leaf-corner]:hover::after {
    opacity: 0.68;
  }

  .employee[data-leaf-corner]::before {
    width: calc(clamp(28px, 24%, 64px) * var(--leaf-scale, 1));
    background: linear-gradient(160deg, var(--color-green-light), var(--color-green-dark));
  }

  .employee[data-leaf-corner]::after {
    width: calc(clamp(18px, 16%, 44px) * var(--leaf-scale, 1));
    background: linear-gradient(160deg, var(--color-green-pale), var(--color-green));
  }

  .employee[data-leaf-corner='tl']::before,
  .employee[data-leaf-corner='tl']::after {
    top: 0;
    left: 0;
    border-radius: 0 100% 0 100%;
    transform-origin: 0% 0%;
  }
  .employee[data-leaf-corner='tl']::before { transform: rotate(8deg) scale(0.6); }
  .employee[data-leaf-corner='tl']::after { transform: rotate(-30deg) scale(0.6); }
  .employee[data-leaf-corner='tl']:hover::before { transform: rotate(8deg) scale(1); }
  .employee[data-leaf-corner='tl']:hover::after { transform: rotate(-30deg) scale(1); }

  .employee[data-leaf-corner='br']::before,
  .employee[data-leaf-corner='br']::after {
    bottom: 0;
    right: 0;
    border-radius: 0 100% 0 100%;
    transform-origin: 100% 100%;
  }
  .employee[data-leaf-corner='br']::before { transform: rotate(-8deg) scale(0.6); }
  .employee[data-leaf-corner='br']::after { transform: rotate(30deg) scale(0.6); }
  .employee[data-leaf-corner='br']:hover::before { transform: rotate(-8deg) scale(1); }
  .employee[data-leaf-corner='br']:hover::after { transform: rotate(30deg) scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .employee[data-leaf-corner]::before,
    .employee[data-leaf-corner]::after {
      transition: opacity 0.25s ease;
    }
  }
</style>
