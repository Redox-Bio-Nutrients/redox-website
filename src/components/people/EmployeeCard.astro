---
// src/components/people/EmployeeCard.astro
//
// A single person tile — used for both a region's agronomist roster
// and the About Us page's office staff grid (moved out of
// components/regions/ 2026-09 once it needed to serve both — same
// underlying Team Member document either way, see author.ts). The
// photo fills the entire card (same leaf-corner surface as
// AuthorBoxFooter.astro's blog byline card), with name/title/coverage/
// contact floated over it on a bottom scrim, poster-card style rather
// than a small circular avatar above a text block. No photo yet still
// gets the full-bleed treatment — a brand-toned fill standing in for
// the image, with the same big initial the old circular fallback
// used, just scaled up to fill the frame — so a placeholder tile
// reads as "photo coming soon," not a broken layout. Coverage areas
// and email/phone are region-only fields on the underlying document
// (see author.ts) — they simply don't render for an office-staff-only
// person, no separate "mode" needed here.

import { urlFor } from '../../lib/sanity'
import type { Author } from '../../lib/types/sanity'

interface Props {
  author: Author
  /** Position within the grid (EmployeeGrid.astro's own map index) —
   * drives the leaf-sprig's corner/size below. Not optional: every
   * caller renders through EmployeeGrid, which always has an index to
   * give. */
  index: number
}

const { author, index } = Astro.props

const photoUrl = author.photo
  ? urlFor(author.photo).width(480).height(600).fit('crop').auto('format').quality(85).url()
  : null

const initial = author.name.trim().charAt(0).toUpperCase()

// Leaf-sprig motif (same two-petal gradient bloom CalloutSection.astro/
// AuthorBoxFooter.astro use, permanently visible at one fixed corner
// each) — here every card gets one, but hidden at rest and revealed
// only on hover (see the CSS below), so it reads as a small discovery
// rather than permanent decoration. Only the card's own two *sharp*
// corners (top-left/bottom-right, matching its border-radius) are in
// play, so the sprig's point always sits flush in an actual corner.
//
// Driven by grid position, not a per-person random roll (an earlier
// pass seeded this on author._id — replaced per Curtis's follow-up:
// he wants neighbors in the same row to always visibly differ, which
// independent per-card randomness can't promise, just makes likely).
// Corner alternates tl/br by index parity — since that guarantees any
// two *consecutive* indices differ, and any two cards "next to each
// other" in the same row are always consecutive indices regardless of
// the grid's column count (3/2/1 across breakpoints), this alone is
// enough to guarantee no same-row neighbors share a corner at any
// screen size, with no need to know the column count here. Size
// cycles through 4 fixed steps the same way (period 4, so any two
// consecutive indices always land on different sizes too) — offset
// from the corner's own period-2 cycle so the two don't just repeat
// the same combined pattern every 2 cards.
const LEAF_SIZES = [0.6, 0.9, 1.2, 1.6]
const leafCorner = index % 2 === 0 ? 'tl' : 'br'
const leafScale = LEAF_SIZES[index % LEAF_SIZES.length]

// Anti-harvesting: email/phone never appear in the page source as text
// or as mailto:/tel: hrefs — only as a reversed + base64'd data
// attribute behind an "Email me"/"Call me" link, decoded by the script
// below on click. Address-harvesting bots read raw HTML and don't run
// JS or click, which is what this defeats; a real visitor gets the
// value revealed in place plus their mail/phone app.
const encodeContact = (value: string) => btoa([...value].reverse().join(''))
const emailCode = author.email ? encodeContact(author.email.trim()) : null
const phoneCode = author.phone ? encodeContact(author.phone.trim()) : null
---

<div class="employee" data-leaf-corner={leafCorner} style={`--leaf-scale: ${leafScale}`}>
  <div class="employee__media">
    {photoUrl ? (
      <img
        class="employee__photo"
        src={photoUrl}
        alt={author.name}
        width="480"
        height="600"
        loading="lazy"
      />
    ) : (
      <span class="employee__photo employee__photo--fallback" aria-hidden="true">{initial}</span>
    )}
    <div class="employee__scrim" aria-hidden="true"></div>
  </div>
  <div class="employee__body">
    <p class="employee__name">{author.name}</p>
    {author.role && <p class="employee__role">{author.role}</p>}
    {(author.coverageLabel || (author.coverageAreas && author.coverageAreas.length > 0)) && (
      <div class="employee__coverage">
        <p class="employee__coverage-label">Covers</p>
        {/* coverageAreas holds exact state names and can run long, so a
            short coverageLabel (e.g. "Pacific Northwest") shows here
            instead when one's set — with or without any states listed;
            the full state list is the fallback for anyone without a
            label. */}
        <p class="employee__coverage-list">
          {author.coverageLabel || author.coverageAreas?.join(' · ')}
        </p>
      </div>
    )}
    <div class="employee__contact">
      {emailCode && (
        <a class="btn btn--ghost btn--on-color btn--sm employee__contact-btn" href="#" role="button" data-contact="email" data-code={emailCode} aria-label={`Email ${author.name}`}>
          <svg class="employee__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          <span class="employee__contact-text">Email me</span>
        </a>
      )}
      {phoneCode && (
        <a class="btn btn--ghost btn--on-color btn--sm employee__contact-btn" href="#" role="button" data-contact="phone" data-code={phoneCode} aria-label={`Call ${author.name}`}>
          <svg class="employee__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          <span class="employee__contact-text">Call me</span>
        </a>
      )}
    </div>
  </div>
</div>

<script>
  // One delegated listener for every card on the page (Astro bundles
  // and dedupes this script however many cards render). First click
  // decodes the value, shows it in place, and swaps in the real
  // mailto:/tel: href; email then opens the mail app right away, phone
  // only dials straight away on touch devices — on desktop, revealing
  // the number is the useful part and a tel: prompt would just be noise.
  const decode = (code: string) => [...atob(code)].reverse().join('')

  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-contact][data-code]')
    if (!link) return
    event.preventDefault()

    const value = decode(link.dataset.code!)
    const isEmail = link.dataset.contact === 'email'
    const href = isEmail ? `mailto:${value}` : `tel:${value.replace(/[^\d+]/g, '')}`

    link.querySelector('.employee__contact-text')!.textContent = value
    link.href = href
    link.classList.add('is-revealed')
    link.removeAttribute('role')
    link.removeAttribute('aria-label')
    delete link.dataset.code

    if (isEmail || window.matchMedia('(pointer: coarse)').matches) {
      window.location.href = href
    }
  })
</script>

<style>
  .employee {
    position: relative;
    /* Poster-card aspect — tall enough for a portrait crop to read as
     * a photo, not a banner. */
    aspect-ratio: 4 / 5;
    display: flex;
    /* No overflow:hidden here (moved to .employee__media below) — the
     * occasional leaf sprig is allowed to spill past the card's own
     * edge, same as CalloutSection's/AuthorBoxFooter's permanent ones. */
    /* Same asymmetric leaf-radius language as the callout/author-box
     * cards, scaled down to a roster-tile size. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
    border: var(--border-thin) solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .employee__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Clips the photo/fallback to the card's own rounded corners —
     * carried here (not just on .employee) now that .employee itself
     * doesn't clip, so the photo still reads as a rounded poster tile. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
  }

  .employee__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No photo yet — a brand-toned fill stands in for the image so the
   * card still reads as a full-bleed poster tile, not a broken/empty
   * one. Same big-initial idea the old circular fallback used, just
   * scaled up to fill the frame. */
  .employee__photo--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-green) 55%, var(--bg-raised)) 0%,
      var(--color-green-dark) 100%
    );
    color: rgb(255 255 255 / 0.85);
    font-family: var(--font-serif);
    font-size: 96px;
  }

  /* Bottom scrim — the info block sits on this, not directly on the
   * photo, so contact links stay legible over any image. Strongest
   * right behind the text, fading out toward the card's upper half so
   * the photo itself still reads clearly above the fold. */
  .employee__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 12 9 / 0.92) 0%,
      rgb(10 12 9 / 0.72) 32%,
      rgb(10 12 9 / 0.12) 62%,
      transparent 80%
    );
  }

  .employee__body {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: 100%;
    padding: var(--space-6);
    text-align: center;
    color: rgb(255 255 255 / 0.92);
  }

  .employee__name {
    font-size: var(--text-lg);
    font-weight: var(--font-semi);
    color: var(--color-white);
  }

  .employee__role {
    margin-top: calc(-1 * var(--space-1));
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.72);
  }

  .employee__coverage {
    margin-top: var(--space-3);
  }

  .employee__coverage-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  .employee__coverage-list {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.85);
  }

  /* Side-by-side pill buttons (shared .btn ghost/on-color styles from
   * buttons.css), equal width at rest. Once one's clicked and shows the
   * full address/number, it's allowed to wrap onto its own row rather
   * than truncate — flex-wrap handles that without a layout switch. */
  .employee__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .employee__contact:empty {
    display: none;
  }

  .employee__contact-btn {
    flex: 1 1 0;
    min-width: max-content;
  }

  .employee__contact-btn.is-revealed {
    flex-basis: auto;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  .employee__contact-icon {
    width: 1.1em;
    height: 1.1em;
    flex-shrink: 0;
  }

  /* ── Leaf sprig — hidden until hover ──────────────────────────────
   * Same two-petal gradient bloom as CalloutSection.astro's (always
   * top-right) and AuthorBoxFooter.astro's (always bottom-right), just
   * parameterized here via data-leaf-corner (top-left or bottom-right
   * — the card's own two *sharp* corners, matching its border-radius,
   * so the sprig's point always sits flush in an actual corner rather
   * than floating over a rounded one) + scaled by --leaf-scale (one of
   * 4 discrete sizes, not a smooth range — deliberately chunkier,
   * more noticeable variety card-to-card). Sits at opacity:0 at rest;
   * revealed only on :hover, so it reads as a small discovery rather
   * than permanent decoration — a light scale-in on top of the fade
   * so it feels like it's growing in, not just appearing. */
  .employee[data-leaf-corner]::before,
  .employee[data-leaf-corner]::after {
    content: '';
    position: absolute;
    z-index: 2;
    aspect-ratio: 1 / 2.1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .employee[data-leaf-corner]:hover::before {
    opacity: 0.92;
  }

  .employee[data-leaf-corner]:hover::after {
    opacity: 0.68;
  }

  .employee[data-leaf-corner]::before {
    width: calc(clamp(28px, 24%, 64px) * var(--leaf-scale, 1));
    background: linear-gradient(160deg, var(--color-green-light), var(--color-green-dark));
  }

  .employee[data-leaf-corner]::after {
    width: calc(clamp(18px, 16%, 44px) * var(--leaf-scale, 1));
    background: linear-gradient(160deg, var(--color-green-pale), var(--color-green));
  }

  .employee[data-leaf-corner='tl']::before,
  .employee[data-leaf-corner='tl']::after {
    top: 0;
    left: 0;
    border-radius: 0 100% 0 100%;
    transform-origin: 0% 0%;
  }
  .employee[data-leaf-corner='tl']::before { transform: rotate(8deg) scale(0.6); }
  .employee[data-leaf-corner='tl']::after { transform: rotate(-30deg) scale(0.6); }
  .employee[data-leaf-corner='tl']:hover::before { transform: rotate(8deg) scale(1); }
  .employee[data-leaf-corner='tl']:hover::after { transform: rotate(-30deg) scale(1); }

  .employee[data-leaf-corner='br']::before,
  .employee[data-leaf-corner='br']::after {
    bottom: 0;
    right: 0;
    border-radius: 0 100% 0 100%;
    transform-origin: 100% 100%;
  }
  .employee[data-leaf-corner='br']::before { transform: rotate(-8deg) scale(0.6); }
  .employee[data-leaf-corner='br']::after { transform: rotate(30deg) scale(0.6); }
  .employee[data-leaf-corner='br']:hover::before { transform: rotate(-8deg) scale(1); }
  .employee[data-leaf-corner='br']:hover::after { transform: rotate(30deg) scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .employee[data-leaf-corner]::before,
    .employee[data-leaf-corner]::after {
      transition: opacity 0.25s ease;
    }
  }
</style>
