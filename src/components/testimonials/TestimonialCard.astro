---
// src/components/testimonials/TestimonialCard.astro
//
// One customer quote tile for a testimonials grid — a compact sibling
// of TestimonialSection.astro (the single large pull-quote used on a
// product page's own page-builder). Same visual language (serif
// italic quote, oversized quotation-mark glyph, avatar-or-initial
// meta row) scaled down since a grid shows several at once, plus the
// same asymmetric leaf-radius corner EmployeeCard.astro/
// CollectionShowcase.astro use for their own card grids.

import { urlFor } from '../../lib/sanity'
import type { Testimonial } from '../../lib/types/sanity'

interface Props {
  testimonial: Testimonial
}

const { testimonial } = Astro.props

const avatarUrl = testimonial.avatar
  ? urlFor(testimonial.avatar).width(96).height(96).fit('crop').auto('format').quality(85).url()
  : null
const initial = testimonial.name.trim().charAt(0).toUpperCase()

// Course/field photos (up to 4) sit in a mosaic across the top of the
// card, like the old redoxgrows.com/turf cards: one fills the strip,
// two split it, three or four put the first one large on the left.
const photos = (testimonial.photos ?? []).filter((photo) => photo?.asset).slice(0, 4)
const photoTiles = photos.map((photo, index) => ({
  url: urlFor(photo)
    .width(index === 0 ? 900 : 480)
    .height(index === 0 ? 600 : 400)
    .fit('crop')
    .auto('format')
    .quality(80)
    .url(),
  // Full-size version for the lightbox (src/components/ui/Lightbox.astro).
  large: urlFor(photo).width(1800).fit('max').auto('format').quality(85).url(),
  alt: photo.alt ?? '',
}))
const photoCaption = [testimonial.name, testimonial.company].filter(Boolean).join(' · ')

// Quotes range from one line to a full paragraph; cards in a carousel
// row stretch to the tallest, so short quotes get larger type to fill
// their card instead of floating in empty space, and long ones step
// down to stay a readable block.
const quoteLength = testimonial.quote?.length ?? 0
const quoteSize = quoteLength < 180 ? 'short' : quoteLength < 420 ? 'medium' : 'long'
---

<figure class="card" data-has-photos={photoTiles.length > 0 ? '' : undefined}>
  {photoTiles.length > 0 && (
    <div class="card__photos" data-count={photoTiles.length}>
      {photoTiles.map((tile, index) => (
        <button
          type="button"
          class="card__photo-btn"
          data-lightbox-group={testimonial._id}
          data-lightbox-src={tile.large}
          data-lightbox-alt={tile.alt}
          data-lightbox-caption={photoCaption}
          aria-label={`View photo ${index + 1} of ${photoTiles.length} from ${testimonial.name}`}
        >
          <img class="card__photo" src={tile.url} alt={tile.alt} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
  <span class="card__mark" aria-hidden="true">&ldquo;</span>
  <blockquote class="card__quote" data-size={quoteSize} data-clampable={quoteSize !== 'short' ? '' : undefined}>{testimonial.quote}</blockquote>
  {quoteSize !== 'short' && (
    <button type="button" class="card__more" aria-expanded="false" hidden>Read more</button>
  )}
  <figcaption class="card__meta">
    {avatarUrl ? (
      <img
        class="card__avatar"
        src={avatarUrl}
        alt={testimonial.avatar?.alt ?? ''}
        width="48"
        height="48"
        loading="lazy"
      />
    ) : (
      <span class="card__avatar card__avatar--fallback" aria-hidden="true">{initial}</span>
    )}
    <div>
      <p class="card__name">{testimonial.name}</p>
      {(testimonial.role || testimonial.company) && (
        <p class="card__role">{[testimonial.role, testimonial.company].filter(Boolean).join(', ')}</p>
      )}
    </div>
  </figcaption>
</figure>

<script>
  // Long quotes clamp at every width (see .card__quote[data-clampable]
  // below) so one paragraph-length testimonial doesn't make the whole
  // carousel row screen-tall. The toggle only appears when the text is
  // actually cut off at the current width, and is re-checked on resize.
  // The clamp is visual only — screen readers always get the full quote.
  document.querySelectorAll<HTMLElement>('.card__quote[data-clampable]').forEach((quote) => {
    const button = quote.nextElementSibling as HTMLButtonElement | null
    if (!button?.classList.contains('card__more')) return

    const sync = () => {
      if (button.getAttribute('aria-expanded') === 'true') return
      button.hidden = quote.scrollHeight <= quote.clientHeight + 1
    }

    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true'
      button.setAttribute('aria-expanded', String(expanded))
      button.textContent = expanded ? 'Show less' : 'Read more'
      quote.classList.toggle('is-expanded', expanded)
    })

    new ResizeObserver(sync).observe(quote)
    sync()
  })
</script>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: var(--border-thin) solid var(--border-subtle);
    border-radius: 0 var(--radius-3xl) 0 var(--radius-3xl);
    /* Top/side padding as variables so the photo strip can bleed to the
     * edges at every breakpoint. */
    --card-pad-top: var(--space-10);
    --card-pad-x: var(--space-10);
    padding: var(--card-pad-top) var(--card-pad-x) var(--space-8);
    margin: 0;
    overflow: hidden;
  }

  /* Photo mosaic — bleeds to the card's edges (cancelling its padding)
   * across the top, above the quote. */
  .card__photos {
    display: grid;
    gap: 3px;
    height: 220px;
    margin: calc(-1 * var(--card-pad-top)) calc(-1 * var(--card-pad-x)) var(--space-2);
  }

  .card__photos[data-count='2'] {
    grid-template-columns: 1fr 1fr;
  }

  .card__photos[data-count='3'],
  .card__photos[data-count='4'] {
    grid-template-columns: 2fr 1fr;
  }

  .card__photos[data-count='3'] .card__photo-btn:first-child {
    grid-row: span 2;
  }

  .card__photos[data-count='4'] .card__photo-btn:first-child {
    grid-row: span 3;
  }

  .card__photo-btn {
    display: block;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
    cursor: zoom-in;
  }

  .card__photo-btn:focus-visible {
    outline: 3px solid var(--color-green);
    outline-offset: -3px;
  }

  .card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .card__photo-btn:hover .card__photo {
    transform: scale(1.04);
  }

  /* With photos on top, the decorative quote mark moves down to sit
   * just under them instead of in the card's top corner. */
  .card[data-has-photos] .card__mark {
    top: calc(220px + var(--space-6));
  }

  /* Oversized decorative mark tucked into the top-left corner, behind
   * the quote — reads as a graphic, not a character in the text. */
  .card__mark {
    position: absolute;
    top: 0.02em;
    left: 0.12em;
    font-family: var(--font-serif);
    font-size: 9rem;
    line-height: 1;
    color: var(--color-green);
    opacity: 0.16;
    pointer-events: none;
    user-select: none;
  }

  .card__quote {
    position: relative;
    margin: var(--space-10) 0 0;
    /* Body sans, upright — DM Serif Display (the heading face) is a
     * high-contrast display cut and got hard to read as paragraph-length
     * italic text. The serif stays on the section heading and the big
     * quote mark, which carry the editorial feel. */
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: var(--font-normal);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
    flex-grow: 1;
    text-wrap: pretty;
    /* Multi-paragraph quotes are stored with blank lines between
     * paragraphs — keep those breaks. */
    white-space: pre-line;
  }

  .card__quote[data-size='short'] {
    font-size: var(--text-2xl);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
  }

  .card__quote[data-size='medium'] {
    font-size: var(--text-xl);
  }

  .card__quote[data-size='long'] {
    font-size: var(--text-base);
  }

  .card__more {
    align-self: flex-start;
    margin-top: var(--space-3);
    padding: var(--space-1) 0;
    min-height: 24px;
    background: none;
    border: none;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    color: var(--color-green-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .card__more[hidden] {
    display: none;
  }

  /* Long quotes clamp behind a "Read more" toggle at every width — the
   * carousel stretches all cards to the tallest one, so one very long
   * quote would otherwise leave every other card mostly empty. 10 lines
   * on desktop, 8 on phones/tablets. */
  .card__quote[data-clampable]:not(.is-expanded) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 10;
    line-clamp: 10;
    overflow: hidden;
    flex-grow: 0;
  }

  /* The clamped quote no longer grows, so the name block is pushed to
   * the card's bottom edge instead (keeps every card's meta row
   * aligned); the quote/toggle carry the minimum gap above it. */
  .card__quote[data-clampable],
  .card__more {
    margin-bottom: var(--space-8);
  }

  .card__quote[data-clampable]:has(+ .card__more:not([hidden])) {
    margin-bottom: 0;
  }

  .card__more + .card__meta,
  .card__quote + .card__meta {
    margin-top: auto;
  }

  @media (max-width: 1023px) {
    .card__quote[data-clampable]:not(.is-expanded) {
      -webkit-line-clamp: 8;
      line-clamp: 8;
    }
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border-thin) solid var(--border-subtle);
  }

  @media (max-width: 639px) {
    .card {
      --card-pad-top: var(--space-8);
      --card-pad-x: var(--space-6);
      padding: var(--card-pad-top) var(--card-pad-x) var(--space-6);
    }

    .card__photos {
      height: 180px;
    }

    .card[data-has-photos] .card__mark {
      top: calc(180px + var(--space-4));
    }

    .card__mark {
      font-size: 7rem;
    }

    .card__quote[data-size='short'] {
      font-size: var(--text-xl);
    }

    .card__quote[data-size='medium'] {
      font-size: var(--text-lg);
    }
  }

  .card__avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }

  .card__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-green) 18%, var(--bg-raised));
    color: var(--color-green-dark);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .card__name {
    font-weight: var(--font-semi);
    color: var(--color-text-primary);
  }

  .card__role {
    margin-top: 2px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
