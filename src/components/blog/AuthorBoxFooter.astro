---
// src/components/blog/AuthorBoxFooter.astro
//
// "Footer" author box — a self-contained card sitting right after the
// article prose, before Related Products. Sized to the article's own
// --prose-width (not the page's full --content-width) so it reads as
// part of the article rather than a full-bleed banner. Won out over a
// sticky side-rail variant that was prototyped alongside it (Curtis's
// call) — see BlogPostDetail.astro's git history if that's ever worth
// revisiting.

import { urlFor } from '../../lib/sanity'
import type { Author } from '../../lib/types/sanity'

interface Props {
  author: Author
}

const { author } = Astro.props

const photoUrl = author.photo
  ? urlFor(author.photo).width(160).height(160).fit('crop').auto('format').quality(85).url()
  : null

const initial = author.name.trim().charAt(0).toUpperCase()
---

<section class="author-footer">
  <div class="author-footer__card">
    {photoUrl ? (
      <img
        class="author-footer__photo"
        src={photoUrl}
        alt={author.name}
        width="72"
        height="72"
        loading="lazy"
      />
    ) : (
      <span class="author-footer__photo author-footer__photo--fallback" aria-hidden="true">{initial}</span>
    )}
    <div class="author-footer__body">
      <p class="author-footer__eyebrow">Written by</p>
      <p class="author-footer__name">{author.name}</p>
      {author.role && <p class="author-footer__role">{author.role}</p>}
      {author.bio && <p class="author-footer__bio">{author.bio}</p>}
    </div>
  </div>
</section>

<style>
  .author-footer {
    max-width: var(--prose-width, 54rem);
    margin: var(--space-10) auto 0;
    padding: 0 var(--space-6);
  }

  .author-footer__card {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-8);
    background: var(--bg-surface);
    border: var(--border-thin) solid var(--border-subtle);
    /* Mirrored-leaf corner, scaled down from the site's --radius-leaf-
     * mirror token to a card-sized detail — same asymmetric-radius
     * language ProductDetail's sidebar card uses. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
  }

  .author-footer__photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .author-footer__photo--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-green) 18%, var(--bg-raised));
    color: var(--color-green-dark);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
  }

  .author-footer__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .author-footer__name {
    font-size: var(--text-lg);
    font-weight: var(--font-semi);
    color: var(--color-text-primary);
  }

  .author-footer__role {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .author-footer__bio {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .author-footer__card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
