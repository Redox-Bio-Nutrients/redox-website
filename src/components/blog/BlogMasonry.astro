---
// src/components/blog/BlogMasonry.astro
//
// True variable-height (Pinterest-style) masonry — no JS needed.
// Three approaches were tried and dropped before this one:
//   - Uniform-height tiles read flat and repetitive.
//   - CSS multi-column (`columns: 3`) with each tile's *native* photo
//     aspect ratio: wildly inconsistent heights (a very wide source
//     photo next to a tall portrait one), and fills column-by-column
//     — the newest posts all stacked in column 1 before column 2 even
//     started, reading backwards.
//   - CSS Grid + `grid-auto-flow: row dense` with curated height
//     buckets: fixed the height problem, and *mostly* reads in
//     chronological order, but `dense` only guarantees no gaps, not
//     order — with large enough height differences between buckets it
//     can pull a much-older post forward several slots to plug a hole
//     while the newest posts pile up in whichever column happened to
//     free up fastest. Visible in review: two 2026 posts stacked in
//     column 1 while column 2 and 3 opened with a 2023 and a 2022 post.
// This version distributes tiles into columns explicitly, in plain
// round-robin (tile 0 -> col 0, tile 1 -> col 1, ... wrapping), at
// build time in the frontmatter below — a hard guarantee that reading
// left-to-right then down never skips out of publish order, which
// `dense` packing can't promise. Each column is then just a plain
// flex column stack (gap, no packing algorithm needed at all) — a
// tile's curated height bucket (HEIGHT_BUCKETS below, still
// deterministic per post rather than the photo's native aspect ratio)
// only affects that one column's total length, no cross-column
// reshuffling.
//
// The column *membership* is a build-time decision (round-robin over
// N columns), so it can't be expressed in CSS alone — this renders
// three complete variants (3/2/1 columns, matching the desktop/
// tablet/mobile breakpoints) and shows only one at a time via media
// query. Costs some extra markup (each post's tile markup appears up
// to 3 times in the HTML) in exchange for staying fully static: no
// client JS, no reflow-on-resize logic, no hydration. Hidden variants'
// `<img loading="lazy">` never fires — lazy-loading only loads what's
// actually laid out, and `display: none` has no box — so this doesn't
// cost extra image requests, only extra (highly repetitive, so
// cheaply gzipped) markup text.
//
// Card look itself (rounded-corner tile, category/title/date/byline
// overlaid directly on the photo above a gradient scrim) lives in
// BlogMasonryTile.astro, rendered identically into all three variants
// below rather than hand-duplicated.
//
// Color: blog posts have no `primaryColor` field the way products do,
// so each tile gets a deterministic "grounded" accent (groundedAccent(),
// src/lib/color.ts — the same curated hue bands as CalloutSection's
// product-page boxes) seeded off the post's own `_id`.
//
// Posts with no cover image of their own fall back to a deterministic
// pick from the shared Background Imagery pool (seeded on the post's
// own _id) — same fallback the detail page hero uses
// (BlogPostDetail.astro) — rather than a flat placeholder tile, so the
// grid stays photo-driven end to end.

import { urlFor } from '../../lib/sanity'
import { deriveCalloutPalette, groundedAccent } from '../../lib/color'
import { randomChoice, seededRandom } from '../../lib/seededRandom'
import BlogMasonryTile from './BlogMasonryTile.astro'
import type { BlogPostCard } from '../../lib/types/sanity'

interface Props {
  posts: BlogPostCard[]
  emptyMessage?: string
}

const { posts, emptyMessage = 'More posts coming soon.' } = Astro.props

// Four curated tile heights (not the photo's native aspect ratio —
// real photos ranged wildly tall/short and produced erratic-looking
// columns). Expressed as CSS aspect-ratio values.
const HEIGHT_BUCKETS = ['4 / 3', '1 / 1', '4 / 5', '3 / 5']

const tiles = posts.map((post) => {
  const heroImage =
    post.coverImage ??
    (post.fallbackPool?.length ? randomChoice(seededRandom(post._id), post.fallbackPool) : null)
  // Separately seeded from the heroImage pick above (a distinct seed
  // string, not just a second draw off the same generator) so the two
  // choices vary independently instead of tracking each other.
  const aspectRatio = randomChoice(seededRandom(`${post._id}-height`), HEIGHT_BUCKETS)

  return {
    post,
    heroImage,
    imageUrl: heroImage
      ? urlFor(heroImage).width(900).auto('format').quality(75).url()
      : null,
    aspectRatio,
    accent: groundedAccent(post._id),
    authorPhotoUrl: post.author?.photo
      ? urlFor(post.author.photo).width(80).height(80).fit('crop').auto('format').url()
      : null,
    // Category chip color: an editor-set category.color (Studio) wins
    // when present; otherwise derived from the category's own slug
    // (not the post's), so e.g. every un-colored "Agronomy" pill
    // site-wide still lands on the same automatic color, distinct from
    // the per-post accent used for the scrim/glow.
    categoryChips: (post.categories ?? []).map((category) => ({
      category,
      palette: deriveCalloutPalette(category.color ?? groundedAccent(category.slug)),
    })),
  }
})

// Round-robin distribution — see frontmatter. tile[i] always lands in
// column i % columnCount, so reading left-to-right then wrapping can
// never skip out of publish order, unlike gap-filling packing.
function intoColumns<T>(items: T[], columnCount: number): T[][] {
  const columns: T[][] = Array.from({ length: columnCount }, () => [])
  items.forEach((item, i) => columns[i % columnCount].push(item))
  return columns
}

const desktopColumns = intoColumns(tiles, 3)
const tabletColumns = intoColumns(tiles, 2)
---

{tiles.length > 0 ? (
  <div class="masonry-wrap">
    {/* Prototype filter — client-side only, no re-query. Hides tiles
       via the data-markets attribute BlogMasonryTile.astro sets on
       each one; doesn't rebalance the round-robin columns for the
       filtered subset, so a filtered view can look column-heavy
       until/unless this is worth a real reflow pass. An untagged post
       (every WordPress-migrated one, today) counts as Agriculture —
       same convention the background-pool fallback uses, so
       "Agriculture" isn't a near-empty view relative to "All Posts". */}
    <div class="masonry-filter" role="group" aria-label="Filter by market">
      <button type="button" class="filter-btn is-active" data-filter="all">All Posts</button>
      <button type="button" class="filter-btn" data-filter="agriculture">Agriculture</button>
      <button type="button" class="filter-btn" data-filter="turf">Turf</button>
    </div>
    <div class="masonry-cols masonry-cols--desktop">
      {desktopColumns.map((column) => (
        <div class="masonry__col">
          {column.map((tile) => <BlogMasonryTile {...tile} />)}
        </div>
      ))}
    </div>
    <div class="masonry-cols masonry-cols--tablet">
      {tabletColumns.map((column) => (
        <div class="masonry__col">
          {column.map((tile) => <BlogMasonryTile {...tile} />)}
        </div>
      ))}
    </div>
    <div class="masonry-cols masonry-cols--mobile">
      <div class="masonry__col">
        {tiles.map((tile) => <BlogMasonryTile {...tile} />)}
      </div>
    </div>
    <p class="empty masonry-filter-empty" hidden></p>
  </div>
) : (
  <p class="empty">{emptyMessage}</p>
)}

<script>
  const wrap = document.querySelector<HTMLElement>('.masonry-wrap')
  const buttons = wrap?.querySelectorAll<HTMLButtonElement>('.filter-btn')
  const tiles = wrap?.querySelectorAll<HTMLElement>('.masonry__item')
  const emptyEl = wrap?.querySelector<HTMLElement>('.masonry-filter-empty')

  function applyFilter(filter: string) {
    if (!tiles) return
    let visibleCount = 0
    tiles.forEach((tile) => {
      const markets = (tile.dataset.markets ?? '').split(',').filter(Boolean)
      const matches =
        filter === 'all' ||
        (filter === 'agriculture' && (markets.length === 0 || markets.includes('agriculture'))) ||
        (filter === 'turf' && markets.includes('turf'))
      tile.classList.toggle('is-filtered-out', !matches)
      if (matches) visibleCount += 1
    })
    if (emptyEl) {
      emptyEl.hidden = visibleCount > 0
      if (visibleCount === 0) {
        const label = filter === 'turf' ? 'Turf' : filter === 'agriculture' ? 'Agriculture' : 'these'
        emptyEl.textContent = `No ${label} posts yet — check back soon.`
      }
    }
  }

  buttons?.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'))
      button.classList.add('is-active')
      applyFilter(button.dataset.filter ?? 'all')
    })
  })
</script>

<style>
  .masonry-wrap {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-10) var(--space-6) var(--space-24);
  }

  .masonry-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter-btn {
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: var(--border-thin) solid var(--border-subtle);
    background: var(--bg-page);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-green);
    color: var(--color-text-primary);
  }

  .filter-btn.is-active {
    background: var(--color-green-dark);
    border-color: var(--color-green-dark);
    color: var(--color-white);
  }

  /* .masonry__item itself is scoped to BlogMasonryTile.astro, not this
   * file -- Astro's per-component style scoping means a plain rule
   * here would silently never match it, so this one rule has to
   * escape scoping deliberately. */
  :global(.masonry__item.is-filtered-out) {
    display: none;
  }

  .masonry-filter-empty {
    margin-top: var(--space-4);
  }

  .masonry-cols {
    display: none;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .masonry__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
    flex: 1 1 0;
  }

  .masonry-cols--desktop {
    display: flex;
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0 var(--space-24);
  }

  @media (max-width: 1023px) {
    .masonry-cols--desktop {
      display: none;
    }

    .masonry-cols--tablet {
      display: flex;
    }
  }

  @media (max-width: 639px) {
    .masonry-cols--tablet {
      display: none;
    }

    .masonry-cols--mobile {
      display: flex;
    }

    .masonry-wrap {
      padding-bottom: var(--space-16);
    }
  }
</style>
