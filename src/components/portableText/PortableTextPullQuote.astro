---
// src/components/portableText/PortableTextPullQuote.astro
//
// A standalone emphasis quote, embeddable anywhere blockContent is
// used (see blockContent.ts's "pullQuote" object) — not a customer
// testimonial (see src/components/testimonials/ for that separate,
// name-attributed pool), just a statement worth calling out from the
// page's own copy. Same oversized-quotation-mark visual language as
// TestimonialCard.astro/TestimonialSection.astro for consistency, but
// lighter — no avatar/meta row, since there's often no person to
// attribute it to.

import type { Props as PortableTextProps } from 'astro-portabletext/types'

interface PullQuoteNode {
  _type: 'pullQuote'
  quote: string
  attribution?: string
}

type Props = PortableTextProps<PullQuoteNode>

const { node } = Astro.props
---

<figure class="pt-quote">
  <span class="pt-quote__mark" aria-hidden="true">&ldquo;</span>
  <blockquote class="pt-quote__text">{node.quote}</blockquote>
  {node.attribution && <figcaption class="pt-quote__attribution">— {node.attribution}</figcaption>}
</figure>

<style>
  /* --prose-width, when an ancestor defines it, keeps this
   * pixel-identical with every other block in that reading column —
   * same fallback pattern as PortableTextGallery.astro. */
  .pt-quote {
    max-width: var(--prose-width, 100%);
    margin: var(--space-10) auto;
    text-align: center;
  }

  .pt-quote__mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--color-green);
    opacity: 0.3;
    margin-bottom: -1.25rem;
  }

  .pt-quote__text {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--font-normal);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .pt-quote__attribution {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .pt-quote__mark {
      font-size: 3.5rem;
    }

    .pt-quote__text {
      font-size: var(--text-2xl);
    }
  }
</style>
