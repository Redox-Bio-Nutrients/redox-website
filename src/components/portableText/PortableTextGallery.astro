---
// src/components/portableText/PortableTextGallery.astro
//
// Renders a photo grid instead of stacking images full-width, one per
// row (PortableTextImage.astro). Shared by two different _type values
// that both resolve to the same { images: [...] } shape -- see
// src/lib/portableTextComponents.ts for why there are two: "gallery"
// is the real schema type (sanity/schemas/objects/blockContent.ts) an
// editor deliberately inserts anywhere blockContent is used;
// "imageGallery" is a synthetic type manufactured by
// groupImageRuns() in BlogPostDetail.astro, blog-only, for migrated
// WordPress posts that have a run of 2+ plain image blocks in a row
// with no idea "gallery" was ever a choice (e.g. a "30 years in
// photos" anniversary retrospective that came through the migration
// as 244 flat, full-width, one-per-row images -- everything
// technically rendered, nothing that read like a gallery).
//
// Deliberately no lightbox / no client JS, consistent with every other
// gallery/grid on the site (BlogMasonry, BlogFeatured, ProductGrid are
// all plain CSS): tapping a tile just opens that one photo at full
// size in a new tab. Revisit with a real lightbox if that's ever
// wanted.

import { urlFor } from '../../lib/sanity'
import type { Props as PortableTextProps } from 'astro-portabletext/types'

interface ImageNode {
  _type: 'image'
  asset: { _ref: string; _type: 'reference' }
  alt?: string
}

interface GalleryNode {
  _type: 'gallery' | 'imageGallery'
  images: ImageNode[]
}

type Props = PortableTextProps<GalleryNode>

const { node } = Astro.props

const tiles = node.images.map((image) => ({
  thumbUrl: urlFor(image).width(500).height(500).fit('crop').auto('format').quality(70).url(),
  fullUrl: urlFor(image).width(1800).auto('format').quality(85).url(),
  alt: image.alt ?? '',
}))
---

<div class="pt-gallery">
  {tiles.map(({ thumbUrl, fullUrl, alt }) => (
    <a href={fullUrl} target="_blank" rel="noopener noreferrer" class="pt-gallery__tile">
      <img src={thumbUrl} alt={alt} loading="lazy" />
    </a>
  ))}
</div>

<style>
  /* --prose-width, when an ancestor defines it (currently just
   * BlogPostDetail.astro's .body), keeps this pixel-identical with
   * every other block in that reading column. Everywhere else, falls
   * back to 100% of whatever width the container already provides --
   * see PortableTextImage.astro's comment for why. */
  .pt-gallery {
    max-width: var(--prose-width, 100%);
    margin: var(--space-8) auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .pt-gallery__tile {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .pt-gallery__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .pt-gallery__tile:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 479px) {
    .pt-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
