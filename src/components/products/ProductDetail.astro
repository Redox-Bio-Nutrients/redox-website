---
// src/components/products/ProductDetail.astro
//
// The actual product page design — hero, sections, sidebar, resource
// request dialog. Extracted out of src/pages/products/[slug].astro so
// the exact same rendering is shared by the real static route and the
// SSR draft-preview route (src/pages/preview/products/[slug].astro).
// Takes a fully-resolved `product` and renders it; doesn't care
// whether that came from the public (published-only) client or the
// draft-aware preview client — see src/lib/queries/products.ts.
//
// Hero follows the image-led, bottom-aligned pattern (reference:
// Lapalma product page): full-bleed imagery, display-size product
// name at the bottom, hairline rule, then a quiet meta row. Falls back
// to a layered gradient of the product's primaryColor when no image is
// set. Sections render below inside a wrapper that exposes
// --product-color to every renderer.

import ProductSections from './ProductSections.astro'
import ResourceRequestDialog from './ResourceRequestDialog.astro'
import { urlFor } from '../../lib/sanity'
import { getProductVariant } from '../../lib/productVariant'
import { deriveCalloutPalette } from '../../lib/color'
import '../../styles/turf-livery.css'
import type { Product } from '../../lib/types/sanity'

interface Props {
  product: Product
}

const { product } = Astro.props

const color = product.primaryColor ?? '#2E6B3E'
const accentColor = product.accentColor
// Which visual system the sections below render in — see
// src/lib/productVariant.ts for the exact rule. No real Turf-only
// product exists yet, so this branch is currently dead in production;
// wired ahead of the content so it's ready the moment one is tagged.
const variant = getProductVariant(product.markets)
const isTurf = variant === 'turf'
// Second gradient stop for the turf hero/sidebar wash — the real
// accentColor when a product has set one, otherwise the same derived
// complement every other turf section already uses.
const turfAccent = deriveCalloutPalette(color, accentColor).complement
// Background pool: heroImage + the backgrounds gallery. The server
// renders the first image so the page never flashes empty; an inline
// script swaps in a random pick before paint on every load.
const bgPool = (product.backgrounds ?? []).map((img) => ({
  url: urlFor(img).width(2400).height(1400).fit('crop').auto('format').quality(75).url(),
  lqip: img.lqip ?? null,
}))
const heroImage = bgPool[0] ?? null
const marketLinks = product.markets.map((m) =>
  m === 'agriculture'
    ? { label: 'Agriculture', href: '/agriculture' }
    : { label: 'Turf', href: '/turf' },
)

const relatedCards = (product.relatedProducts ?? []).map((p) => ({
  ...p,
  thumb: p.image ? urlFor(p.image).width(160).height(160).fit('crop').url() : null,
}))

// Packaging shot floats on the right side of the hero — full image,
// never cropped
const productShotUrl = product.image
  ? urlFor(product.image).width(900).fit('max').url()
  : null

// Stylized wordmark, when a product has one — replaces the plain text
// hero title on every product page, regardless of market (the hero
// itself isn't market-specific yet, so this one change already covers
// both). Falls back to the text title when empty, same as every other
// optional-image field on this page.
const logoUrl = product.logo
  ? urlFor(product.logo).width(700).fit('max').auto('format').url()
  : null

// Turf products carry the full "TurfRx X" name in product.title (real
// name for listings/SEO/"Pairs Well With" cards) but the hero already
// shows a separate "TurfRx®" eyebrow above the big wordmark — stripping
// a leading "TurfRx" from just the big-text fallback avoids "TurfRx® /
// TurfRx Ca" doubling up. Doesn't touch product.title itself, or the
// image-logo path (a logo graphic isn't redundant with the eyebrow the
// way repeated text would be).
const heroDisplayTitle = isTurf ? product.title.replace(/^TurfRx\s+/i, '') : product.title

// "Product Support" is ungated — supplemental/supporting materials the
// product's Label/Brochure/SDS (which do go through
// ResourceRequestDialog) aren't meant to cover. Sanity CDN assets force
// a download via ?dl=<filename>; external CDN links get the download
// attribute (honored when same-origin, and a plain open otherwise).
// Rendered as a hover/tap popover rather than an inline list — however
// many files a product accumulates, the sidebar itself never grows;
// only the popover (which floats over the content column, not the
// sidebar) scrolls internally past a point.
const documents = (product.documents ?? []).map((doc) => ({
  ...doc,
  downloadUrl: doc.isUpload
    ? `${doc.url}?dl=${encodeURIComponent(doc.filename ?? doc.title ?? 'download')}`
    : doc.url,
}))
---

<header
  class:list={['hero', { 'hero--turf': isTurf }]}
  data-header-theme="light"
  style={`--product-color: ${color}; --product-accent-color: ${turfAccent};`}
>
  {heroImage ? (
    <>
      <div
        id="hero-lqip"
        class="hero__lqip"
        style={heroImage.lqip ? `background-image: url(${heroImage.lqip})` : undefined}
        aria-hidden="true"
      >
      </div>
      <img
        id="hero-bg"
        class="hero__bg"
        src={heroImage.url}
        alt={product.heroImage?.alt ?? ''}
        loading="eager"
        data-bg-pool={JSON.stringify(bgPool)}
      />
    </>
  ) : (
    <div class="hero__bg hero__bg--gradient" aria-hidden="true"></div>
  )}
  <div class="hero__scrim" aria-hidden="true"></div>
  {isTurf && (
    <>
      <div class="hero__turf-wash" aria-hidden="true"></div>
      <div class="hero__turf-navscrim" aria-hidden="true"></div>
      <div class="hero__turf-stripes turf-stripes" aria-hidden="true"></div>
    </>
  )}
  <script is:inline>
    // Randomize the hero background per load — runs during parse,
    // before first paint. The pick's LQIP placeholder shows blurred
    // and instant; the full image fades in over it once loaded.
    ;(() => {
      const img = document.getElementById('hero-bg')
      if (!img) return
      const pool = JSON.parse(img.dataset.bgPool || '[]')
      if (pool.length > 1) {
        const pick = pool[Math.floor(Math.random() * pool.length)]
        img.src = pick.url
        const lqip = document.getElementById('hero-lqip')
        if (lqip && pick.lqip) lqip.style.backgroundImage = `url(${pick.lqip})`
      }
      const reveal = () => img.classList.add('is-loaded')
      img.complete && img.naturalWidth ? reveal() : img.addEventListener('load', reveal)
    })()
  </script>

  <div class="hero__content">
    <div class="hero__text">
      {isTurf && <p class="hero__brand">TurfRx®</p>}
      <h1 class:list={['hero__title', { 'hero__title--logo': logoUrl }]}>
        {logoUrl ? (
          <img class="hero__logo" src={logoUrl} alt={product.logo?.alt ?? product.title} />
        ) : (
          heroDisplayTitle
        )}
      </h1>
      <hr class="hero__rule" />
      <div class="hero__meta">
        {product.tagline && <p class="hero__tagline">{product.tagline}</p>}
        <nav class="hero__markets" aria-label="Markets">
          {marketLinks.map((m) => (
            <a href={m.href}>{m.label}</a>
          ))}
        </nav>
        <a class:list={['hero__cta', { 'turf-cut': isTurf }]} href="#content">Explore ↓</a>
      </div>
    </div>
  </div>
</header>

<div class="layout" id="content" style={`--product-color: ${color}; --product-accent-color: ${turfAccent};`}>
  <div class="layout__main">
    {product.sections && product.sections.length > 0 && (
      <ProductSections
        sections={product.sections}
        variant={variant}
        productColor={color}
        productAccentColor={accentColor}
        backgrounds={
          product.calloutBackgrounds?.length
            ? product.calloutBackgrounds
            : product.backgrounds
        }
      />
    )}
  </div>

  <aside class:list={['sidebar', { 'sidebar--turf': isTurf }]} aria-label="Product resources">
    <div class:list={['sidebar__inner', { 'turf-cut-bordered': isTurf }]} style={isTurf ? `--turf-cut: var(--turf-cut-sm); --turf-cut-border-color: ${turfAccent};` : undefined}>
      <figure class="sidebar__product">
        {productShotUrl ? (
          <img
            src={productShotUrl}
            alt={product.image?.alt ?? product.title}
            loading="lazy"
          />
        ) : (
          <div class="sidebar__product-ph" aria-hidden="true">
            <span>{product.title}</span>
          </div>
        )}
      </figure>

      <button
        type="button"
        class:list={['sidebar__doc-request', { 'turf-cut': isTurf }]}
        data-dialog-open="resource-request-dialog"
      >
        Product Information Request
      </button>

      {documents.length > 0 && (
        <div class="sidebar__support" data-support>
          <button
            type="button"
            class:list={['sidebar__support-toggle', { 'turf-cut': isTurf }]}
            aria-expanded="false"
            aria-haspopup="true"
            data-support-toggle
          >
            Supporting Materials
            <span class="sidebar__support-count">{documents.length}</span>
          </button>

          {/* Outer element is an invisible hit-area, not the visible
              card — its padding-right bridges the gap to the trigger
              button so the pointer is never over "nothing" while
              crossing from one to the other (that dead zone was
              what caused the hover flicker). The inner div carries
              all the actual visual styling. */}
          <div class="sidebar__support-panel" data-support-panel>
            <div class="sidebar__support-panel-inner">
              <p class="sidebar__support-panel-title">Supporting Materials</p>
              <ul>
                {documents.map((doc) => (
                  <li class="sidebar__doc">
                    <a
                      class="sidebar__doc-view"
                      href={doc.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Open ${doc.title ?? 'document'}`}
                    >
                      {doc.title ?? 'Document'}
                    </a>
                    <a
                      class="sidebar__doc-icon"
                      href={doc.downloadUrl}
                      download={doc.filename ?? true}
                      aria-label={`Download ${doc.title ?? 'document'}`}
                      title="Download"
                    >
                      ↓
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}

      {product.technologies && product.technologies.length > 0 && (
        <section class="sidebar__group">
          <h2>Powered By</h2>
          <ul>
            {product.technologies.map((tech) => (
              <li>
                <a class="sidebar__link" href={`/technologies/${tech.slug}`}>
                  {tech.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {product.crops && product.crops.length > 0 && (
        <section class="sidebar__group">
          <h2>Crops</h2>
          <ul class="sidebar__tags">
            {product.crops.map((crop) => (
              <li>{crop}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="sidebar__group">
        <h2>Markets</h2>
        <ul>
          {marketLinks.map((m) => (
            <li>
              <a class="sidebar__link" href={m.href}>{m.label}</a>
            </li>
          ))}
        </ul>
      </section>

      {relatedCards.length > 0 && (
        <section class="sidebar__group">
          <h2>Pairs Well With</h2>
          <ul>
            {relatedCards.map((p) => (
              <li>
                <a class="sidebar__related" href={`/products/${p.slug}`}>
                  {p.thumb ? (
                    <img src={p.thumb} alt="" width="48" height="48" loading="lazy" />
                  ) : (
                    <span class="sidebar__related-ph" aria-hidden="true"></span>
                  )}
                  <span class="sidebar__related-text">
                    <strong>{p.title}</strong>
                    {p.tagline && <small>{p.tagline}</small>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <a class:list={['sidebar__cta', { 'turf-cut': isTurf }]} href="/contact">
        Talk to an agronomist
      </a>
    </div>
  </aside>
</div>

<ResourceRequestDialog productTitle={product.title} color={color} />

<script>
  // Product Support popover — hover is handled entirely in CSS
  // (`:hover` + `(hover: hover)`, see the stylesheet below); this just
  // handles tap/click, so the panel is reachable on touch devices and
  // can be "pinned" open by clicking on desktop too.
  document.querySelectorAll<HTMLElement>('[data-support]').forEach((wrapper) => {
    const toggle = wrapper.querySelector<HTMLButtonElement>('[data-support-toggle]')
    if (!toggle) return

    const close = () => {
      wrapper.classList.remove('is-open')
      toggle.setAttribute('aria-expanded', 'false')
    }
    const open = () => {
      wrapper.classList.add('is-open')
      toggle.setAttribute('aria-expanded', 'true')
    }

    toggle.addEventListener('click', () => {
      wrapper.classList.contains('is-open') ? close() : open()
    })

    document.addEventListener('click', (e) => {
      if (wrapper.classList.contains('is-open') && !wrapper.contains(e.target as Node)) close()
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })
  })
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    /* Pulled up behind the fixed nav (see Header.astro) so the image
     * extends to the very top of the viewport; min-height grows by the
     * same amount so the visible area below the nav is unchanged.
     * Content here is bottom-anchored, so unlike the home hero variants
     * it needs no extra top padding to clear the nav. */
    margin-top: calc(-1 * var(--header-space));
    min-height: calc(min(85vh, 880px) + var(--header-space));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--color-white);
  }

  /* Blurred LQIP placeholder — instant paint while the image loads */
  .hero__lqip {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(18px);
    transform: scale(1.1); /* hide blur edge bleed */
    background-color: var(--product-color);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero__bg.is-loaded {
    opacity: 1;
  }

  .hero__bg--gradient {
    background:
      radial-gradient(120% 90% at 85% 10%, rgb(255 255 255 / 0.16), transparent 60%),
      radial-gradient(100% 120% at 10% 100%, rgb(0 0 0 / 0.35), transparent 55%),
      var(--product-color);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.18) 0%,
      rgb(0 0 0 / 0.05) 40%,
      rgb(0 0 0 / 0.45) 100%
    );
  }

  /* Width/padding intentionally match .layout below exactly (same
     max-width, same horizontal padding) — was drifting to its own
     wider container (--max-width-2xl + --space-8) instead of the
     page's real content guide (--content-width + --space-6), so the
     hero title/logo sat at a different left edge than everything
     below it. Same bug, same fix already made once for the turf
     concept page; this is the real shared rule both markets render
     through, so fixing it here covers both at once. */
  .hero__content {
    position: relative;
    width: min(var(--content-width), 100%);
    margin: 0 auto;
    padding: var(--space-32) var(--space-6) var(--space-12);
  }

  .hero__text {
    width: 100%;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  /* Stylized wordmark in place of the text title — sized to roughly
   * match the text state's visual weight rather than the font's own
   * intrinsic size (logos vary wildly in aspect ratio/whitespace), and
   * given a soft shadow since an arbitrary uploaded logo can't be
   * guaranteed to have the same built-in contrast against photo
   * imagery that --hero__scrim gives plain white text. */
  .hero__title--logo {
    line-height: 0;
  }

  .hero__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 560px);
    max-height: clamp(4rem, 10vw, 7.5rem);
    filter: drop-shadow(0 4px 18px rgb(0 0 0 / 0.35));
  }

  .hero__rule {
    border: none;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    margin: var(--space-8) 0 var(--space-6);
  }

  .hero__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .hero__tagline {
    max-width: 44ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.9);
  }

  .hero__markets {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
    white-space: nowrap;
    padding-top: var(--space-2);
  }

  .hero__markets a:hover {
    color: var(--color-white);
  }

  .hero__cta {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: var(--space-2);
    border-bottom: 1px solid rgb(255 255 255 / 0.5);
    transition: border-color 0.15s ease;
  }

  .hero__cta:hover {
    border-color: var(--color-white);
  }

  /* ── Layout: sections + floating sidebar ──────────────────────── */
  .layout {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-32) var(--space-6) var(--space-40);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-16);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: calc(var(--space-16) + 60px); /* clear the sticky header */
    /* position: sticky always creates its own stacking context, so
     * z-index values *inside* the sidebar (e.g. the Supporting
     * Materials popover) only ever compete against each other — never
     * against content in the main column, like the callout leaf sprig
     * (z-index: 3), unless the sidebar itself is given a z-index to
     * compete with at the outer level. Without this, the leaf paints
     * over the popover regardless of the popover's own z-index. */
    z-index: var(--z-raised);
  }

  .sidebar__inner {
    background: color-mix(in srgb, var(--product-color) 6%, var(--color-cream));
    border: 1px solid color-mix(in srgb, var(--product-color) 18%, transparent);
    /* Mirrored leaf shape (squared TL/BR, rounded TR/BL) — echoes the
     * callout boxes' asymmetric radius but flipped across the diagonal,
     * since the sidebar sits opposite them in the layout. Scaled down
     * from --radius-leaf-mirror's 40px to the card's own --radius-2xl
     * so it reads as a corner detail, not a dominant shape. */
    border-radius: 0 var(--radius-2xl) 0 var(--radius-2xl);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Product shot — compact, full image, never cropped */
  .sidebar__product {
    display: grid;
    place-items: center;
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
  }

  .sidebar__product img {
    max-width: 100%;
    max-height: 300px;
    width: auto;
    height: auto;
    display: block;
  }

  .sidebar__product-ph {
    width: 100%;
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(110% 90% at 80% 10%, rgb(255 255 255 / 0.14), transparent 60%),
      var(--product-color);
  }

  .sidebar__product-ph span {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-white);
    opacity: 0.85;
  }

  .sidebar__group h2 {
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .sidebar__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
    padding: var(--space-3) var(--space-4);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sidebar__link:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* Doc row: title opens in a new tab, the ↓ button forces download.
   * "Other Resources" is ungated — supplemental materials, not the
   * Label/Brochure/SDS that go through the request dialog. */
  .sidebar__doc {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--bg-raised);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .sidebar__doc:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .sidebar__doc-view {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    color: inherit;
  }

  .sidebar__doc-view:hover {
    text-decoration: underline;
  }

  .sidebar__doc-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: var(--space-2);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--product-color) 14%, var(--bg-raised));
    color: var(--product-color);
    font-size: var(--text-sm);
    transition: background 0.15s ease;
  }

  .sidebar__doc-icon:hover {
    background: color-mix(in srgb, var(--product-color) 28%, var(--bg-raised));
  }

  /* Overflow: rather than growing the sidebar with the upload count
   * (a capped-height scrollbox nested inside an already-sticky sidebar
   * also tends to trap scroll input — you aim for the page, the tiny
   * box eats the wheel event instead), Product Support is a single
   * fixed-height trigger. The actual list lives in a popover that
   * floats over the *content* column, not the sidebar — so however
   * many files a product accumulates, the sidebar's own height never
   * changes; only the popover (internally scrollable past a point)
   * grows. Opens on hover for mouse/trackpad users (`(hover: hover)`
   * — skipped on touch, where hover doesn't really exist) and on
   * tap/click for everyone, via the .is-open class toggled in the
   * inline script below. */
  .sidebar__support {
    position: relative;
  }

  .sidebar__support-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--product-color) 40%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    color: var(--product-color);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .sidebar__support-toggle:hover {
    background: color-mix(in srgb, var(--product-color) 10%, transparent);
  }

  .sidebar__support-count {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 var(--space-1);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--product-color) 18%, var(--bg-raised));
