---
// src/components/products/sections/VideoSection.astro
//
// YouTube/Vimeo embed only — no Sanity file upload (see the schema
// comment in productSections.ts for why). The URL is parsed server-side
// into a plain embed src; unrecognized URLs fall back to using the
// given URL as-is so an already-correct embed link still works.
//
// Turf variant only reskins the heading/frame border/caption — the
// iframe itself is already a black rectangle regardless of market, so
// there's less to change here than the other section types.

import '../../../styles/turf-livery.css'
import { deriveCalloutPalette, ensureReadableOnDark } from '../../../lib/color'
import type { VideoSection } from '../../../lib/types/sanity'
import type { ProductVariant } from '../../../lib/productVariant'

interface Props {
  section: VideoSection
  variant?: ProductVariant
  productColor?: string
  productAccentColor?: string
}

const { section, variant = 'agriculture', productColor, productAccentColor } = Astro.props
const isTurf = variant === 'turf'
const accent = ensureReadableOnDark(deriveCalloutPalette(productColor ?? '#2E6B3E', productAccentColor).complement)

function toEmbedSrc(url: string): string {
  try {
    const u = new URL(url)
    if (u.hostname.includes('youtu')) {
      const id = u.hostname.includes('youtu.be')
        ? u.pathname.slice(1)
        : (u.searchParams.get('v') ?? u.pathname.split('/embed/')[1] ?? '')
      if (id) return `https://www.youtube.com/embed/${id}`
    }
    if (u.hostname.includes('vimeo.com')) {
      const id = u.pathname.split('/').filter(Boolean).pop()
      if (id) return `https://player.vimeo.com/video/${id}`
    }
  } catch {
    // fall through to raw url
  }
  return url
}

const src = toEmbedSrc(section.url)
---

<section
  class:list={['video', { 't-video': isTurf, 'turf-cut-bordered': isTurf }]}
  style={isTurf ? `--t-video-accent: ${accent}; --turf-cut: var(--turf-cut-sm); --turf-cut-border-color: ${accent};` : undefined}
>
  {section.heading && <h2>{section.heading}</h2>}
  <div class:list={['video__frame', { 'turf-cut': isTurf }]} style={isTurf ? `--turf-cut: var(--turf-cut-lg);` : undefined}>
    <iframe
      src={src}
      title={section.heading ?? 'Product video'}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  {section.caption && <p class="video__caption">{section.caption}</p>}
</section>

<style>
  .video h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-black);
    box-shadow: var(--shadow-lg);
  }

  .video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__caption {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* ── Turf variant ─────────────────────────────────────────────── */
  .t-video {
    background: var(--color-text-primary);
    padding: var(--space-8);
  }

  .t-video h2 {
    font-family: var(--turf-font-display);
    font-style: italic;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--t-video-accent);
  }

  .t-video .video__frame {
    border-radius: 0;
  }

  .t-video .video__caption {
    color: rgb(255 255 255 / 0.5);
  }

  @media (max-width: 767px) {
    .t-video {
      padding: var(--space-5);
    }
  }
</style>
