---
// src/components/products/sections/VideoSection.astro
//
// YouTube/Vimeo embed only — no Sanity file upload (see the schema
// comment in productSections.ts for why). The URL is parsed server-side
// into a plain embed src; unrecognized URLs fall back to using the
// given URL as-is so an already-correct embed link still works.

import type { VideoSection } from '../../../lib/types/sanity'

interface Props {
  section: VideoSection
}

const { section } = Astro.props

function toEmbedSrc(url: string): string {
  try {
    const u = new URL(url)
    if (u.hostname.includes('youtu')) {
      const id = u.hostname.includes('youtu.be')
        ? u.pathname.slice(1)
        : (u.searchParams.get('v') ?? u.pathname.split('/embed/')[1] ?? '')
      if (id) return `https://www.youtube.com/embed/${id}`
    }
    if (u.hostname.includes('vimeo.com')) {
      const id = u.pathname.split('/').filter(Boolean).pop()
      if (id) return `https://player.vimeo.com/video/${id}`
    }
  } catch {
    // fall through to raw url
  }
  return url
}

const src = toEmbedSrc(section.url)
---

<section class="video">
  {section.heading && <h2>{section.heading}</h2>}
  <div class="video__frame">
    <iframe
      src={src}
      title={section.heading ?? 'Product video'}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  {section.caption && <p class="video__caption">{section.caption}</p>}
</section>

<style>
  .video h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-black);
    box-shadow: var(--shadow-lg);
  }

  .video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__caption {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
