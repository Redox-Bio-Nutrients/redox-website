---
// src/components/products/sections/CalloutSection.astro
//
// Agriculture: callouts float on randomized imagery from the
// product's background pool (the full Biorg pattern — panels over
// photography). Solid: the image shows through a heavy product-color
// overlay, so it stays on-brand. Tint: frosted-glass panel directly
// over the photo. Both fall back to their gradient looks when no pool
// exists.
//
// Turf: same pool imagery, same overlay idea (a heavy on-brand wash so
// photo texture shows through), but as a diagonal-cut slab with a
// two-tone livery sweep (primary -> accent) instead of the
// leaf-sprig/rounded treatment — see src/styles/turf-livery.css.

import { PortableText } from 'astro-portabletext'
import { urlFor } from '../../../lib/sanity'
import { deriveCalloutPalette } from '../../../lib/color'
import { buildTextureVars } from '../../../lib/texture'
import { onMissingPortableTextComponent, portableTextComponents } from '../../../lib/portableTextComponents'
import '../../../styles/turf-livery.css'
import '../../../styles/texture-surface.css'
import type { CalloutSection, SanityImage } from '../../../lib/types/sanity'
import type { ProductVariant } from '../../../lib/productVariant'
import PoolBackground from '../../ui/PoolBackground.astro'

interface Props {
  section: CalloutSection
  variant?: ProductVariant
  productColor?: string
  /** optional second brand color — see deriveCalloutPalette() in src/lib/color.ts */
  productAccentColor?: string
  backgrounds?: SanityImage[]
  /** Homepage/Technology only (HomeSections.astro passes this; a
   * product page's own callouts never do) — spans the true viewport
   * edge instead of sitting inside the page-builder's normal
   * --content-width column, with bigger heading/body type and a
   * product image that breaks past the box's own top edge. See the
   * `callout--full-bleed` styles below. */
  fullBleed?: boolean
}

const { section, variant = 'agriculture', productColor, productAccentColor, backgrounds, fullBleed = false } =
  Astro.props
// A section-level color override (schema field, optional) wins over
// the inherited product/page color — set on product pages too, not
// just here, but only ever populated when an editor explicitly wants
// this one callout off-brand; otherwise falls through to the same
// productColor prop as before. See sanity/schemas/objects/
// productSections.ts.
const color = section.color ?? productColor ?? 'var(--color-green)'
const accent = section.accentColor ?? productAccentColor
const palette = deriveCalloutPalette(color, accent)
const solid = section.tone !== 'tint'
const hasBody = section.body?.some(
  (b: any) => b.children?.some((c: any) => c.text?.trim()),
)

const pool = (backgrounds ?? []).map((img) => ({
  url: urlFor(img).width(1800).height(900).fit('crop').auto('format').quality(75).url(),
  lqip: img.lqip ?? null,
}))
const hasBg = pool.length > 0

// Homepage/Technology only (see the schema field's own comment) — a
// contained product shot (bottle/label PNG, object-fit: contain, same
// convention ProductCard.astro's own packaging image uses), NOT
// another `backgrounds` pool entry: that pool is wide field/farm
// photography meant to be cropped full-bleed, which mangles a tall
// product photo. Rendered by every variant below, floating over the
// panel rather than behind it.
const productImageUrl = section.backgroundImage
  ? urlFor(section.backgroundImage).width(700).fit('max').auto('format').quality(85).url()
  : null

// Seeded on the section's own _key, not Math.random() — every callout
// gets a genuinely different bloom layout, but the *same* callout
// looks the same on every rebuild rather than reshuffling on redeploy.
// See src/lib/texture.ts (this recipe's original home, before the
// hero headers started reusing it too) for the position-band details.
const textureVars = buildTextureVars(section._key, color, accent)
---

{variant === 'turf' ? (
  <section
    class:list={['t-callout', 'turf-cut', { 't-callout--has-image': productImageUrl, 't-callout--full-bleed': fullBleed }]}
    style={`--turf-cut: var(--turf-cut-lg); --t-callout-primary: ${palette.base}; --t-callout-accent: ${palette.complement};`}
  >
    {hasBg && <PoolBackground pool={pool} />}
    <div class="t-callout__wash" aria-hidden="true"></div>
    {productImageUrl && (
      <img class="t-callout__product-image" src={productImageUrl} alt={section.backgroundImage?.alt ?? ''} loading="lazy" />
    )}
    <div class="t-callout__panel">
      {section.eyebrow && <p class="t-callout__eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2>{section.heading}</h2>}
      {hasBody && (
        <div class="t-callout__body">
          <PortableText
            value={section.body}
            components={portableTextComponents}
            onMissingComponent={onMissingPortableTextComponent}
          />
        </div>
      )}
      {section.cta && (
        <a
          class="t-callout__cta"
          href={section.cta.href}
          target={section.cta.external ? '_blank' : undefined}
          rel={section.cta.external ? 'noopener noreferrer' : undefined}
        >
          {section.cta.label} →
        </a>
      )}
    </div>
  </section>
) : (
  <section
    class:list={[
      'callout',
      solid ? ['callout--solid', 'texture-fill'] : 'callout--tint',
      { 'callout--has-image': productImageUrl, 'callout--full-bleed': fullBleed },
    ]}
    style={textureVars}
  >
    {hasBg ? (
      <PoolBackground pool={pool} />
    ) : (
      !solid && <div class="callout__wash" aria-hidden="true"></div>
    )}
    {hasBg && solid && <div class="callout__overlay texture-wash" aria-hidden="true"></div>}
    {productImageUrl && (
      <img class="callout__product-image" src={productImageUrl} alt={section.backgroundImage?.alt ?? ''} loading="lazy" />
    )}

    <div class:list={['callout__panel', { 'callout__panel--glass': !solid }]}>
      {section.eyebrow && <p class="callout__eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2>{section.heading}</h2>}
      {hasBody && (
        <div class="callout__body">
          <PortableText
            value={section.body}
            components={portableTextComponents}
            onMissingComponent={onMissingPortableTextComponent}
          />
        </div>
      )}
      {section.cta && (
        <a
          class="callout__cta"
          href={section.cta.href}
          target={section.cta.external ? '_blank' : undefined}
          rel={section.cta.external ? 'noopener noreferrer' : undefined}
        >
          {section.cta.label} →
        </a>
      )}
    </div>
  </section>
)}

<style>
  .callout {
    position: relative;
    /* leaf radius: rounded TL/BR, right-angled TR/BL */
    border-radius: var(--radius-leaf);
    /* no overflow clip here — the leaf sprig spills past the border;
     * background layers clip themselves to the radius instead */
  }

  .callout :global(.pool-bg),
  .callout__overlay,
  .callout__wash {
    border-radius: inherit;
    overflow: hidden;
  }

  /* ── Leaf sprig — permanent fixture at the top-right corner ──── */
  .callout::before,
  .callout::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    z-index: 3; /* overlays the box, panel, and text */
    /* pointed corners at top-right/bottom-left so the tip actually
     * meets the pivot (top-right); TL/BR stay rounded (the oval belly) */
    border-radius: 100% 0 100% 0;
    transform-origin: 100% 0;
    pointer-events: none;
  }

  .callout::before {
    width: clamp(80px, 12%, 150px);
    aspect-ratio: 1 / 2.1;
    background: linear-gradient(160deg, var(--color-green-light), var(--color-green-dark));
    opacity: 0.92;
    transform: rotate(8deg);
  }

  .callout::after {
    width: clamp(52px, 8%, 100px);
    aspect-ratio: 1 / 2.1;
    background: linear-gradient(160deg, var(--color-green-pale), var(--color-green));
    opacity: 0.65;
    transform: rotate(-32deg);
  }

  /* ── Product image (Homepage/Technology only) ──────────────────
   * A contained product shot, not another background layer — same
   * object-fit: contain convention as ProductCard.astro's own
   * packaging image ("whole product visible, floating on the
   * field"). Sits above the background/overlay/wash but below the
   * leaf sprig (z-index 3), so the sprig still reads as the
   * permanent top-right fixture it is everywhere else. */
  .callout__product-image {
    position: absolute;
    z-index: 2;
    right: clamp(var(--space-4), 5%, var(--space-10));
    top: 50%;
    transform: translateY(-50%);
    /* Not a percentage height — .callout's own height is auto (its
     * content sets it), so a percentage here would resolve to auto
     * too. max-height alone, with width left auto, sizes correctly
     * regardless (see the turf variant's own copy of this note). */
    max-height: 280px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 16px 28px rgb(0 0 0 / 0.25));
    pointer-events: none;
  }


  /* ── Solid ──────────────────────────────────────────────────── */
  /* Background itself (grain + hue-shifted blooms + diagonal sweep,
   * seeded per-section) comes from the shared .texture-fill class
   * (src/styles/texture-surface.css) driven by the --texture-* vars
   * buildTextureVars() computes in the frontmatter — this file just
   * adds the leaf-sprig-specific color/spacing on top. See
   * texture-surface.css for the "why a texture, not a flat fill" —
   * this reasoning used to live here before the hero headers started
   * reusing the same recipe. */
  .callout--solid {
    color: var(--color-white);
  }

  /* Product-color wash over the imagery — brand color carries, photo
   * texture shows through. Same .texture-wash background as
   * .callout--solid's .texture-fill above (this is the layer actually
   * visible whenever a product has *any* background imagery — its
   * own, a callout-specific pool, or the site-wide fallback — which
   * in practice is most of the time, so the flat-color
   * .callout--solid background is more the exception than the rule). */
  .callout__overlay {
    position: absolute;
    inset: 0;
  }

  .callout--solid .callout__panel {
    /* extra right padding keeps content clear of the corner sprig */
    padding: var(--space-16) clamp(99px, 16.2%, 180px) var(--space-16) var(--space-12);
  }

  .callout--solid h2 {
    color: var(--color-white);
  }

  /* ── Tint (frosted) ─────────────────────────────────────────── */
  .callout--tint {
    padding: var(--space-8);
  }

  .callout__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 20% 15%, color-mix(in srgb, var(--texture-color) 45%, transparent), transparent 65%),
      radial-gradient(60% 80% at 85% 85%, color-mix(in srgb, var(--texture-color) 30%, transparent), transparent 60%),
      color-mix(in srgb, var(--texture-color) 10%, var(--color-cream));
  }

  .callout__panel--glass {
    background: var(--callout-glass-bg, var(--glass-bg));
    backdrop-filter: var(--callout-glass-blur, var(--glass-blur));
    -webkit-backdrop-filter: var(--callout-glass-blur, var(--glass-blur));
    border: var(--glass-border);
    border-radius: var(--radius-2xl);
    /* extra right padding keeps content clear of the corner sprig */
    padding: var(--space-12) clamp(99px, 16.2%, 180px) var(--space-12) var(--space-10);
    box-shadow: var(--shadow-xl);
  }

  /* Light theme only: over a dark background photo, the shared
   * --glass-bg (55% white, no boost) reads dull/gray — the photo's
   * darkness dominates through the blur. Brighter + a light-lifting
   * backdrop filter here, scoped to this panel so the header/hero/
   * card glass (same shared tokens) stays untouched. Dark theme
   * already contrasts fine against its own imagery, so it keeps the
   * shared --glass-bg as-is. */
  :global(html:not([data-theme='dark'])) .callout__panel--glass {
    --callout-glass-bg: rgb(255 255 255 / 0.78);
    --callout-glass-blur: blur(24px) saturate(140%) brightness(1.15);
  }

  .callout--tint h2 {
    color: var(--color-text-primary);
  }

  /* Extra room for the floating product image — padding-right only
   * (not the shorthand) so this doesn't clobber the solid/glass
   * panel rules' own top/bottom/left padding above; placed after both
   * of those so this override wins (equal specificity, source order
   * decides). Desktop only — mobile restacks the image above the
   * panel instead (see the max-width query below), so the panel goes
   * back to its normal sprig-only clearance there. */
  @media (min-width: 768px) {
    .callout--has-image .callout__panel {
      padding-right: clamp(160px, 26%, 300px);
    }
  }

  /* ── Shared ─────────────────────────────────────────────────── */
  .callout__panel {
    position: relative; /* above imagery/overlay layers */
  }

  .callout__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .callout--solid .callout__eyebrow {
    color: var(--color-white);
    opacity: 0.85;
  }

  /* --texture-color is always set (both tones — see textureVars in
   * the frontmatter), so this reads as the callout's own brand color
   * rather than the fixed green every other eyebrow on the site uses. */
  .callout--tint .callout__eyebrow {
    color: var(--texture-color);
  }

  .callout__cta {
    display: inline-block;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border-bottom: 1px solid currentColor;
  }

  .callout--solid .callout__cta {
    color: var(--color-white);
  }

  .callout--tint .callout__cta {
    color: var(--color-text-primary);
  }

  .callout h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .callout__body {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  .callout__body :global(p) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .callout--tint .callout__body :global(p) {
    color: var(--color-text-secondary);
  }

  .callout__body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ── Full bleed (Homepage/Technology only) ─────────────────────
   * HomeSections.astro skips its usual max-width wrapper for this
   * section, so the box is already the true viewport width — this
   * just squares off the leaf radius to match every other full-bleed
   * homepage section (Hero, Carousel, CtaSection) instead of the
   * small-card rounded corner, gives the panel the same left-edge
   * clearance as those sections' own content (so the heading still
   * lines up with the page's normal --content-width column instead
   * of hugging the true viewport edge), and bumps the type up now
   * that there's a full viewport of room for it. */
  .callout--full-bleed {
    border-radius: 0;
  }

  .callout--full-bleed .callout__panel {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    padding-left: max(var(--space-6), calc((100vw - var(--content-width)) / 2));
  }

  .callout--full-bleed h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
  }

  .callout--full-bleed .callout__body {
    font-size: var(--text-xl);
  }

  /* Product image breaks the top edge of the box — sized taller than
   * the box itself and anchored to the bottom (not vertically
   * centered like the default .callout__product-image above) so the
   * extra height overflows upward past the box's own top:0 rather
   * than downward past its bottom. .callout has no overflow clip of
   * its own (see its own comment above) so this is free to spill.
   * A fixed max-height, not a percentage — .callout's own height is
   * auto (its content sets it), so a percentage would resolve to
   * auto too (same reasoning as the default .callout__product-image
   * rule above), and a taller-than-the-box image is the entire point
   * here. Desktop only — this selector's higher specificity would
   * otherwise beat the mobile stacking block's own (single-class)
   * max-height below regardless of source order, blowing the image
   * back up past the small stacked size that block sets. */
  @media (min-width: 768px) {
    .callout--full-bleed .callout__product-image {
      top: auto;
      bottom: 0;
      transform: none;
      max-height: 420px;
    }
  }

  @media (max-width: 767px) {
    .callout--solid .callout__panel {
      padding: var(--space-10) 86px var(--space-10) var(--space-6);
    }

    .callout--tint {
      padding: var(--space-4);
    }

    .callout__panel--glass {
      padding: var(--space-8) 86px var(--space-8) var(--space-6);
    }

    /* No room to float the image beside the text once the panel's
     * this narrow — stack it above instead, sprig clearance on the
     * panel unchanged since the sprig is unrelated to the image. */
    .callout--has-image {
      display: flex;
      flex-direction: column;
    }

    .callout__product-image {
      position: static;
      order: -1;
      height: auto;
      max-height: 160px;
      max-width: 60%;
      margin: var(--space-6) auto 0;
      transform: none;
    }
  }

  /* ── Turf variant ─────────────────────────────────────────────── */
  .t-callout {
    position: relative;
    min-height: 220px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    overflow: hidden;
    padding: var(--space-8) var(--space-10);
  }

  /* Homepage/Technology only — same contained-product-shot convention
   * as the agriculture variant's .callout__product-image above, but a
   * plain flex item here (not absolutely positioned) since .t-callout
   * is already a flex row: `order` alone pushes it after the panel
   * without needing manual positioning math. */
  .t-callout__product-image {
    position: relative;
    z-index: 1;
    order: 2;
    flex-shrink: 0;
    margin-left: auto;
    /* Not a percentage height (or a min()/clamp() mixing one in) —
     * .t-callout's own height is auto (min-height only sets a floor),
     * so a percentage here resolves to auto too and the image renders
     * at its full intrinsic size instead. max-height alone, with
     * width left auto, sizes correctly regardless. */
    max-height: 180px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgb(0 0 0 / 0.3));
  }

  @media (max-width: 767px) {
    .t-callout--has-image {
      flex-direction: column;
      align-items: flex-start;
    }

    .t-callout__product-image {
      order: -1;
      margin-left: 0;
      height: auto;
      max-height: 140px;
      max-width: 55%;
    }
  }

  .t-callout :global(.pool-bg) {
    position: absolute;
    inset: 0;
  }

  .t-callout__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--t-callout-accent) 85%, transparent) 0%,
      color-mix(in srgb, var(--t-callout-primary) 82%, transparent) 100%
    );
  }

  .t-callout__panel {
    position: relative;
    max-width: 60ch;
  }

  .t-callout__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.85;
    margin-bottom: var(--space-2);
  }

  .t-callout h2 {
    font-family: var(--turf-font-display);
    font-style: italic;
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--color-white);
  }

  .t-callout__body {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.92);
  }

  .t-callout__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .t-callout__cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-white);
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 767px) {
    .t-callout {
      padding: var(--space-6);
    }
  }
</style>
