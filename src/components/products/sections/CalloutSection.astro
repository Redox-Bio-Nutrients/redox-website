---
// src/components/products/sections/CalloutSection.astro
//
// Callouts float on randomized imagery from the product's background
// pool (the full Biorg pattern — panels over photography). Solid: the
// image shows through a heavy product-color overlay, so it stays
// on-brand. Tint: frosted-glass panel directly over the photo. Both
// fall back to their gradient looks when no pool exists.

import { PortableText } from 'astro-portabletext'
import { urlFor } from '../../../lib/sanity'
import type { CalloutSection, SanityImage } from '../../../lib/types/sanity'
import PoolBackground from '../../ui/PoolBackground.astro'

interface Props {
  section: CalloutSection
  productColor?: string
  backgrounds?: SanityImage[]
}

const { section, productColor, backgrounds } = Astro.props
const color = productColor ?? 'var(--color-green)'
const solid = section.tone !== 'tint'
const hasBody = section.body?.some(
  (b: any) => b.children?.some((c: any) => c.text?.trim()),
)

const pool = (backgrounds ?? []).map((img) => ({
  url: urlFor(img).width(1800).height(900).fit('crop').auto('format').quality(75).url(),
  lqip: img.lqip ?? null,
}))
const hasBg = pool.length > 0
---

<section
  class:list={['callout', solid ? 'callout--solid' : 'callout--tint']}
  style={`--callout-color: ${color}`}
>
  {hasBg ? (
    <PoolBackground pool={pool} />
  ) : (
    !solid && <div class="callout__wash" aria-hidden="true"></div>
  )}
  {hasBg && solid && <div class="callout__overlay" aria-hidden="true"></div>}

  <div class:list={['callout__panel', { 'callout__panel--glass': !solid }]}>
    {section.heading && <h2>{section.heading}</h2>}
    {hasBody && (
      <div class="callout__body">
        <PortableText value={section.body} />
      </div>
    )}
  </div>
</section>

<style>
  .callout {
    position: relative;
    border-radius: var(--radius-3xl);
    overflow: hidden;
  }

  /* ── Solid ──────────────────────────────────────────────────── */
  .callout--solid {
    background:
      radial-gradient(120% 140% at 90% 0%, rgb(255 255 255 / 0.14), transparent 55%),
      radial-gradient(90% 120% at 0% 100%, rgb(0 0 0 / 0.22), transparent 60%),
      var(--callout-color);
    color: var(--color-white);
  }

  /* Product-color wash over the imagery — brand color carries, photo
   * texture shows through */
  .callout__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--callout-color) 90%, transparent) 0%,
      color-mix(in srgb, var(--callout-color) 72%, transparent) 100%
    );
  }

  .callout--solid .callout__panel {
    padding: var(--space-16) var(--space-12);
  }

  .callout--solid h2 {
    color: var(--color-white);
  }

  /* ── Tint (frosted) ─────────────────────────────────────────── */
  .callout--tint {
    padding: var(--space-8);
  }

  .callout__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 20% 15%, color-mix(in srgb, var(--callout-color) 45%, transparent), transparent 65%),
      radial-gradient(60% 80% at 85% 85%, color-mix(in srgb, var(--callout-color) 30%, transparent), transparent 60%),
      color-mix(in srgb, var(--callout-color) 10%, var(--color-cream));
  }

  .callout__panel--glass {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-12) var(--space-10);
    box-shadow: var(--shadow-xl);
  }

  .callout--tint h2 {
    color: var(--color-text-primary);
  }

  /* ── Shared ─────────────────────────────────────────────────── */
  .callout__panel {
    position: relative; /* above imagery/overlay layers */
  }

  .callout h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .callout__body {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  .callout__body :global(p) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .callout--tint .callout__body :global(p) {
    color: var(--color-text-secondary);
  }

  .callout__body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .callout--solid .callout__panel {
      padding: var(--space-10) var(--space-6);
    }

    .callout--tint {
      padding: var(--space-4);
    }

    .callout__panel--glass {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
