---
// src/components/products/sections/ProductSystemSection.astro
//
// A shared "system" comparison (first use: the RDX Nitrogen System —
// RDX-N vs. RDX-Flex) rendered identically on every member product's
// page. Copy comes from the referenced productSystem doc; each card
// paints in its own product's colors (same .texture-fill surface the
// solid callouts use) so the two products read as distinct at a
// glance, joined by a chevron that says "start here, then this."
// The page's own product gets a "You're here" tag instead of a link.
//
// Agriculture styling only — no turf product is in a system yet.

import { PortableText } from 'astro-portabletext'
import { urlFor } from '../../../lib/sanity'
import { buildTextureVars } from '../../../lib/texture'
import { onMissingPortableTextComponent, portableTextComponents } from '../../../lib/portableTextComponents'
import '../../../styles/texture-surface.css'
import type { ProductSystemSection } from '../../../lib/types/sanity'

interface Props {
  section: ProductSystemSection
  currentProductId?: string
}

const { section, currentProductId } = Astro.props
const system = section.system
const members = (system?.members ?? []).filter((m) => m.product)

// Drafts and published share a product, so compare without the prefix
// (the preview route renders the draft's _id).
const bareId = (id?: string) => id?.replace(/^drafts\./, '')
const isCurrent = (id: string) => bareId(id) === bareId(currentProductId)

const hasBlocks = (blocks?: any[]) => blocks?.some((b) => b.children?.some((c: any) => c.text?.trim()))
---

{system && members.length > 0 && (
  <section class="psys" id={system.anchor} aria-labelledby={`psys-${section._key}`}>
    <header class="psys__head">
      <p class="psys__eyebrow">{system.title}</p>
      <h2 id={`psys-${section._key}`}>{system.heading ?? system.title}</h2>
      {hasBlocks(system.intro) && (
        <div class="psys__intro">
          <PortableText value={system.intro!} components={portableTextComponents} onMissingComponent={onMissingPortableTextComponent} />
        </div>
      )}
    </header>

    {(system.compareHeading || system.compareIntro) && (
      <div class="psys__compare">
        {system.compareHeading && <h3>{system.compareHeading}</h3>}
        {system.compareIntro && <p>{system.compareIntro}</p>}
      </div>
    )}

    <ol class="psys__cards" style={`--psys-count: ${members.length}`}>
      {members.map((m, i) => {
        const p = m.product!
        const color = p.primaryColor ?? '#3A7D50'
        const current = isCurrent(p._id)
        const img = p.image?.asset
          ? urlFor(p.image).width(240).fit('max').auto('format').quality(85).url()
          : null
        return (
          <li
            class:list={['psys__card', 'texture-fill', { 'psys__card--current': current, 'psys__card--mirror': i % 2 === 1 }]}
            style={buildTextureVars(m._key, color, p.accentColor)}
          >
            <div class="psys__scrim" aria-hidden="true"></div>
            {i > 0 && <span class="psys__chevron" aria-hidden="true"></span>}
            <div class="psys__card-inner">
              <div class="psys__card-top">
                <div class="psys__card-titles">
                  <p class="psys__step">
                    <span>Step {i + 1}</span>
                    {current && <span class="psys__here">You’re here</span>}
                  </p>
                  <h3>
                    {p.title}
                    {m.analysis && <span class="psys__analysis">{m.analysis}</span>}
                  </h3>
                  {m.headline && <p class="psys__headline">{m.headline}</p>}
                </div>
                {img && <img class="psys__img" src={img} alt="" loading="lazy" />}
              </div>

              {m.specs && m.specs.length > 0 && (
                <dl class="psys__specs">
                  {m.specs.map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {m.summary && <p class="psys__summary">{m.summary}</p>}

              {m.notes?.map((n) => (
                <p class="psys__note">
                  <strong>{n.label}</strong>
                  {n.text}
                </p>
              ))}

              {!current && (
                <a class="psys__cta" href={`/products/${p.slug}`}>
                  Explore {p.title} →
                </a>
              )}
            </div>
          </li>
        )
      })}
    </ol>

    {(system.closingHeading || hasBlocks(system.closingBody)) && (
      <aside class="psys__closing">
        {system.closingHeading && <h3>{system.closingHeading}</h3>}
        {hasBlocks(system.closingBody) && (
          <div class="psys__closing-body">
            <PortableText value={system.closingBody!} components={portableTextComponents} onMissingComponent={onMissingPortableTextComponent} />
          </div>
        )}
        {system.closingFootnote && <p class="psys__footnote">{system.closingFootnote}</p>}
        {system.closingTakeaway && <p class="psys__takeaway">{system.closingTakeaway}</p>}
      </aside>
    )}
  </section>
)}

<style>
  .psys {
    scroll-margin-top: 100px; /* clears the sticky header on #anchor links */
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .psys__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--product-color, var(--color-green));
    margin-bottom: var(--space-3);
  }

  .psys h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    max-width: 20ch;
  }

  .psys__intro {
    margin-top: var(--space-6);
    max-width: 68ch;
    font-size: var(--text-lg);
  }

  .psys__intro :global(p),
  .psys__compare p {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .psys__intro :global(p:last-child),
  .psys__compare p:last-child {
    margin-bottom: 0;
  }

  .psys__compare h3,
  .psys__closing h3 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .psys__compare p {
    max-width: 68ch;
    font-size: var(--text-lg);
  }

  /* ── Cards ──────────────────────────────────────────────────── */
  .psys__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--psys-count), minmax(0, 1fr));
    gap: var(--space-6);
  }

  .psys__card {
    position: relative;
    color: var(--color-white);
    border-radius: var(--radius-leaf);
  }

  .psys__card--mirror {
    border-radius: var(--radius-leaf-mirror);
  }

  /* Darkens the lighter product colors (RDX-N's olive) enough for
   * white body copy, heavier toward the bottom where the text is. */
  .psys__scrim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.24) 0%, rgb(0 0 0 / 0.38) 100%);
  }

  .psys__card-inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-10);
  }

  /* "Then this" — sits on the seam between two cards. */
  .psys__chevron {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: calc(var(--space-6) / -2);
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bg-raised, var(--color-white));
    box-shadow: var(--shadow-lg);
  }

  .psys__chevron::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 10px;
    height: 10px;
    border-top: 2.5px solid var(--color-text-primary);
    border-right: 2.5px solid var(--color-text-primary);
    transform: translateX(-2px) rotate(45deg);
  }

  .psys__card-top {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .psys__card-titles {
    flex: 1;
    min-width: 0;
  }

  .psys__step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semi);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: var(--space-2);
  }

  .psys__here {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full, 999px);
    background: rgb(255 255 255 / 0.22);
    border: 1px solid rgb(255 255 255 / 0.35);
    letter-spacing: 0.06em;
  }

  .psys__card h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-3xl);
    line-height: 1.1;
    color: var(--color-white);
  }

  .psys__analysis {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    font-variant-numeric: tabular-nums;
    padding: 2px var(--space-3);
    border-radius: var(--radius-full, 999px);
    background: rgb(0 0 0 / 0.22);
  }

  .psys__headline {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--font-semi);
  }

  .psys__img {
    flex-shrink: 0;
    width: auto;
    max-height: 96px;
    max-width: 30%;
    object-fit: contain;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.3));
  }

  .psys__specs {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }

  .psys__specs > div {
    display: grid;
    grid-template-columns: minmax(7.5rem, 34%) 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
  }

  .psys__specs dt {
    font-size: var(--text-xs);
    font-weight: var(--font-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
    padding-top: 0.2em;
  }

  .psys__specs dd {
    margin: 0;
    font-weight: var(--font-medium);
    line-height: var(--leading-snug, 1.4);
  }

  .psys__summary,
  .psys__note {
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.94);
  }

  .psys__note strong {
    display: block;
    font-weight: var(--font-semi);
    color: var(--color-white);
    margin-bottom: var(--space-1);
  }

  .psys__cta {
    margin-top: auto;
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-white);
    border-bottom: 1px solid currentColor;
  }

  /* ── Closing ────────────────────────────────────────────────── */
  .psys__closing {
    position: relative;
    background: color-mix(in srgb, var(--product-color, var(--color-green)) 7%, var(--color-cream));
    border: 1px solid color-mix(in srgb, var(--product-color, var(--color-green)) 20%, transparent);
    /* Square top corners so it reads as continuing from the cards above. */
    border-radius: 0 0 var(--radius-3xl) var(--radius-3xl);
    padding: var(--space-12);
  }

  .psys__closing-body {
    max-width: 72ch;
  }

  .psys__closing-body :global(p) {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .psys__footnote {
    max-width: 72ch;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-4);
    border-left: 2px solid color-mix(in srgb, var(--product-color, var(--color-green)) 45%, transparent);
  }

  .psys__takeaway {
    margin-top: var(--space-6);
    max-width: 60ch;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug, 1.4);
    color: var(--color-text-primary);
  }

  @media (max-width: 899px) {
    .psys__cards {
      grid-template-columns: 1fr;
    }

    /* Chevron moves to the top seam and points down. */
    .psys__chevron {
      top: calc(var(--space-6) / -2);
      left: 50%;
    }

    .psys__chevron::after {
      transform: translateY(-2px) rotate(135deg);
    }
  }

  @media (max-width: 767px) {
    .psys {
      gap: var(--space-8);
    }

    .psys__card-inner {
      padding: var(--space-8) var(--space-6);
    }

    .psys__closing {
      padding: var(--space-8) var(--space-6);
    }

    .psys__specs > div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
