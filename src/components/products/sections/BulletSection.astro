---
// src/components/products/sections/BulletSection.astro
//
// Points render as soft rounded tiles in a 1–3 column grid; the
// bullet dot picks up the product color via --product-color.

import type { BulletSection } from '../../../lib/types/sanity'

interface Props {
  section: BulletSection
}

const { section } = Astro.props
const columns = section.columns ?? 1
---

<section class="bullets">
  {section.heading && <h2>{section.heading}</h2>}
  <ul class="bullets__list" style={`--columns: ${columns}`}>
    {section.items.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .bullets h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-10);
  }

  .bullets__list {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--space-4);
    list-style: none;
  }

  .bullets__list li {
    position: relative;
    display: flex;
    align-items: center; /* text block vertically centered in the tile */
    min-height: 100%;
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-12);
    background: var(--color-cream);
    border-radius: var(--radius-2xl);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  /* Dot centered on the tile, not the first text line */
  .bullets__list li::before {
    content: '';
    position: absolute;
    left: var(--space-6);
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--product-color, var(--color-green));
    transform: translateY(-50%);
  }

  @media (max-width: 767px) {
    .bullets h2 {
      margin-bottom: var(--space-6);
    }

    .bullets__list {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
