---
// src/components/products/sections/WarningSection.astro
//
// Fixed alert styling (--color-warning in src/styles/tokens.css) —
// deliberately NOT derived from the product's own primaryColor, unlike
// CalloutSection. A caution box needs to read the same way on every
// product regardless of that product's brand hue. Optional numbered
// `steps` render as a plain <ol> below the message — for things like
// mixing/handling instructions.

import { PortableText } from 'astro-portabletext'
import type { WarningSection } from '../../../lib/types/sanity'

interface Props {
  section: WarningSection
}

const { section } = Astro.props
---

<section class="warning">
  <div class="warning__icon" aria-hidden="true">!</div>
  <div class="warning__body">
    {section.heading && <h2>{section.heading}</h2>}
    <div class="warning__message">
      <PortableText value={section.message} />
    </div>
    {section.steps && section.steps.length > 0 && (
      <ol class="warning__steps">
        {section.steps.map((step) => <li>{step}</li>)}
      </ol>
    )}
  </div>
</section>

<style>
  .warning {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    background: color-mix(in srgb, var(--color-warning) 8%, var(--bg-raised));
    border: var(--border-base) solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .warning__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-warning);
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .warning h2 {
    font-family: var(--font-sans);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    color: var(--color-warning);
    margin-bottom: var(--space-2);
  }

  .warning__message :global(p) {
    color: var(--color-text-primary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
  }

  .warning__message :global(p:last-child) {
    margin-bottom: 0;
  }

  .warning__steps {
    margin-top: var(--space-4);
    padding-left: 1.25em;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .warning__steps li {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .warning__steps li::marker {
    color: var(--color-warning);
    font-weight: var(--font-semi);
  }

  @media (max-width: 767px) {
    .warning {
      flex-direction: column;
      padding: var(--space-6);
    }
  }
</style>
