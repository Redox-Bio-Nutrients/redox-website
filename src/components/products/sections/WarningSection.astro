---
// src/components/products/sections/WarningSection.astro
//
// Fixed alert styling (--color-warning in src/styles/tokens.css) —
// deliberately NOT derived from the product's own primaryColor, unlike
// CalloutSection. A caution box needs to read the same way on every
// product regardless of that product's brand hue — **this stays true
// for the Turf variant too**: only the shape changes (diagonal cut,
// same dark-slab convention as the other turf sections), the color
// itself is still the fixed --color-warning either way. Optional
// numbered `steps` render as a plain <ol> below the message — for
// things like mixing/handling instructions.

import { PortableText } from 'astro-portabletext'
import { onMissingPortableTextComponent, portableTextComponents } from '../../../lib/portableTextComponents'
import '../../../styles/turf-livery.css'
import type { WarningSection } from '../../../lib/types/sanity'
import type { ProductVariant } from '../../../lib/productVariant'

interface Props {
  section: WarningSection
  variant?: ProductVariant
}

const { section, variant = 'agriculture' } = Astro.props
const isTurf = variant === 'turf'
---

<section
  class:list={['warning', { 't-warning': isTurf, 'turf-cut-bordered': isTurf }]}
  style={isTurf ? `--turf-cut: var(--turf-cut-sm); --turf-cut-border-color: var(--color-warning);` : undefined}
>
  <div class="warning__icon" aria-hidden="true">!</div>
  <div class="warning__body">
    {section.heading && <h2>{section.heading}</h2>}
    <div class="warning__message">
      <PortableText
        value={section.message}
        components={portableTextComponents}
        onMissingComponent={onMissingPortableTextComponent}
      />
    </div>
    {section.steps && section.steps.length > 0 && (
      <ol class="warning__steps">
        {section.steps.map((step) => <li>{step}</li>)}
      </ol>
    )}
  </div>
</section>

<style>
  .warning {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    background: color-mix(in srgb, var(--color-warning) 8%, var(--bg-raised));
    border: var(--border-base) solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .warning__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-warning);
    color: var(--color-white);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .warning h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-warning);
    margin-bottom: var(--space-4);
  }

  .warning__message :global(p) {
    color: var(--color-text-primary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
  }

  .warning__message :global(p:last-child) {
    margin-bottom: 0;
  }

  .warning__steps {
    margin-top: var(--space-4);
    padding-left: 1.25em;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .warning__steps li {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .warning__steps li::marker {
    color: var(--color-warning);
    font-weight: var(--font-semi);
  }

  @media (max-width: 767px) {
    .warning {
      flex-direction: column;
      padding: var(--space-6);
    }
  }

  /* ── Turf variant ─────────────────────────────────────────────── */
  .t-warning {
    background: color-mix(in srgb, var(--color-warning) 14%, var(--turf-ink));
    border-radius: 0;
  }

  .t-warning h2 {
    font-family: var(--turf-font-display);
    font-style: italic;
    font-weight: 700;
    letter-spacing: normal;
  }

  .t-warning .warning__message :global(p) {
    color: rgb(255 255 255 / 0.88);
  }

  .t-warning .warning__steps li {
    color: rgb(255 255 255 / 0.75);
  }
</style>
