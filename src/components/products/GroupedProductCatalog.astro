---
// src/components/products/GroupedProductCatalog.astro
//
// WHY: Catalog listing pages (Agriculture, Turf) group products by
// their Collection (sanity/schemas/documents/collection.ts) instead of
// one flat grid — the printed catalog's own benefit-taxonomy, now
// modeled as content rather than a hardcoded enum. Deliberately no
// tabs/sub-nav: every group renders on the same page, in the catalog's
// own category order (not alphabetized — only products *within* a
// group are alphabetical), with same-page category navigation (a side
// rail on desktop, a sticky picker on phones — see the markup below) so
// a long page stays navigable without hiding any content behind a click. Chosen over flat-grid and color-washed-band alternatives —
// see chat/design history for the other two explored directions.
//
// A product with no Collection (or a Collection outside the known
// catalog taxonomy) still renders, grouped into a trailing "More
// Products" bucket — new products never silently disappear just for
// missing a tag.

import type { ProductCard as ProductCardType, Collection } from '../../lib/types/sanity'
import ProductCard from './ProductCard.astro'
import { urlFor } from '../../lib/sanity'
import { CATEGORY_ORDER } from '../../lib/catalogTaxonomy'
import SectionNav, { type SectionNavItem } from '../ui/SectionNav.astro'

interface Props {
  products: ProductCardType[]
  emptyMessage?: string
}

const { products, emptyMessage = 'Products coming soon.' } = Astro.props

interface Group {
  collection: Collection | null
  products: ProductCardType[]
}

const groupMap = new Map<string, Group>()
for (const product of products) {
  const collection = product.collections?.[0] ?? null
  const mapKey = collection?._id ?? '__uncategorized__'
  if (!groupMap.has(mapKey)) groupMap.set(mapKey, { collection, products: [] })
  groupMap.get(mapKey)!.products.push(product)
}
for (const group of groupMap.values()) {
  group.products.sort((a, b) => a.title.localeCompare(b.title))
}
const groups = Array.from(groupMap.values()).sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a.collection?.title ?? '')
  const bi = CATEGORY_ORDER.indexOf(b.collection?.title ?? '')
  return (ai === -1 ? CATEGORY_ORDER.length : ai) - (bi === -1 ? CATEGORY_ORDER.length : bi)
})

const groupId = (group: Group) => group.collection?.slug ?? 'more-products'
const hasNav = groups.length > 1
const navItems: SectionNavItem[] = groups.map((group) => ({
  id: groupId(group),
  label: group.collection?.title ?? 'More Products',
  count: group.products.length,
  color: group.collection?.color,
}))
---

{products.length > 0 ? (
  <div class:list={['catalog', { 'catalog--with-nav': hasNav }]}>
    {hasNav && (
      <SectionNav items={navItems} label="Product categories" title="Categories" countNoun="products" />
    )}
    <div class="catalog__groups">
    {groups.map((group) => {
      // A lone "More Products" bucket (no real Collection exists for
      // any product on the page) is the whole page, not a category
      // within it — the eyebrow/rule exist to label one group among
      // several, so they're just noise here. Once real Collections
      // exist (or there's more than one group), the header earns its
      // place back automatically.
      const showHeader = group.collection !== null || groups.length > 1
      return (
        <section class="catalog__group" id={groupId(group)} tabindex="-1">
          {showHeader && (
            <div
              class="catalog__group-head"
              style={group.collection?.color ? `--group-color: ${group.collection.color}` : undefined}
            >
              <div class="catalog__group-head-row">
                {group.collection?.icon && (
                  <img
                    class="catalog__icon"
                    src={urlFor(group.collection.icon).width(96).fit('max').url()}
                    alt={group.collection.icon.alt ?? ''}
                    width="40"
                    height="40"
                  />
                )}
                <div class="catalog__group-head-text">
                  <span class="catalog__eyebrow">{group.collection?.title ?? 'More Products'}</span>
                  {group.collection?.description && <p class="catalog__desc">{group.collection.description}</p>}
                </div>
              </div>
              <hr class="catalog__rule" />
            </div>
          )}
          <div class="catalog__grid">
            {group.products.map((product) => (
              <ProductCard product={product} accentColor={group.collection?.color} />
            ))}
          </div>
        </section>
      )
    })}
    </div>
  </div>
) : (
  <p class="catalog__empty">{emptyMessage}</p>
)}

<style>
  /* ── Layout: side rail (desktop) / sticky picker (phones+tablets) ── */
  .catalog--with-nav {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 1023px) {
    .catalog--with-nav {
      display: block;
    }
  }

  .catalog__group {
    margin-bottom: var(--space-16);
    /* No-JS / direct-hash fallback only — clicks go through
     * SectionNav's script, which measures the real offset at click time. */
    scroll-margin-top: calc(var(--header-space) + var(--space-8));
  }

  .catalog__group:focus {
    outline: none;
  }

  @media (max-width: 1023px) {
    .catalog__group {
      scroll-margin-top: calc(var(--header-space) + 88px);
    }
  }

  .catalog__group:last-child {
    margin-bottom: 0;
  }

  .catalog__group-head {
    margin-bottom: var(--space-8);
  }

  .catalog__group-head-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .catalog__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .catalog__group-head-text {
    min-width: 0;
  }

  .catalog__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--group-color, var(--color-green-dark));
    /* Same legibility clamp as .btn--ghost (buttons.css) — collection
     * colors like gold/blue are too light as small text on white. */
    color: oklch(from var(--group-color, var(--color-green-dark)) min(l, 0.5) c h);
  }

  :global([data-theme='dark']) .catalog__eyebrow {
    color: oklch(from var(--group-color, var(--color-green-dark)) max(l, 0.72) c h);
  }

  .catalog__desc {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .catalog__rule {
    margin-top: var(--space-4);
    border: none;
    border-top: 2px solid var(--group-color, var(--color-green));
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-10) var(--space-6);
  }

  /* The side rail takes ~250px on desktop, so one fewer column there. */
  .catalog--with-nav .catalog__grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .catalog__empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
  }

  @media (max-width: 1279px) {
    .catalog__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .catalog--with-nav .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 1023px) {
    .catalog__grid,
    .catalog--with-nav .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .catalog__grid,
    .catalog--with-nav .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

