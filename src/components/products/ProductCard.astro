---
// src/components/products/ProductCard.astro
//
// Biorg-style card: soft rounded panel, product imagery on a quiet
// tinted field, minimal type, floating "+" affordance on hover.
// When the product has a backgrounds pool, one image renders as a
// cover background behind the packaging shot — randomized per load
// by the script below, same pool the product page hero draws from.

import { urlFor } from '../../lib/sanity'
import type { ProductCard } from '../../lib/types/sanity'

interface Props {
  product: ProductCard
}

const { product } = Astro.props
// fit('max') preserves the full image — packaging shots are never cropped
const imageUrl = product.image
  ? urlFor(product.image).width(800).fit('max').url()
  : null

const bgPool = (product.backgrounds ?? []).map((img) =>
  urlFor(img).width(1000).height(800).fit('crop').url(),
)
---

<a href={`/products/${product.slug}`} class="card">
  <div class="card__media">
    {bgPool.length > 0 && (
      <div
        class="card__bg"
        data-bg-pool={JSON.stringify(bgPool)}
        style={`background-image: url(${bgPool[0]})`}
        aria-hidden="true"
      >
      </div>
    )}
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt ?? product.title} width="800" height="640" loading="lazy" />
    ) : (
      <div class="card__placeholder" aria-hidden="true"></div>
    )}
    <span class="card__plus" aria-hidden="true">+</span>
  </div>
  <div class="card__body">
    <h3>{product.title}</h3>
    {product.tagline && <p>{product.tagline}</p>}
  </div>
</a>

<script>
  // Randomize each card's background from its pool on every load.
  // Bundled scripts are deduped by Astro — this runs once per page.
  document.querySelectorAll<HTMLElement>('.card__bg[data-bg-pool]').forEach((el) => {
    const pool: string[] = JSON.parse(el.dataset.bgPool || '[]')
    if (pool.length > 1) {
      el.style.backgroundImage = `url(${pool[Math.floor(Math.random() * pool.length)]})`
    }
  })
</script>

<style>
  .card {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-3xl);
    overflow: hidden;
    /* Quiet surface field — theme-aware, no hard spotlight */
    background:
      radial-gradient(100% 100% at 50% 0%, color-mix(in srgb, var(--color-text-primary) 4%, transparent), transparent 70%),
      var(--bg-surface);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__media {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  /* Randomized imagery behind the packaging shot, with a soft scrim
   * so the contained product stays legible over any photo */
  .card__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .card__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.3));
  }

  .card__media img {
    position: relative; /* above the background layer */
    width: 100%;
    height: 100%;
    object-fit: contain; /* whole product visible, floating on the field */
    padding: var(--space-10);
    filter: drop-shadow(0 12px 20px rgb(0 0 0 / 0.3));
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(80% 100% at 30% 100%, color-mix(in srgb, var(--color-green-pale) 65%, transparent), transparent 65%),
      var(--color-cream);
  }

  .card__plus {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__plus {
    opacity: 1;
    transform: translateY(0);
  }

  .card__body {
    padding: var(--space-6) var(--space-2) 0;
  }

  .card__body h3 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
  }

  .card__body p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }
</style>
