---
// src/components/products/ProductCard.astro
//
// Biorg-style card: soft rounded panel, product imagery on a quiet
// tinted field, minimal type, floating "+" affordance on hover.

import { urlFor } from '../../lib/sanity'
import type { ProductCard } from '../../lib/types/sanity'

interface Props {
  product: ProductCard
}

const { product } = Astro.props
const imageUrl = product.image
  ? urlFor(product.image).width(800).height(640).fit('crop').url()
  : null
---

<a href={`/products/${product.slug}`} class="card">
  <div class="card__media">
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt ?? product.title} width="800" height="640" loading="lazy" />
    ) : (
      <div class="card__placeholder" aria-hidden="true"></div>
    )}
    <span class="card__plus" aria-hidden="true">+</span>
  </div>
  <div class="card__body">
    <h3>{product.title}</h3>
    {product.tagline && <p>{product.tagline}</p>}
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-3xl);
    overflow: hidden;
    background:
      radial-gradient(90% 90% at 70% 20%, rgb(255 255 255 / 0.7), transparent 60%),
      var(--color-cream);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__media {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(80% 100% at 30% 100%, color-mix(in srgb, var(--color-green-pale) 65%, transparent), transparent 65%),
      var(--color-cream);
  }

  .card__plus {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__plus {
    opacity: 1;
    transform: translateY(0);
  }

  .card__body {
    padding: var(--space-5) var(--space-2) 0;
  }

  .card__body h3 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
  }

  .card__body p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }
</style>
