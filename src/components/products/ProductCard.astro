---
// src/components/products/ProductCard.astro
//
// Biorg-style card: soft rounded panel, product imagery on a quiet
// tinted field, minimal type, floating "+" affordance on hover.
// When the product has a backgrounds pool, one image renders as a
// cover background behind the packaging shot — randomized per load
// by the script below, same pool the product page hero draws from.

import { urlFor } from '../../lib/sanity'
import type { ProductCard } from '../../lib/types/sanity'

interface Props {
  product: ProductCard
}

const { product } = Astro.props
// fit('max') preserves the full image — packaging shots are never cropped
const imageUrl = product.image
  ? urlFor(product.image).width(800).fit('max').url()
  : null

const bgPool = (product.backgrounds ?? []).map((img) => ({
  url: urlFor(img).width(1000).height(800).fit('crop').auto('format').quality(75).url(),
  lqip: img.lqip ?? null,
}))
---

<a href={`/products/${product.slug}`} class="card">
  <div class="card__media">
    {bgPool.length > 0 && (
      <div
        class="card__bg"
        data-bg-pool={JSON.stringify(bgPool)}
        style={bgPool[0].lqip ? `background-image: url(${bgPool[0].lqip})` : undefined}
        aria-hidden="true"
      >
        <img class="card__bg-img" src={bgPool[0].url} alt="" loading="lazy" />
      </div>
    )}
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt ?? product.title} width="800" height="640" loading="lazy" />
    ) : (
      <div class="card__placeholder" aria-hidden="true"></div>
    )}
    <span class="card__plus" aria-hidden="true">+</span>
  </div>
  <span class="card__leaves" aria-hidden="true"></span>
  <div class="card__body">
    <h3>{product.title}</h3>
    {product.tagline && <p>{product.tagline}</p>}
  </div>
</a>

<script>
  // Randomize each card's background from its pool on every load.
  // The container paints the pick's blurred LQIP instantly; the full
  // image fades in over it. Bundled scripts are deduped by Astro —
  // this runs once per page.
  interface PoolEntry {
    url: string
    lqip: string | null
  }

  document.querySelectorAll<HTMLElement>('.card__bg[data-bg-pool]').forEach((el) => {
    const pool: PoolEntry[] = JSON.parse(el.dataset.bgPool || '[]')
    const img = el.querySelector<HTMLImageElement>('.card__bg-img')
    if (!img || pool.length === 0) return
    if (pool.length > 1) {
      const pick = pool[Math.floor(Math.random() * pool.length)]
      if (pick.lqip) el.style.backgroundImage = `url(${pick.lqip})`
      img.src = pick.url
    }
    const reveal = () => img.classList.add('is-loaded')
    img.complete && img.naturalWidth ? reveal() : img.addEventListener('load', reveal)
  })
</script>

<style>
  .card {
    display: block;
    position: relative;
  }

  /* Leaf overlay: mirrors the media box but does NOT clip, so the
   * leaves can break the card border. Two pointed-oval leaves bloom
   * from the media's bottom-left corner on hover (tips at the pivot). */
  .card__leaves {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    aspect-ratio: 5 / 4; /* same footprint as the media */
    z-index: 2; /* above the imagery */
    pointer-events: none;
  }

  .card__leaves::before,
  .card__leaves::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    /* vertical pointed oval — tips at bottom-left (the pivot) and top-right */
    border-radius: 100% 0 100% 0;
    transform-origin: 0 100%;
    opacity: 0;
    transform: rotate(6deg) scale(0.4);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  /* Primary leaf — tall, standing */
  .card__leaves::before {
    width: 26%;
    height: 55%;
    background: linear-gradient(160deg, var(--color-green-light), var(--color-green-dark));
  }

  /* Secondary leaf — smaller, lighter greens, more translucent */
  .card__leaves::after {
    width: 17%;
    height: 36%;
    background: linear-gradient(160deg, var(--color-green-pale), var(--color-green));
  }

  .card:hover .card__leaves::before {
    opacity: 0.92;
    transform: rotate(8deg) scale(1);
  }

  .card:hover .card__leaves::after {
    opacity: 0.65;
    transform: rotate(-32deg) scale(1);
    transition-delay: 0.06s;
  }

  .card__media {
    position: relative;
    z-index: 1; /* above the leaf */
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-leaf);
    overflow: hidden;
    /* Quiet surface field — theme-aware, no hard spotlight */
    background:
      radial-gradient(100% 100% at 50% 0%, color-mix(in srgb, var(--color-text-primary) 4%, transparent), transparent 70%),
      var(--bg-surface);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__media {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  /* Randomized imagery behind the packaging shot, with a soft scrim
   * so the contained product stays legible over any photo */
  .card__bg {
    position: absolute;
    inset: 0;
    /* LQIP paints here instantly; the img fades in over it */
    background-size: cover;
    background-position: center;
  }

  .card__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .card__bg-img.is-loaded {
    opacity: 1;
  }

  .card__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--img-scrim);
  }

  /* Direct child only — the packaging shot. The background image
   * nested in .card__bg must NOT inherit this padding/contain. */
  .card__media > img {
    position: relative; /* above the background layer */
    width: 100%;
    height: 100%;
    object-fit: contain; /* whole product visible, floating on the field */
    padding: var(--space-10);
    filter: drop-shadow(0 12px 20px rgb(0 0 0 / 0.3));
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(80% 100% at 30% 100%, color-mix(in srgb, var(--color-green-pale) 65%, transparent), transparent 65%),
      var(--color-cream);
  }

  .card__plus {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .card:hover .card__plus {
    opacity: 1;
    transform: translateY(0);
  }

  .card__body {
    padding: var(--space-6) var(--space-2) 0;
  }

  .card__body h3 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
  }

  .card__body p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }
</style>
