---
// src/components/products/ProductCard.astro

import { urlFor } from '../../lib/sanity'
import type { ProductCard } from '../../lib/types/sanity'

interface Props {
  product: ProductCard
}

const { product } = Astro.props
const imageUrl = product.image
  ? urlFor(product.image).width(600).height(450).fit('crop').url()
  : null
---

<a href={`/products/${product.slug}`} class="card">
  <div class="card__media">
    {imageUrl ? (
      <img src={imageUrl} alt={product.image?.alt ?? product.title} width="600" height="450" loading="lazy" />
    ) : (
      <div class="card__placeholder" aria-hidden="true"></div>
    )}
  </div>
  <div class="card__body">
    <h3>{product.title}</h3>
    {product.tagline && <p>{product.tagline}</p>}
  </div>
</a>

<style>
  .card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-white);
    border: var(--border-thin) solid var(--color-off-white);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .card__media {
    aspect-ratio: 4 / 3;
    background: var(--color-cream);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-green-pale), var(--color-cream));
  }

  .card__body {
    padding: var(--space-5);
  }

  .card__body h3 {
    font-size: var(--text-xl);
    color: var(--color-green-dark);
  }

  .card__body p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
