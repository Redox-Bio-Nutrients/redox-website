---
// src/components/products/ProductSections.astro
//
// Switches on each section's _type to pick its renderer. Adding a new
// section kind: add the schema object, the type, a component, and a
// case here.

import type { ProductSection, SanityImage } from '../../lib/types/sanity'
import type { ProductVariant } from '../../lib/productVariant'
import TextSection from './sections/TextSection.astro'
import CalloutSection from './sections/CalloutSection.astro'
import BulletSection from './sections/BulletSection.astro'
import AnalysisSection from './sections/AnalysisSection.astro'
import ChartSection from './sections/ChartSection.astro'
import FaqSection from './sections/FaqSection.astro'
import TestimonialSection from './sections/TestimonialSection.astro'
import VideoSection from './sections/VideoSection.astro'
import WarningSection from './sections/WarningSection.astro'

interface Props {
  sections: ProductSection[]
  /** which visual system to render section content in — see src/lib/productVariant.ts */
  variant?: ProductVariant
  productColor?: string
  /** optional second brand color — see deriveCalloutPalette() in src/lib/color.ts */
  productAccentColor?: string
  /** background imagery pool — callout sections draw a random image */
  backgrounds?: SanityImage[]
}

const { sections, variant = 'agriculture', productColor, productAccentColor, backgrounds } = Astro.props
---

<div class="product-sections">
  {sections.map((section) => {
    // Anchor target for the sidebar jump nav — scroll-margin clears
    // the sticky header.
    const inner = (() => {
      switch (section._type) {
        case 'textSection':
          return (
            <TextSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'calloutSection':
          return (
            <CalloutSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
              backgrounds={backgrounds}
            />
          )
        case 'bulletSection':
          return (
            <BulletSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'analysisSection':
          return (
            <AnalysisSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'chartSection':
          return (
            <ChartSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'faqSection':
          return (
            <FaqSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'testimonialSection':
          return (
            <TestimonialSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'videoSection':
          return (
            <VideoSection
              section={section}
              variant={variant}
              productColor={productColor}
              productAccentColor={productAccentColor}
            />
          )
        case 'warningSection':
          return <WarningSection section={section} variant={variant} />
        default:
          return null
      }
    })()
    return inner && (
      <div class="product-sections__anchor" id={`section-${section._key}`} data-section-anchor>
        {inner}
      </div>
    )
  })}
</div>

<style>
  .product-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .product-sections__anchor {
    scroll-margin-top: 100px;
  }

  @media (max-width: 767px) {
    .product-sections {
      gap: var(--space-16);
    }
  }
</style>
