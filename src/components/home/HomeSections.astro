---
// src/components/home/HomeSections.astro
//
// Dispatcher: switches on each homepage section's _type to pick its
// renderer. Adding a new section kind = add the schema object, the
// type, a component, and a case here — same pattern as ProductSections.

import type { HomeSection } from '../../lib/types/sanity'
import HeroSection from './sections/HeroSection.astro'
import HeroCarouselSection from './sections/HeroCarouselSection.astro'
import ColumnSection from './sections/ColumnSection.astro'
import StatsSection from './sections/StatsSection.astro'
import CtaSection from './sections/CtaSection.astro'
// Reused as-is from the product page-builder — their highlight colors
// already fall back to brand green (var(--product-color, ...) / the
// component's own default) when no product context sets
// --product-color, so they work unmodified here too. See
// sanity/schemas/objects/productSections.ts.
import ChartSection from '../products/sections/ChartSection.astro'
import CalloutSection from '../products/sections/CalloutSection.astro'
import BulletSection from '../products/sections/BulletSection.astro'
import FeaturedProductSection from './sections/FeaturedProductSection.astro'
import BlogShowcaseSection from './sections/BlogShowcaseSection.astro'

interface Props {
  sections: HomeSection[]
}

const { sections } = Astro.props
---

<div class="home-sections">
  {sections.map((section, index) => {
    switch (section._type) {
      case 'homeHeroSection':
        return <HeroSection section={section} />
      case 'homeHeroCarouselSection':
        return <HeroCarouselSection section={section} />
      case 'homeColumnSection': {
        // ColumnSection's "overlap" layout pulls itself up with a
        // negative margin onto whatever renders directly before it —
        // only correct when that's actually a Hero (the full-bleed
        // photo it was designed to float over). A non-hero section
        // inserted between the two (e.g. a Pull Quote) would otherwise
        // get partially swallowed by that same negative margin — see
        // ColumnSection.astro's own comment on the `followsHero` prop.
        const previousType = sections[index - 1]?._type
        const followsHero = previousType === 'homeHeroSection' || previousType === 'homeHeroCarouselSection'
        return <ColumnSection section={section} followsHero={followsHero} />
      }
      case 'homeStatsSection':
        return <StatsSection section={section} />
      case 'homeCtaSection':
        return <CtaSection section={section} />
      case 'homeFeaturedProductSection':
        // Manages its own --content-width constraint internally (same
        // as ColumnSection/CalloutSection above) — not wrapped in
        // .home-sections__constrain.
        return <FeaturedProductSection section={section} />
      case 'homeBlogShowcaseSection':
        return <BlogShowcaseSection section={section} />
      case 'chartSection':
        // ChartSection has no built-in width constraint (product pages
        // supply one via .layout) — wrap it here since page-builder
        // sections render full-width by default.
        return (
          <div class="home-sections__constrain">
            <ChartSection section={section} />
          </div>
        )
      case 'calloutSection':
        // Unlike ChartSection/BulletSection below, deliberately NOT
        // wrapped in .home-sections__constrain — this one spans the
        // true viewport edge (fullBleed), so its own CSS handles
        // lining the text up with --content-width instead. Variant
        // defaults to 'agriculture' inside the component, which is
        // the leaf-radius/leaf-sprig treatment (not turf's diagonal
        // cut) — the one we want here. No `backgrounds` pool passed —
        // that prop is for a product's wide field/farm photography
        // pool (product-page context only); a homepage/technology
        // callout's own backgroundImage (see the schema field's own
        // comment) is a contained product shot the component renders
        // itself, not a pool image.
        return <CalloutSection section={section} fullBleed />
      case 'bulletSection':
        return (
          <div class="home-sections__constrain">
            <BulletSection section={section} />
          </div>
        )
      default:
        return null
    }
  })}
</div>

<style>
  .home-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    /* Reserves page-background breathing room before whatever comes
     * next (the site Footer) — the flex `gap` above only ever applies
     * *between* sections, never after the last one, so a page whose
     * final section has no self-contained bottom spacing of its own
     * (bulletSection/chartSection/calloutSection — reused as-is from
     * the product page-builder, see the imports above) otherwise butts
     * straight up against the Footer's own background with no visible
     * seam. Same rhythm as the inter-section gap for consistency. */
    padding-bottom: var(--space-24);
  }

  .home-sections__constrain {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
    width: 100%;
  }

  @media (max-width: 767px) {
    .home-sections {
      gap: var(--space-16);
      padding-bottom: var(--space-16);
    }
  }
</style>
