---
// src/components/home/sections/DownloadSection.astro
//
// File download card — icon, heading, details line, optional body
// copy, and a download button for a file uploaded in Sanity. First
// used for the Credit Application page; see homeSections.ts's
// homeDownloadSection WHY comment.

import { PortableText } from 'astro-portabletext'
import type { HomeDownloadSection } from '../../../lib/types/sanity'
import { onMissingPortableTextComponent, portableTextComponents } from '../../../lib/portableTextComponents'

interface Props {
  section: HomeDownloadSection
}

const { section } = Astro.props
const file = section.file

function formatSize(bytes: number): string {
  if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
  return `${Math.max(1, Math.round(bytes / 1024))} KB`
}

const fileInfo = file ? [file.extension?.toUpperCase(), file.size ? formatSize(file.size) : null].filter(Boolean) : []
const details = [section.fileDetails, ...fileInfo].filter(Boolean).join(' · ')
// Sanity's ?dl= makes the CDN send it as a download, under its
// original filename, rather than opening it in the browser tab.
const href = file?.url ? `${file.url}?dl=${encodeURIComponent(file.originalFilename ?? '')}` : null
const headingId = `download-${section._key}`
---

<section class="download" aria-labelledby={headingId}>
  <div class="download__card">
    <svg class="download__icon" viewBox="0 0 48 48" aria-hidden="true">
      <path d="M12 4h17l11 11v27a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M29 4v11h11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M17 25h14M17 31h14M17 37h9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
    </svg>

    <div class="download__text">
      <h2 id={headingId}>{section.heading}</h2>
      {details && <p class="download__meta">{details}</p>}
      {section.body && section.body.length > 0 && (
        <div class="download__body">
          <PortableText
            value={section.body}
            components={portableTextComponents}
            onMissingComponent={onMissingPortableTextComponent}
          />
        </div>
      )}
    </div>

    {href && (
      <a class="btn btn--primary download__button" href={href} download={file?.originalFilename ?? ''}>
        {section.buttonLabel || 'Download'}
      </a>
    )}
  </div>
</section>

<style>
  .download {
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .download__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-2xl);
  }

  .download__icon {
    width: 56px;
    height: 56px;
    color: var(--color-green-dark);
  }

  .download__text h2 {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
  }

  .download__meta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: 0.02em;
    color: var(--color-green-dark);
  }

  .download__body {
    margin-top: var(--space-3);
  }

  .download__body :global(p) {
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .download__body :global(p + p) {
    margin-top: var(--space-3);
  }

  .download__body :global(a) {
    color: var(--color-green-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .download__button {
    padding: var(--space-4) var(--space-6);
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .download__card {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-6);
    }

    .download__icon {
      width: 44px;
      height: 44px;
    }

    .download__button {
      justify-self: start;
    }
  }
</style>
