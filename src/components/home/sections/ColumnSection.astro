---
// src/components/home/sections/ColumnSection.astro
//
// A 1-3 column flexible section. Two independent concerns, kept
// deliberately separate: the SECTION background can bleed to the full
// viewport width (color or image), while the CONTENT inside always
// aligns to --content-width — the same column width used on product
// pages — so pages stay visually consistent regardless of how a given
// section is themed.

import { PortableText } from 'astro-portabletext'
import { urlFor } from '../../../lib/sanity'
import { onMissingPortableTextComponent, portableTextComponents } from '../../../lib/portableTextComponents'
import type { HomeColumnSection } from '../../../lib/types/sanity'
import PoolBackground from '../../ui/PoolBackground.astro'

interface Props {
  section: HomeColumnSection
}

const { section } = Astro.props
const bgType = section.backgroundType ?? 'none'
const bgImageUrl =
  bgType === 'image' && section.backgroundImage
    ? urlFor(section.backgroundImage).width(2400).fit('max').auto('format').quality(75).url()
    : null
// Same {url, lqip} shape PoolBackground/CalloutSection already use —
// see HOME_SECTIONS_FRAGMENT's "pool" projection in fragments.ts.
const pool =
  bgType === 'pool'
    ? (section.pool ?? []).map((img) => ({
        url: urlFor(img).width(2400).height(1200).fit('crop').auto('format').quality(75).url(),
        lqip: img.lqip ?? null,
      }))
    : []

// Split layout — a distinct markup branch below (edge-to-edge image,
// no .columns__inner max-width wrapper), not just another
// --column-count value: the grid layout keeps both columns centered
// and equal-width inside --content-width on purpose, while split
// deliberately breaks that — the image bleeds to the true viewport
// edge and only the text column respects the page's normal outer
// margin. Ignores `columns`; uses only items[0] — see the schema
// field's own comment for why one item is enough (its image is the
// full-bleed column, its heading/body/cta are the other column,
// alongside the section-level eyebrow/heading every layout already
// renders). `imagePosition` (default 'left') picks which viewport
// edge the image bleeds to; the markup order never changes — only
// the `columns--split-right` modifier class below reorders the two
// columns visually, so the image stays first in the DOM either way.
const isSplit = section.layout === 'split'
const splitItem = section.items?.[0]
const splitImagePosition = section.imagePosition === 'right' ? 'right' : 'left'
const splitImageUrl = splitItem?.image
  ? urlFor(splitItem.image).width(1400).height(1600).fit('crop').auto('format').quality(75).url()
  : null
---

{isSplit && splitItem ? (
  <section
    class:list={[
      'columns',
      'columns--split',
      { 'columns--split-right': splitImagePosition === 'right', 'columns--bg-color': bgType === 'color' },
    ]}
    style={bgType === 'color' && section.backgroundColor ? `--section-bg: ${section.backgroundColor}` : undefined}
  >
    <div class="split__image-col">
      {splitImageUrl && (
        <img class="split__image" src={splitImageUrl} alt={splitItem.image?.alt ?? ''} loading="lazy" />
      )}
    </div>
    <div class="split__content-col">
      {section.eyebrow && <p class="columns__eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2 class="columns__heading">{section.heading}</h2>}
      {splitItem.heading && <h3 class="column__heading">{splitItem.heading}</h3>}
      {splitItem.body && (
        <div class="column__body">
          <PortableText
            value={splitItem.body}
            components={portableTextComponents}
            onMissingComponent={onMissingPortableTextComponent}
          />
        </div>
      )}
      {splitItem.cta && (
        <a
          class="column__cta"
          href={splitItem.cta.href}
          target={splitItem.cta.external ? '_blank' : undefined}
          rel={splitItem.cta.external ? 'noopener noreferrer' : undefined}
        >
          {splitItem.cta.label} →
        </a>
      )}
    </div>
  </section>
) : (
  <section
    class:list={['columns', `columns--bg-${bgType}`]}
    style={bgType === 'color' && section.backgroundColor ? `--section-bg: ${section.backgroundColor}` : undefined}
  >
    {bgImageUrl && (
      <img class="columns__bg" src={bgImageUrl} alt="" aria-hidden="true" loading="lazy" />
    )}
    {bgType === 'pool' && pool.length > 0 && <PoolBackground pool={pool} />}
    {(bgType === 'image' || (bgType === 'pool' && pool.length > 0)) && (
      <div class="columns__scrim" aria-hidden="true"></div>
    )}

    <div class="columns__inner">
      {section.eyebrow && <p class="columns__eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2 class="columns__heading">{section.heading}</h2>}
      <div class="columns__grid" style={`--column-count: ${section.columns}`}>
        {section.items.map((item) => (
          <div class="column">
            {item.image && (
              <img
                class="column__image"
                src={urlFor(item.image).width(600).height(450).fit('crop').auto('format').quality(75).url()}
                alt={item.image.alt ?? ''}
                loading="lazy"
              />
            )}
            {item.heading && <h3 class="column__heading">{item.heading}</h3>}
            {item.body && (
              <div class="column__body">
                <PortableText
                  value={item.body}
                  components={portableTextComponents}
                  onMissingComponent={onMissingPortableTextComponent}
                />
              </div>
            )}
            {item.cta && (
              <a
                class="column__cta"
                href={item.cta.href}
                target={item.cta.external ? '_blank' : undefined}
                rel={item.cta.external ? 'noopener noreferrer' : undefined}
              >
                {item.cta.label} →
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .columns {
    position: relative;
    /* No max-width here on purpose — a section is a direct block child
     * of <main>, which is unconstrained, so it naturally spans the
     * full viewport width when a background is set. */
  }

  .columns--bg-color {
    background: var(--section-bg);
  }

  .columns__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .columns__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--img-scrim);
  }

  /* ── Split layout ───────────────────────────────────────────────
   * Deliberately NOT inside .columns__inner's centered/padded
   * container — the whole point is that the image ignores
   * --content-width and bleeds to the true viewport edge. Grid's
   * default `align-items: stretch` is what makes the image column
   * match the text column's height: .split__image-col has no
   * intrinsic height of its own (its only child is absolutely
   * positioned, contributing zero height to the row's auto sizing),
   * so the row height comes entirely from .split__content-col's
   * content, and stretch grows the image column's box to match. */
  .columns--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* Image-right: DOM order stays image-col-then-content-col (see the
   * component's comment on `imagePosition`) — flipping which visual
   * column each one occupies is just `order`. The content column's
   * padding has to flip with it: its outer edge (the one that must
   * align to the page's normal margin) is on the right by default
   * because the image sits on the left, so reversing the image also
   * reverses which side of the content column is "outer" vs. "near
   * the image". */
  .columns--split-right .split__image-col {
    order: 2;
  }

  .columns--split-right .split__content-col {
    order: 1;
  }

  .split__image-col {
    position: relative;
  }

  .split__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Rounds the corner nearest the content column, whichever side
     * that ends up on — mirrored below for image-right. */
    border-bottom-right-radius: 35%;
  }

  .columns--split-right .split__image {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 35%;
  }

  .split__content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) max(var(--space-6), calc((100vw - var(--content-width)) / 2)) var(--space-24)
      var(--space-12);
  }

  .columns--split-right .split__content-col {
    padding-right: var(--space-12);
    padding-left: max(var(--space-6), calc((100vw - var(--content-width)) / 2));
  }

  .split__content-col .columns__heading,
  .split__content-col .column__heading {
    margin-bottom: var(--space-5);
  }

  @media (max-width: 767px) {
    .columns--split {
      grid-template-columns: 1fr;
    }

    .split__image-col {
      /* absolutely-positioned .split__image needs an explicit box to
       * fill once the grid collapses to a single column (stretch has
       * nothing left to stretch to match) */
      aspect-ratio: 4 / 3;
      min-height: 280px;
    }

    .split__content-col,
    .columns--split-right .split__content-col {
      padding: var(--space-16) var(--space-6);
    }
  }

  .columns__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
  }

  .columns__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-semi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: var(--space-3);
  }

  .columns__heading {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-10);
  }

  .columns--bg-color .columns__eyebrow,
  .columns--bg-image .columns__eyebrow,
  .columns--bg-pool .columns__eyebrow {
    color: var(--color-white);
    opacity: 0.85;
  }

  .columns--bg-color .columns__heading,
  .columns--bg-image .columns__heading,
  .columns--bg-pool .columns__heading {
    color: var(--color-white);
  }

  .columns__grid {
    display: grid;
    grid-template-columns: repeat(var(--column-count), 1fr);
    gap: var(--space-10);
  }

  .column__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    margin-bottom: var(--space-5);
  }

  .column__heading {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .columns--bg-color .column__heading,
  .columns--bg-image .column__heading,
  .columns--bg-pool .column__heading {
    color: var(--color-white);
  }

  .column__body :global(p) {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .columns--bg-color .column__body :global(p),
  .columns--bg-image .column__body :global(p),
  .columns--bg-pool .column__body :global(p) {
    color: rgb(255 255 255 / 0.85);
  }

  .column__cta {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: inherit;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 767px) {
    .columns__inner {
      padding: var(--space-16) var(--space-6);
    }

    .columns__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
