---
// src/components/home/sections/CtaSection.astro
//
// Closing banner — heading + body + 1-4 buttons. Own section type
// since every other homepage section caps at one cta; see
// homeSections.ts's homeCtaSection WHY comment.

import type { HomeCtaSection } from '../../../lib/types/sanity'

interface Props {
  section: HomeCtaSection
}

const { section } = Astro.props
---

<section class="cta-banner">
  <div class="cta-banner__inner">
    <h2 class="cta-banner__heading">{section.heading}</h2>
    {section.body && <p class="cta-banner__body">{section.body}</p>}
    <div class="cta-banner__buttons">
      {section.buttons.map((button, i) => (
        <a
          class:list={['cta-banner__button', { 'cta-banner__button--secondary': i > 0 }]}
          href={button.href}
          target={button.external ? '_blank' : undefined}
          rel={button.external ? 'noopener noreferrer' : undefined}
        >
          {button.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-green-dark);
  }

  .cta-banner__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
    text-align: center;
  }

  .cta-banner__heading {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-white);
    max-width: 32ch;
    margin: 0 auto;
  }

  .cta-banner__body {
    margin: var(--space-5) auto 0;
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.85);
  }

  .cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .cta-banner__button {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-green-dark);
    font-size: var(--text-base);
    font-weight: var(--font-semi);
    transition: filter 0.15s ease;
  }

  .cta-banner__button:hover {
    filter: brightness(0.92);
  }

  .cta-banner__button--secondary {
    background: transparent;
    color: var(--color-white);
    border: var(--border-thin) solid rgb(255 255 255 / 0.4);
  }

  .cta-banner__button--secondary:hover {
    background: rgb(255 255 255 / 0.1);
    filter: none;
  }

  @media (max-width: 639px) {
    .cta-banner__inner {
      padding: var(--space-16) var(--space-6);
    }

    .cta-banner__buttons {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
