---
// src/components/home/sections/CtaSection.astro
//
// Closing banner — heading + body + 1-4 buttons. Own section type
// since every other homepage section caps at one cta; see
// homeSections.ts's homeCtaSection WHY comment.

import type { HomeCtaSection } from '../../../lib/types/sanity'

interface Props {
  section: HomeCtaSection
}

const { section } = Astro.props
---

<section class="cta-banner">
  <div class="cta-banner__inner">
    <h2 class="cta-banner__heading">{section.heading}</h2>
    {section.body && <p class="cta-banner__body">{section.body}</p>}
    <div class="cta-banner__buttons">
      {section.buttons.map((button, i) => (
        <a
          class:list={[
            'btn',
            i > 0 ? ['btn--ghost', 'btn--on-color'] : 'btn--primary',
            'cta-banner__button',
            { 'cta-banner__button--secondary': i > 0 },
          ]}
          href={button.href}
          target={button.external ? '_blank' : undefined}
          rel={button.external ? 'noopener noreferrer' : undefined}
        >
          {button.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cta-banner {
    /* --footer-bg, not --color-green-dark — the two happen to be the
     * identical hex in light theme (#2E6B3E), which is what made the
     * flush margin-bottom trick below read as a genuinely seamless
     * bleed into the Footer rather than just "no gap" (Curtis's
     * "unintentional... let's match it in dark mode too" follow-up,
     * 2026-09-14). They diverge in dark theme, though — --color-green-
     * dark there is a light mint (#9CC3A6, still meant to work as
     * *text* everywhere else it's used) while --footer-bg is near-
     * black (#131A15) — so the same swap that was a no-op in light
     * theme is the actual fix in dark theme: this banner now always
     * matches the Footer's own background, in both themes, by
     * definition. */
    background: var(--footer-bg);
    /* Cancels .home-sections' own padding-bottom (the reserved white/
     * page-bg gap it adds after whatever homepage section happens to
     * render last, so a section with no background of its own doesn't
     * butt straight into the Footer). This section already IS a solid
     * full-bleed color band, so when it's the page's last section that
     * reserved gap only ever shows as an unwanted seam between two
     * dark surfaces (this banner and the Footer) — pull it flush
     * instead (Curtis's ask, 2026-09-14: the dark run at the bottom of
     * the homepage should reach the Footer's own top border with no
     * gap). Safe even when this ISN'T the last section on a given
     * page: margin-bottom on a normal-flow block just reduces the
     * space before whatever comes next, it doesn't overlap it. */
    margin-bottom: calc(-1 * var(--space-24));
  }

  .cta-banner__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
    text-align: center;
  }

  .cta-banner__heading {
    font-family: var(--font-serif);
    font-weight: var(--font-normal);
    font-size: var(--text-display-sm);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-white);
    max-width: 32ch;
    margin: 0 auto;
  }

  .cta-banner__body {
    margin: var(--space-5) auto 0;
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgb(255 255 255 / 0.85);
  }

  .cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  /* Color/shape/glass come from .btn/.btn--primary/.btn--ghost
   * (src/styles/buttons.css) — closing-banner CTAs just run a touch
   * bigger than the shared default, the one thing still worth
   * overriding per section. */
  .cta-banner__button {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
  }

  @media (max-width: 639px) {
    .cta-banner__inner {
      padding: var(--space-16) var(--space-6);
    }

    .cta-banner__buttons {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
