---
// src/components/global/Footer.astro

import { legalNav, primaryNav, site, utilityNav } from '../../config/site'

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <span class="footer__logo">{site.name}</span>
      <p class="footer__tagline">Growing Beyond since 1994</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul class="footer__nav-list">
        {primaryNav.map((item) => (
          <li><a href={item.href} class="footer__link">{item.label}</a></li>
        ))}
        <li>
          <a
            href={utilityNav.dashboard.href}
            class="footer__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {utilityNav.dashboard.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="footer__legal">
    <ul class="footer__legal-list">
      {legalNav.map((item) => (
        <li><a href={item.href} class="footer__legal-link">{item.label}</a></li>
      ))}
      <li>
        <button type="button" class="footer__legal-link footer__legal-link--button" data-open-cookie-settings>
          Cookie Settings
        </button>
      </li>
    </ul>
  </div>

  <div class="footer__bottom">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    /* Positioned so it reliably paints above BaseLayout's fixed
     * .wallpaper backdrop (an unpositioned/static element paints
     * behind any positioned sibling regardless of DOM order) — the
     * footer has its own solid background and should never show the
     * wallpaper through it. */
    position: relative;
    background: var(--footer-bg);
    color: var(--footer-text);
    margin-top: auto;
  }

  .footer__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
  }

  .footer__tagline {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--footer-muted);
  }

  .footer__nav-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--space-3) var(--space-8);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--footer-text);
    opacity: 0.85;
  }

  .footer__link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer__legal {
    border-top: 1px solid rgb(255 255 255 / 0.15);
    padding: var(--space-5) var(--space-6) 0;
  }

  .footer__legal-list {
    list-style: none;
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
  }

  .footer__legal-link {
    font-size: var(--text-xs);
    color: var(--footer-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .footer__legal-link:hover {
    color: var(--footer-text);
    text-decoration: underline;
  }

  .footer__bottom {
    padding: var(--space-4) var(--space-6);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--footer-muted);
  }

  @media (max-width: 639px) {
    .footer__nav-list {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
