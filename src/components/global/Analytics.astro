---
// src/components/global/Analytics.astro
//
// WHY: Kept separate from CookieConsent.astro on purpose — the consent
// mechanism needs to exist and be honored *before* there's anything
// real to consent to (see that file's own header), but this component
// is the part that actually loads Google Analytics, and it should stay
// genuinely inert until there's a real PUBLIC_GA_MEASUREMENT_ID. No
// env var set yet, so this renders nothing at all — not a placeholder
// script, not a stub tag, literally zero output. Set
// PUBLIC_GA_MEASUREMENT_ID in Vercel (Production + Preview) once a
// real GA4 property exists to turn this on.
//
// Consent Mode v2 (Google's own recommended pattern): default both
// storage grants to "denied" before gtag.js ever loads, so GA's own
// library — not just whether the tag fires — respects the visitor's
// choice from the very first request. Updated to "granted" only if
// CookieConsent.astro's cookie already says so, and live-updated on
// every `redox:consent-change` event afterward (no reload needed if
// someone changes their mind via "Cookie Settings" mid-visit).

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID
---

{gaId && (
  <>
    <script define:vars={{ gaId }} is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      // Consent Mode v2 default — must run before gtag.js loads.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      })
      ;(() => {
        const match = document.cookie.match(/(?:^|; )redox_consent=([^;]*)/)
        if (!match) return
        try {
          const consent = JSON.parse(decodeURIComponent(match[1]))
          gtag('consent', 'update', {
            analytics_storage: consent.analytics ? 'granted' : 'denied',
            ad_storage: consent.marketing ? 'granted' : 'denied',
            ad_user_data: consent.marketing ? 'granted' : 'denied',
            ad_personalization: consent.marketing ? 'granted' : 'denied',
          })
        } catch {
          /* malformed cookie — stay denied */
        }
      })()
      window.addEventListener('redox:consent-change', (e) => {
        const consent = e.detail
        gtag('consent', 'update', {
          analytics_storage: consent.analytics ? 'granted' : 'denied',
          ad_storage: consent.marketing ? 'granted' : 'denied',
          ad_user_data: consent.marketing ? 'granted' : 'denied',
          ad_personalization: consent.marketing ? 'granted' : 'denied',
        })
      })
      gtag('js', new Date())
      gtag('config', gaId)
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
  </>
)}
