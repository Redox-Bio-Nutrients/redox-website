---
// src/layouts/BaseLayout.astro
//
// WHY: One layout owns the document shell, meta tags, and header/footer.
// Pages pass plain strings (title/description/ogImage) or a full `seo`
// object from Sanity — the Sanity values win when both are present, so
// editor overrides always take effect without page-level logic.

import '../styles/global.css'
import { site } from '../config/site'
import type { Seo } from '../lib/types/sanity'
import { urlFor } from '../lib/sanity'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  seo?: Seo
}

const { title, description, ogImage, seo } = Astro.props

const metaTitle = seo?.metaTitle ?? title
const metaDescription = seo?.metaDescription ?? description
const metaOgImage = seo?.ogImage
  ? urlFor(seo.ogImage).width(1200).height(630).url()
  : (ogImage ?? new URL(site.defaultOgImage, site.url).href)
const canonicalUrl = new URL(Astro.url.pathname, site.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Theme init — runs before paint to avoid a flash of the wrong
      // theme. Stored choice wins; otherwise follow the system.
      ;(() => {
        const stored = localStorage.getItem('theme')
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
        document.documentElement.dataset.theme = theme
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{`${metaTitle} | ${site.name}`}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonicalUrl} />
    {seo?.noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={metaTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:image" content={metaOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <button type="button" class="back-to-top" id="back-to-top" aria-label="Back to top">
      ↑
    </button>

    <script>
      // Back to top — fades in after a screen's worth of scrolling.
      const btn = document.getElementById('back-to-top')
      if (btn) {
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })
        const toggle = () => {
          btn.classList.toggle('is-visible', window.scrollY > window.innerHeight)
        }
        window.addEventListener('scroll', toggle, { passive: true })
        toggle()
      }
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .back-to-top {
    position: fixed;
    right: var(--space-6);
    bottom: var(--space-6);
    z-index: var(--z-overlay);
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: var(--glass-border);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-lg);
    color: var(--color-text-primary);
    font-size: var(--text-xl);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--color-green-dark);
    box-shadow: var(--shadow-xl);
  }
</style>
