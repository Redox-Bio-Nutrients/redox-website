---
// src/layouts/BaseLayout.astro
//
// WHY: One layout owns the document shell, meta tags, and header/footer.
// Pages pass plain strings (title/description/ogImage) or a full `seo`
// object from Sanity — the Sanity values win when both are present, so
// editor overrides always take effect without page-level logic.

import '../styles/global.css'
import { site } from '../config/site'
import type { Seo } from '../lib/types/sanity'
import { urlFor } from '../lib/sanity'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  seo?: Seo
}

const { title, description, ogImage, seo } = Astro.props

const metaTitle = seo?.metaTitle ?? title
const metaDescription = seo?.metaDescription ?? description
const metaOgImage = seo?.ogImage
  ? urlFor(seo.ogImage).width(1200).height(630).url()
  : (ogImage ?? new URL(site.defaultOgImage, site.url).href)
const canonicalUrl = new URL(Astro.url.pathname, site.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{`${metaTitle} | ${site.name}`}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonicalUrl} />
    {seo?.noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={metaTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:image" content={metaOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
