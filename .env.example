# ── Sanity ────────────────────────────────────────────────────────────────────
# Safe to expose to client (no secrets)
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only (never expose to client)
# Used for Sanity webhook verification
SANITY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Site ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://redoxgrows.com

# ── Integrations ──────────────────────────────────────────────────────────────
# HubSpot — form embed portal ID (safe to expose)
PUBLIC_HUBSPOT_PORTAL_ID=your_portal_id_here

# Product resource request form — where the "Request Access" dialog on
# product pages POSTs (name/email/company/message + which documents).
# Point this at any endpoint that accepts a standard form POST and
# emails the submission: Formspree, Getform, Basin, etc. today; a
# HubSpot forms-submit URL later once PUBLIC_HUBSPOT_PORTAL_ID is live.
# Leave unset and the sidebar falls back to a plain /contact link
# instead of rendering a dialog with nowhere to submit to.
PUBLIC_RESOURCE_REQUEST_ENDPOINT=https://formspree.io/f/your_form_id

# Buzzsprout — podcast feed ID (safe to expose)
PUBLIC_BUZZSPROUT_PODCAST_ID=your_podcast_id_here