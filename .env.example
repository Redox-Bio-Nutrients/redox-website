# ── Sanity ────────────────────────────────────────────────────────────────────
# Safe to expose to client (no secrets)
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only (never expose to client)
# Used for Sanity webhook verification
SANITY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Site ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://redoxgrows.com

# ── Integrations ──────────────────────────────────────────────────────────────
# HubSpot — form embed portal ID (safe to expose)
PUBLIC_HUBSPOT_PORTAL_ID=your_portal_id_here

# Buzzsprout — podcast feed ID (safe to expose)
PUBLIC_BUZZSPROUT_PODCAST_ID=your_podcast_id_here

# ── Product Information Request email (Microsoft Graph) ────────────────────────
# Server-only — never expose to client. Powers src/pages/api/resource-request.ts,
# which sends "Product Information Request" submissions from
# notifications@redoxgrows.com via Microsoft Graph (app-only OAuth). See
# docs/deployment.md for the Azure AD app registration runbook. The actual
# recipient address is set separately, in Sanity Studio (Form Settings
# singleton) — not here.
MS365_TENANT_ID=your_tenant_id_here
MS365_CLIENT_ID=your_client_id_here
MS365_CLIENT_SECRET=your_client_secret_here
# Optional — defaults to notifications@redoxgrows.com if unset
MS365_SENDER_EMAIL=notifications@redoxgrows.com